@inject ITenantService TenantService
@inject IModulService  ModulService

<MudNavMenu>

    @* ── OPERATIVA ────────────────────────────────────── *@
    <div class="nav-section-title">Operativa</div>
    <MudNavLink Href="/" Match="NavLinkMatch.All"
                Icon="@Icons.Material.Filled.Home">
        Početna
    </MudNavLink>
    <MudNavLink Href="/partneri"
                Icon="@Icons.Material.Filled.Business">
        Partneri
    </MudNavLink>
    <MudNavLink Href="/vozaci"
                Icon="@Icons.Material.Filled.People">
        Zaposleni
    </MudNavLink>
    <MudNavLink Href="/vozila"
                Match="NavLinkMatch.All"
                Icon="@Icons.Material.Filled.DirectionsCar">
        Vozila
    </MudNavLink>
    <MudNavLink Href="/vozila/vazni-datumi"
                Icon="@Icons.Material.Filled.EventBusy">
        Važni datumi
    </MudNavLink>

    @* ── DOKUMENTA ────────────────────────────────────── *@
    <div class="nav-section-title">Dokumenta</div>
    <MudNavLink Href="/fakture"
                Icon="@Icons.Material.Filled.Receipt">
        Računi
    </MudNavLink>
    <MudNavLink Href="/fakturisanje/gotovinski"
                Icon="@Icons.Material.Filled.CurrencyExchange">
        Gotovski računi
    </MudNavLink>
    <MudNavLink Href="/fakturisanje/otpremnice"
                Icon="@Icons.Material.Filled.LocalShipping">
        Otpremnice
    </MudNavLink>
    <MudNavLink Href="/fakturisanje/ponude"
                Icon="@Icons.Material.Filled.Assignment">
        Ponude
    </MudNavLink>
    <MudNavLink Href="/dozvole"
                Icon="@Icons.Material.Filled.CardMembership">
        Dozvole MUP
    </MudNavLink>
    @* OpcijaInt2 (transportModulAktivan) — podešavanje po klijentu, NE dirati. Modul TURE
       (tbl_web_licence.ModulTure, preko IModulService) — licenca. Oba moraju biti ispunjena. *@
    @if (TenantService.GetTransportModulAktivan() && _tureDozvoljen)
    {
        <MudNavLink Href="/transport/nalozi"
                    Icon="@Icons.Material.Filled.DriveEta">
            Transport / Ture
        </MudNavLink>
        <MudNavLink Href="/nalozi"
                    Icon="@Icons.Material.Filled.ReceiptLong">
            Nalozi za prevoz
        </MudNavLink>
        <MudNavLink Href="/transport/putni-nalozi"
                    Icon="@Icons.Material.Filled.Route">
            Putni nalozi
        </MudNavLink>
        <MudNavLink Href="/statistika/ture"
                    Icon="@Icons.Material.Filled.BarChart">
            Statistika tura
        </MudNavLink>
        <MudNavLink Href="/statistika/nalozi"
                    Icon="@Icons.Material.Filled.Analytics">
            Statistika naloga
        </MudNavLink>
    }

    @* ── FINANSIJE ────────────────────────────────────── *@
    <div class="nav-section-title">Finansije</div>
    <MudNavLink Href="/finansije/unos"
                Icon="@Icons.Material.Filled.Payment">
        Unos finansija
    </MudNavLink>
    <MudNavLink Href="/finansije/kartica-nova"
                Icon="@Icons.Material.Filled.CreditCard">
        Kartice
    </MudNavLink>
    <MudNavLink Href="/finansije/duznici-novi"
                Icon="@Icons.Material.Filled.MoneyOff">
        Dužnici
    </MudNavLink>
    <div class="nav-sub-title">Staro</div>
    <MudNavLink Href="/finansije/kartica"
                Icon="@Icons.Material.Filled.CreditCardOff">
        Kartice (staro)
    </MudNavLink>
    <MudNavLink Href="/finansije/duznici"
                Icon="@Icons.Material.Filled.MoneyOffCsred">
        Dužnici (staro)
    </MudNavLink>
    <MudNavLink Href="/troskovi"
                Icon="@Icons.Material.Filled.AccountBalance">
        Troškovi
    </MudNavLink>

    @* ── ZARADE ───────────────────────────────────────── *@
    <MudNavGroup Title="Zarade"
                 Icon="@Icons.Material.Filled.Payments"
                 Expanded="false">
        <MudNavLink Href="/plate"
                    Icon="@Icons.Material.Filled.Wallet">
            Plate
        </MudNavLink>
        <MudNavLink Href="/dnevnice"
                    Icon="@Icons.Material.Filled.Money">
            Dnevnice
        </MudNavLink>
    </MudNavGroup>

    @* ── E-FAKTURE ────────────────────────────────────── *@
    @if (TenantService.GetEFakturaAktivna())
    {
        <MudNavGroup Title="E-fakture"
                     Icon="@Icons.Material.Filled.CloudUpload"
                     Expanded="false">
            <MudNavLink Href="/efakture/izlazne"
                        Icon="@Icons.Material.Filled.Upload">
                Izlazne e-fakture
            </MudNavLink>
            <MudNavLink Href="/efakture/ulazne"
                        Icon="@Icons.Material.Filled.Download">
                Ulazne e-fakture
            </MudNavLink>
            <MudNavLink Href="/efakture/unos"
                        Icon="@Icons.Material.Filled.NoteAdd">
                Unos dokumenta
            </MudNavLink>
            <MudNavLink Href="/efakture/pojedinacna-evidencija"
                        Icon="@Icons.Material.Filled.FactCheck">
                Pojedinačna evidencija
            </MudNavLink>
            <MudNavLink Href="/efakture/zbirna-evidencija"
                        Icon="@Icons.Material.Filled.Summarize">
                Zbirna evidencija
            </MudNavLink>
            <MudNavLink Href="/efakture/evidencija-prethodnog-poreza"
                        Icon="@Icons.Material.Filled.RequestQuote">
                Evidencija prethodnog poreza
            </MudNavLink>
            <MudNavLink Href="/efakture/statistika"
                        Icon="@Icons.Material.Filled.BarChart">
                Statistika e-faktura
            </MudNavLink>
            <MudNavLink Href="/efakture/obavestenje-prethodnog-poreza"
                        Icon="@Icons.Material.Filled.Announcement">
                Obaveštenje o prethodnom porezu
            </MudNavLink>
        </MudNavGroup>
    }

    @* ── RESURSI ──────────────────────────────────────── *@
    <div class="nav-section-title">Resursi</div>
    @* Modul LAGER (tbl_web_licence.ModulLager) — modul još nije razvijen, "Magacin" je stub stranica. *@
    @if (_lagerDozvoljen)
    {
        <MudNavLink Href="/magacin/lager"
                    Icon="@Icons.Material.Filled.Inventory">
            Magacin
        </MudNavLink>
    }
    @* Modul RADNI_NALOZI (tbl_web_licence.ModulRadniNalozi) — grana pripremljena, stranice još
       ne postoje. Kad se dodaju: @if (_radniNaloziDozvoljen) { <MudNavLink ...>...</MudNavLink> } *@
    <MudNavLink Href="/planiranje/planer"
                Icon="@Icons.Material.Filled.CalendarToday">
        Planiranje
    </MudNavLink>
    <MudNavLink Href="/podsetnici"
                Icon="@Icons.Material.Filled.NotificationsActive">
        Podsetnici
    </MudNavLink>

    @* ── FINANSIJSKI ALATI ────────────────────────────── *@
    <div class="nav-section-title">Finansijski alati</div>
    <MudNavLink Href="/kursna-lista"
                Icon="@Icons.Material.Filled.CurrencyExchange">
        Kursna lista
    </MudNavLink>

    @* ── PODEŠAVANJA ──────────────────────────────────── *@
    <MudNavGroup Title="Podešavanja"
                 Icon="@Icons.Material.Filled.Settings"
                 Expanded="false">
        <MudNavLink Href="/podesavanja"
                    Match="NavLinkMatch.All"
                    Icon="@Icons.Material.Filled.Tune">
            Opšta podešavanja
        </MudNavLink>
        <MudNavLink Href="/podesavanja/podaci-firme"
                    Icon="@Icons.Material.Filled.Business">
            Podaci firme
        </MudNavLink>
        <MudNavLink Href="/podesavanja/sifarnici"
                    Icon="@Icons.Material.Filled.ListAlt">
            Šifarnici
        </MudNavLink>
        <MudNavLink Href="/administracija/podesavanja"
                    Icon="@Icons.Material.Filled.AdminPanelSettings">
            Administracija
        </MudNavLink>
    </MudNavGroup>

</MudNavMenu>

@code {
    private bool _tureDozvoljen;
    private bool _lagerDozvoljen;

    protected override async Task OnInitializedAsync()
    {
        _tureDozvoljen  = await ModulService.JeDozvoljen("TURE");
        _lagerDozvoljen = await ModulService.JeDozvoljen("LAGER");
    }
}
