@inherits LayoutComponentBase
@implements IAsyncDisposable
@using Microsoft.EntityFrameworkCore
@using Transport.Infrastructure.Data
@inject IJSRuntime    JS
@inject ITenantService TenantService
@inject NavigationManager Nav
@inject IDbContextFactory<MasterDbContext> MasterDbFactory

<MudThemeProvider Theme="@_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<HeadContent>
    <style>
        /* ── Sprečava horizontalno pomeranje stranice na mobilnom ── */
        body {
            overflow-x: hidden;
        }

        /* ── Sidebar navigacija ─────────────────────────── */
        .nav-section-title {
            padding: 14px 14px 4px;
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: rgba(230, 235, 240, 0.45);
        }
        .nav-sub-title {
            padding: 10px 14px 2px;
            font-size: 0.6rem;
            font-weight: 600;
            letter-spacing: 0.10em;
            text-transform: uppercase;
            color: rgba(230, 235, 240, 0.25);
            border-top: 1px solid rgba(255,255,255,0.08);
            margin-top: 4px;
        }
        .mud-nav-link {
            color: #E6EBF0 !important;
            border-radius: 6px !important;
            margin: 1px 6px !important;
        }
        .mud-nav-link:hover {
            background-color: rgba(255,255,255,0.10) !important;
        }
        .mud-nav-link.active {
            background-color: #3D8EB9 !important;
            color: #ffffff !important;
        }
        .mud-nav-link .mud-icon-root {
            color: #E6EBF0 !important;
        }
        /* ── Logo area ──────────────────────────────────── */
        .logo-area {
            display: flex;
            align-items: center;
            padding: 14px 12px 12px;
            border-bottom: 1px solid rgba(255,255,255,0.10);
            gap: 10px;
        }
        .logo-area img { height: 46px; max-width: 46px; object-fit: contain; border-radius: 8px; }
        .logo-title { color: #E6EBF0; font-weight: 700; font-size: 1rem; line-height: 1.2; }
        .logo-sub   { color: rgba(230,235,240,0.55); font-size: 0.72rem; }

        /* ── Fix za MudDialog na mobilnom (centriranje, bez pomeranja pozadine) ── */
        .mud-dialog {
            margin: 16px !important;
            max-height: 90vh;
            max-width: min(600px, calc(100vw - 32px)) !important;
            overflow-y: auto;
        }

        /* ── Tabele (MudTable/MudDataGrid) skroluju horizontalno unutar sebe,
           ne guraju celu stranicu ── */
        .mud-table-container {
            overflow-x: auto;
        }

        @@media (max-width: 600px) {
            .mud-dialog-container {
                align-items: flex-start !important;
                padding-top: 8px;
            }
            .mud-dialog {
                margin: 8px !important;
                max-width: calc(100vw - 16px) !important;
                width: 100% !important;
            }
            .mud-overlay {
                position: fixed !important;
            }
        }
    </style>
</HeadContent>

<MudLayout>
    <MudAppBar Elevation="0" Style="background:#2D3E50; border-bottom:1px solid rgba(255,255,255,0.08);">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="() => _drawerOpen = !_drawerOpen" />
        <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Class="mr-2" />
        <MudText Typo="Typo.h6" Class="mr-auto" Style="color:#E6EBF0; font-weight:600;">
            Autoprevoz — Transport
        </MudText>
        @if (TenantService.JeImpersonacija())
        {
            <MudChip T="string" Size="Size.Small"
                     Icon="@Icons.Material.Filled.Logout"
                     Style="background:#7B1FA2; color:#fff; cursor:pointer;"
                     Class="mr-2"
                     OnClick="@(() => Nav.NavigateTo("/api/superadmin/izadji", forceLoad: true))">
                SUPER ADMIN
            </MudChip>
        }
        <MudIcon Icon="@Icons.Material.Filled.Business" Style="color:rgba(230,235,240,0.60); font-size:1rem;" Class="d-none d-sm-inline" />
        <MudText Typo="Typo.body2" Class="mx-1 d-none d-sm-block" Style="color:rgba(230,235,240,0.75);">
            @TenantService.GetNazivFirme()
        </MudText>
        <MudText Typo="Typo.body2" Class="mx-1 d-none d-sm-block" Style="color:rgba(230,235,240,0.35);">·</MudText>
        <MudMenu Class="d-none d-sm-block mr-1">
            <ActivatorContent>
                <div style="display:flex; align-items:center; cursor:pointer;">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Style="color:rgba(230,235,240,0.60); font-size:1rem;" Class="mr-1" />
                    <MudText Typo="Typo.body2" Style="color:rgba(230,235,240,0.75);">
                        @(TenantService.GetImeKorisnika() is { Length: > 0 } ime ? ime : TenantService.GetNazivFirme())
                    </MudText>
                </div>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Icon="@Icons.Material.Filled.AccountCircle" OnClick="@(() => Nav.NavigateTo("/moj-nalog"))">
                    Moj nalog
                </MudMenuItem>
            </ChildContent>
        </MudMenu>
        <MudTooltip Text="Odjavi se">
            <MudIconButton Icon="@Icons.Material.Filled.Logout"
                           Style="color:#E6EBF0;"
                           OnClick="Odjavi" />
        </MudTooltip>
    </MudAppBar>

    <MudDrawer @bind-Open="@_drawerOpen" Elevation="0"
               Style="background:#2D3E50; border-right:1px solid rgba(255,255,255,0.07);">
        <div class="logo-area">
            <img src="/images/logo.png" alt="Logo"
                 onerror="this.style.display='none'" />
            <div>
                <div class="logo-title">Autoprevoz</div>
                <div class="logo-sub">Transport Management</div>
            </div>
        </div>
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        @if (_jeSamoCitanje)
        {
            <div style="background:#FBC02D; color:#212121; padding:8px 16px; text-align:center; font-size:0.85rem; font-weight:600;">
                Pristup je ograničen na pregled. Podaci su sačuvani. Kontaktirajte DAK-SOFT za produženje licence.
            </div>
        }
        else if (_danaDoIsteka is not null)
        {
            <div style="background:#FB8C00; color:#fff; padding:8px 16px; text-align:center; font-size:0.85rem; font-weight:600;">
                Licenca ističe za @_danaDoIsteka dana (@_datumDoPrikaz!.Value.ToString("dd.MM.yyyy")).
            </div>
        }
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-5 pt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _jeSamoCitanje;
    private int? _danaDoIsteka;
    private DateTime? _datumDoPrikaz;

    // Navigacija i upit ka bazi idu OVDE (posle prvog rendera, ne tokom prerendera) —
    // NavigateTo je bezbedan tek u OnAfterRenderAsync. Redirekcija na /login ostaje rezervna
    // brana (svaka stranica ima i svoju IsAuthenticated proveru), zato se ne uklanja.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (!TenantService.IsAuthenticated())
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        // Traka ispod app bara — read-only (žuta) ima prednost nad najavom isteka (narandžasta).
        // Sopstveni IDbContextFactory kontekst (ne deljeni scoped MasterDbContext) — layout i
        // stranica se renderuju paralelno, deljeni kontekst bi pucao sa "A second operation
        // started on this context". Tiho se odustaje (bez trake) ako nešto pukne ili ako
        // ap_idfirme/firma nisu pronađeni — traka nikad ne sme da obori stranicu.
        try
        {
            var idFirme = TenantService.GetIdFirme();
            if (idFirme <= 0) return;

            await using var db = await MasterDbFactory.CreateDbContextAsync();
            var red = await db.WebLicence.AsNoTracking()
                .Where(l => l.IdWebLicence == idFirme)
                .Select(l => new { l.SamoCitanje, l.DatumDo })
                .FirstOrDefaultAsync();

            if (red is null) return;

            // Ista logika kao vw_web_pristup.EfektivnoSamoCitanje / TenantService.JeSamoCitanje().
            _jeSamoCitanje = red.SamoCitanje || (red.DatumDo.HasValue && red.DatumDo.Value.Date < DateTime.Today);

            if (!_jeSamoCitanje && red.DatumDo.HasValue)
            {
                var dana = (red.DatumDo.Value.Date - DateTime.Today).Days;
                if (dana is >= 0 and <= 7)
                {
                    _danaDoIsteka  = dana;
                    _datumDoPrikaz = red.DatumDo;
                }
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MainLayout] Greška pri učitavanju statusa licence (traka se ne prikazuje): {ex.Message}");
        }
    }

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary          = "#2D3E50",
            Secondary        = "#3D8EB9",
            Background       = "#F5F7FA",
            Surface          = "#FFFFFF",
            AppbarBackground = "#2D3E50",
            AppbarText       = "#E6EBF0",
            DrawerBackground = "#2D3E50",
            DrawerText       = "#E6EBF0",
            DrawerIcon       = "#E6EBF0",
        },
        LayoutProperties = new LayoutProperties
        {
            DrawerWidthLeft = "220px"
        }
    };

    private void Odjavi() => Nav.NavigateTo("/api/auth/logout", forceLoad: true);

    async ValueTask IAsyncDisposable.DisposeAsync() => await Task.CompletedTask;
}
