@using Microsoft.EntityFrameworkCore
@using Transport.Domain.Entities
@using Transport.Infrastructure.Data
@using Microsoft.AspNetCore.Identity

@inject MasterDbContext    MasterDb
@inject TransportDbContext Db
@inject ITenantService     TenantService
@inject ISnackbar          Snackbar

<MudDialog Style="min-width:480px;">
    <DialogContent>
        @* Decoy polja — apsorbuju browser autofill umesto stvarnih polja ispod *@
        <input type="text" name="username" autocomplete="username"
               style="position:absolute; width:0; height:0; opacity:0; pointer-events:none;"
               tabindex="-1" aria-hidden="true" />
        <input type="password" name="password" autocomplete="current-password"
               style="position:absolute; width:0; height:0; opacity:0; pointer-events:none;"
               tabindex="-1" aria-hidden="true" />

        <MudGrid Spacing="2" Class="mt-1">

            <MudItem xs="12">
                <MudTextField @bind-Value="_ime"
                              Label="Ime *"
                              Variant="Variant.Outlined"
                              ShrinkLabel="true"
                              Required="true"
                              autocomplete="off"
                              data-lpignore="true"
                              data-1p-ignore="true"
                              data-bwignore="true"
                              data-form-type="other" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="_email"
                              Label="Email *"
                              Variant="Variant.Outlined"
                              ShrinkLabel="true"
                              InputType="InputType.Email"
                              Required="true"
                              autocomplete="off"
                              data-lpignore="true"
                              data-1p-ignore="true"
                              data-bwignore="true"
                              data-form-type="other" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="_lozinka"
                              Label="Lozinka *"
                              Variant="Variant.Outlined"
                              ShrinkLabel="true"
                              InputType="InputType.Password"
                              Required="true"
                              HelperText="Minimum 6 karaktera"
                              autocomplete="new-password"
                              data-lpignore="true"
                              data-1p-ignore="true"
                              data-bwignore="true"
                              data-form-type="other" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="_potvrda"
                              Label="Potvrda lozinke *"
                              Variant="Variant.Outlined"
                              ShrinkLabel="true"
                              InputType="InputType.Password"
                              Required="true"
                              autocomplete="new-password"
                              data-lpignore="true"
                              data-1p-ignore="true"
                              data-bwignore="true"
                              data-form-type="other" />
            </MudItem>

            <MudItem xs="12">
                <NativniSelect Label="Rola" Value="@_rola" ValueChanged="@(v => _rola = v ?? "2")">
                    <option value="2">Administrator</option>
                    <option value="3">Operater</option>
                </NativniSelect>
            </MudItem>

            <MudItem xs="12">
                <MudCheckBox @bind-Value="_aktivan"
                             Label="Aktivan"
                             Color="Color.Primary" />
            </MudItem>

            @if (_greska is not null)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Error" Dense="true">@_greska</MudAlert>
                </MudItem>
            }

        </MudGrid>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PersonAdd"
                   OnClick="Registruj"
                   Disabled="_ucitava">
            @(_ucitava ? "Čuvanje..." : "Registruj korisnika")
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   OnClick="() => MudDialog.Cancel()">
            Odustani
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public int    VozacId        { get; set; }
    [Parameter] public string ImeZaposlenog  { get; set; } = string.Empty;

    private string _ime     = string.Empty;
    private string _email   = string.Empty;
    private string _lozinka = string.Empty;
    private string _potvrda = string.Empty;
    private string _rola    = "2"; // Administrator — default; "Vlasnik" (1) se ne nudi ovde
    private bool   _aktivan = true;
    private bool   _ucitava;
    private string? _greska;

    protected override void OnInitialized()
    {
        _ime     = ImeZaposlenog;
        _email   = string.Empty;
        _lozinka = string.Empty;
        _potvrda = string.Empty;
        _rola    = "2";
        _greska  = null;
    }

    private async Task Registruj()
    {
        _greska = null;

        // Server-side provera — skrivanje dugmeta u VozacDialog-u NIJE zaštita.
        if (!await TenantService.JeVlasnikTrenutneFirme())
        {
            _greska = "Nemate ovlašćenje za ovu radnju.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_ime))
        {
            _greska = "Ime je obavezno.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_email) || !_email.Contains('@') || !_email.Contains('.'))
        {
            _greska = "Unesite ispravan email.";
            return;
        }

        if (_lozinka.Length < 6)
        {
            _greska = "Lozinka mora imati minimum 6 karaktera.";
            return;
        }

        if (_lozinka != _potvrda)
        {
            _greska = "Lozinke se ne poklapaju.";
            return;
        }

        _ucitava = true;
        StateHasChanged();

        try
        {
            var email = _email.Trim().ToLowerInvariant();
            var postojeciKorisnik = await MasterDb.WebKorisnici.AsNoTracking()
                .FirstOrDefaultAsync(k => k.Email == email);

            if (postojeciKorisnik is not null)
            {
                // Specifičnija poruka kad je duplikat baš u OVOJ firmi — tada je ispravna
                // radnja "Upravljaj pristupom" (VozacDialog), ne nova registracija.
                var vecClanFirme = await MasterDb.WebClanstva.AsNoTracking()
                    .AnyAsync(c => c.IdKorisnika == postojeciKorisnik.IdKorisnika && c.IdWebLicence == TenantService.GetIdFirme());

                _greska = vecClanFirme
                    ? "Taj korisnik već postoji u ovoj firmi."
                    : "Email već postoji u sistemu.";
                return;
            }

            // TODO: dodati izbor privilegija (role) — za sad svi korisnici dobijaju Admin rolu
            var adminRole = await Db.Role
                .FirstOrDefaultAsync(r => r.Naziv == "Admin");
            int privilegija = adminRole?.IdRole ?? 1;

            // 9 = DAK-SOFT SuperAdmin — dodeljuje se ISKLJUČIVO ručno kroz SQL, nikad iz aplikacije
            if (privilegija >= 9 || privilegija <= 0)
                privilegija = 1;

            var hasher = new PasswordHasher<object>();
            var hash   = hasher.HashPassword(new object(), _lozinka);

            var korisnik = new WebKorisnik
            {
                Ime            = _ime.Trim(),
                Email          = _email.Trim().ToLower(),
                LozinkaHash    = hash,
                Privilegija    = privilegija,
                Aktivan        = _aktivan ? 1 : 0,
                DatumKreiranja = DateTime.Now,
                ZadnjaPrijava  = null
            };

            // Korisnik + članstvo u istoj transakciji (v214 — pripadnost firmi ide isključivo
            // preko tbl_web_clanstvo, ne preko WebKorisnik.IdLicence).
            await using var tx = await MasterDb.Database.BeginTransactionAsync();

            MasterDb.WebKorisnici.Add(korisnik);
            await MasterDb.SaveChangesAsync();

            var idWebRole = int.TryParse(_rola, out var r) && (r == 2 || r == 3) ? r : 2;

            var clanstvo = new WebClanstvo
            {
                IdKorisnika    = korisnik.IdKorisnika,
                IdWebLicence   = TenantService.GetIdFirme(),
                IdWebRole      = idWebRole,
                JeVlasnik      = false,
                IdZaposlenog   = VozacId,
                Aktivan        = true,
                DatumDodavanja = DateTime.Now,
                DodaoKorisnik  = TenantService.GetIdKorisnika()
            };
            MasterDb.WebClanstva.Add(clanstvo);
            await MasterDb.SaveChangesAsync();

            await tx.CommitAsync();

            Snackbar.Add($"Korisnik {_ime} uspešno registrovan!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _greska = $"Greška pri registraciji: {ex.Message}";
        }
        finally
        {
            _ucitava = false;
        }
    }
}
