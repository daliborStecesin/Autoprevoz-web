@using Microsoft.EntityFrameworkCore
@using Transport.Domain.Entities
@using Transport.Infrastructure.Data
@using Microsoft.AspNetCore.Identity

@inject MasterDbContext MasterDb
@inject ITenantService  TenantService
@inject ISnackbar       Snackbar

<MudDialog Style="min-width:480px;">
    <DialogContent>
        @if (_korisnik is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <MudGrid Spacing="2" Class="mt-1">

                <MudItem xs="12">
                    <MudTextField @bind-Value="_ime"
                                  Label="Ime"
                                  Variant="Variant.Outlined"
                                  ShrinkLabel="true" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField Value="@_korisnik.Email"
                                  Label="Email"
                                  Variant="Variant.Outlined"
                                  ShrinkLabel="true"
                                  ReadOnly="true"
                                  HelperText="Email se ne može menjati" />
                </MudItem>

                @if (!_aktivan)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            Pristup deaktiviran za ovu firmu. Čekirajte "Aktivan" i sačuvajte da reaktivirate.
                        </MudAlert>
                    </MudItem>
                }

                @if (_clanstvo?.JeVlasnik == true)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Dense="true">
                            Ovo je vlasnik firme — pristup vlasnika ne može da se deaktivira.
                        </MudAlert>
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudCheckBox @bind-Value="_aktivan"
                                 Label="Aktivan (za ovu firmu)"
                                 Color="Color.Primary"
                                 Disabled="@(_clanstvo?.JeVlasnik == true)" />
                </MudItem>

                <MudItem xs="12">
                    <NativniSelect Label="Rola" Value="@_rola" ValueChanged="@(v => _rola = v ?? "2")"
                                   Disabled="@(_clanstvo?.JeVlasnik == true)">
                        @if (_clanstvo?.JeVlasnik == true)
                        {
                            <option value="1">Vlasnik</option>
                        }
                        <option value="2">Administrator</option>
                        <option value="3">Operater</option>
                    </NativniSelect>
                </MudItem>

                @if (_korisnik.ZadnjaPrijava.HasValue)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            Zadnja prijava: @_korisnik.ZadnjaPrijava.Value.ToString("dd.MM.yyyy HH:mm")
                        </MudText>
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudDivider Class="my-2" />
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.LockReset"
                               OnClick="@(() => _prikaziResetLozinke = !_prikaziResetLozinke)">
                        Resetuj lozinku
                    </MudButton>
                </MudItem>

                @if (_prikaziResetLozinke)
                {
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_novaLozinka"
                                      Label="Nova lozinka"
                                      Variant="Variant.Outlined"
                                      ShrinkLabel="true"
                                      InputType="InputType.Password"
                                      HelperText="Minimum 6 karaktera" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_potvrda"
                                      Label="Potvrda nove lozinke"
                                      Variant="Variant.Outlined"
                                      ShrinkLabel="true"
                                      InputType="InputType.Password" />
                    </MudItem>
                }

                @if (_greska is not null)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Error" Dense="true">@_greska</MudAlert>
                    </MudItem>
                }

            </MudGrid>
        }
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="Sacuvaj"
                   Disabled="@(_korisnik is null || _ucitava)">
            @(_ucitava ? "Čuvanje..." : "Sačuvaj izmene")
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   OnClick="() => MudDialog.Cancel()">
            Odustani
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public int KorisnikId { get; set; }

    private WebKorisnik? _korisnik;
    private WebClanstvo? _clanstvo;
    private string       _ime              = string.Empty;
    private bool         _aktivan;
    private string       _rola             = "2";
    private bool         _prikaziResetLozinke;
    private string       _novaLozinka      = string.Empty;
    private string       _potvrda          = string.Empty;
    private bool         _ucitava;
    private string?      _greska;

    protected override async Task OnInitializedAsync()
    {
        _korisnik = await MasterDb.WebKorisnici.FindAsync(KorisnikId);
        if (_korisnik is not null)
        {
            _ime = _korisnik.Ime ?? string.Empty;

            var idFirme = TenantService.GetIdFirme();
            _clanstvo = await MasterDb.WebClanstva
                .FirstOrDefaultAsync(c => c.IdKorisnika == KorisnikId && c.IdWebLicence == idFirme);
            _aktivan = _clanstvo?.Aktivan ?? false;
            _rola    = _clanstvo?.IdWebRole.ToString() ?? "2";
        }
    }

    private async Task Sacuvaj()
    {
        if (_korisnik is null) return;
        _greska = null;

        // Server-side provera — skrivanje dugmeta "Upravljaj pristupom" u VozacDialog-u NIJE zaštita.
        if (!await TenantService.JeVlasnikTrenutneFirme())
        {
            _greska = "Nemate ovlašćenje za ovu radnju.";
            return;
        }

        if (_clanstvo is not null && _clanstvo.Aktivan && !_aktivan)
        {
            if (_clanstvo.JeVlasnik)
            {
                _greska = "Ne možete deaktivirati pristup vlasnika firme.";
                return;
            }

            if (_clanstvo.IdKorisnika == TenantService.GetIdKorisnika())
            {
                _greska = "Ne možete deaktivirati sopstveni pristup.";
                return;
            }
        }

        if (_prikaziResetLozinke)
        {
            if (_novaLozinka.Length < 6)
            {
                _greska = "Nova lozinka mora imati minimum 6 karaktera.";
                return;
            }
            if (_novaLozinka != _potvrda)
            {
                _greska = "Lozinke se ne poklapaju.";
                return;
            }
        }

        _ucitava = true;
        StateHasChanged();

        try
        {
            _korisnik.Ime = _ime.Trim();

            if (_clanstvo is not null)
            {
                _clanstvo.Aktivan = _aktivan;

                // Rola vlasnika se ovde nikad ne menja (polje je i u UI Disabled) — dodeljuje
                // se samo pri otvaranju firme. "Vlasnik" (1) nije ponuđena vrednost za ostale.
                if (!_clanstvo.JeVlasnik && int.TryParse(_rola, out var novaRola) && (novaRola == 2 || novaRola == 3))
                    _clanstvo.IdWebRole = novaRola;
            }

            if (_prikaziResetLozinke && _novaLozinka.Length >= 6)
            {
                var hasher = new PasswordHasher<object>();
                _korisnik.LozinkaHash = hasher.HashPassword(new object(), _novaLozinka);
            }

            await MasterDb.SaveChangesAsync();

            Snackbar.Add("Pristup uspešno ažuriran.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _greska = $"Greška pri čuvanju: {ex.Message}";
        }
        finally
        {
            _ucitava = false;
        }
    }
}
