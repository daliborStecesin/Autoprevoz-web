@using Microsoft.EntityFrameworkCore
@using Transport.Domain.Entities
@using Transport.Infrastructure.Data

@inject TransportDbContext Db
@inject MasterDbContext    MasterDb
@inject ITenantService     TenantService
@inject IDialogService     Dialog
@inject ISnackbar          Snackbar

<MudDialog>
    <TitleContent>
        <div style="display:flex; align-items:center; gap:10px;">
            <MudText Typo="Typo.h6">Zaposleni</MudText>
            @if (VozacId > 0 && _entitet is not null)
            {
                @if (_entitet.aktivan == 1)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Style="margin:0;">Aktivan</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small" Style="margin:0;">Neaktivan</MudChip>
                }
            }
        </div>
    </TitleContent>
    <DialogContent>
        <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true">

            @* ── TAB 1 — Osnovni podaci ─────────────────────────────── *@
            <MudTabPanel Text="Osnovni podaci" Icon="@Icons.Material.Filled.Person">
                <MudGrid Spacing="2" Class="mt-2">

                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_ime"
                                      Label="Ime *"
                                      Variant="Variant.Outlined"
                                      ShrinkLabel="true"
                                      Required="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_prezime"
                                      Label="Prezime *"
                                      Variant="Variant.Outlined"
                                      ShrinkLabel="true"
                                      Required="true" />
                    </MudItem>

                    <MudItem xs="12" sm="8">
                        <MudTextField @bind-Value="_adresa"
                                      Label="Adresa"
                                      Variant="Variant.Outlined"
                                      ShrinkLabel="true" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_mesto"
                                      Label="Mesto"
                                      Variant="Variant.Outlined"
                                      ShrinkLabel="true" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_telefon"
                                      Label="Telefon"
                                      Variant="Variant.Outlined"
                                      ShrinkLabel="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_telefonMob"
                                      Label="Mobilni"
                                      Variant="Variant.Outlined"
                                      ShrinkLabel="true" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_mail"
                                      Label="E-mail"
                                      Variant="Variant.Outlined"
                                      ShrinkLabel="true"
                                      InputType="InputType.Email" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_zaposlenje"
                                      Label="Zaposlenje"
                                      Variant="Variant.Outlined"
                                      ShrinkLabel="true" />
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_jmbg"
                                      Label="JMBG"
                                      Variant="Variant.Outlined"
                                      ShrinkLabel="true" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_brojLK"
                                      Label="Broj LK"
                                      Variant="Variant.Outlined"
                                      ShrinkLabel="true" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_pasos"
                                      Label="Br. Pasoša"
                                      Variant="Variant.Outlined"
                                      ShrinkLabel="true" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <DateInput Label="Istek dozvole" @bind-Value="_istekDozvole" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <DateInput Label="Istek pasoša" @bind-Value="_istekPasosa" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <DateInput Label="Zaposlen od" @bind-Value="_datumZaposlenja" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <DateInput Label="Datum rođenja" @bind-Value="_datumRodjenja" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="_komentar"
                                      Label="Komentar"
                                      Variant="Variant.Outlined"
                                      ShrinkLabel="true"
                                      Lines="2" />
                    </MudItem>

                </MudGrid>
            </MudTabPanel>

            @* ── TAB 2 — Obračun plate ──────────────────────────────── *@
            <MudTabPanel Text="Obračun plate" Icon="@Icons.Material.Filled.Payments">
                <MudGrid Spacing="3" Class="mt-2">

                    @* Radio izbor tipa — ne koristi popup, radi pouzdano unutar dialoga *@
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="mb-1 mud-text-secondary">
                            Tip isplate
                        </MudText>
                        <MudRadioGroup T="string" @bind-Value="_tipIsplate">
                            <MudRadio T="string" Value="@("DNEVNICA")" Color="Color.Primary">Dnevnica</MudRadio>
                            <MudRadio T="string" Value="@("PROCENAT")" Color="Color.Primary">Procenat</MudRadio>
                            <MudRadio T="string" Value="@("FIXNO")"    Color="Color.Primary">Fiksna plata</MudRadio>
                            <MudRadio T="string" Value="@("PO_KM")"    Color="Color.Primary">Po kilometru</MudRadio>
                        </MudRadioGroup>
                    </MudItem>

                    @* Dinamičko polje ovisno o izabranom tipu *@
                    @if (_tipIsplate == "DNEVNICA")
                    {
                        <MudItem xs="12" sm="5">
                            <MudNumericField @bind-Value="_dnevnica"
                                             Label="Dnevnica"
                                             Variant="Variant.Outlined"
                                             Format="F2"
                                             Adornment="Adornment.End"
                                             AdornmentText="EUR" />
                        </MudItem>
                    }
                    else if (_tipIsplate == "PROCENAT")
                    {
                        <MudItem xs="12" sm="5">
                            <MudNumericField @bind-Value="_procenat"
                                             Label="Procenat za platu"
                                             Variant="Variant.Outlined"
                                             Format="F2"
                                             Adornment="Adornment.End"
                                             AdornmentText="%" />
                        </MudItem>
                    }
                    else if (_tipIsplate == "FIXNO")
                    {
                        <MudItem xs="12" sm="5">
                            <MudNumericField @bind-Value="_fixnoPlata"
                                             Label="Fiksna plata"
                                             Variant="Variant.Outlined"
                                             Format="F2"
                                             Adornment="Adornment.End"
                                             AdornmentText="RSD" />
                        </MudItem>
                    }
                    else if (_tipIsplate == "PO_KM")
                    {
                        <MudItem xs="12" sm="5">
                            <MudNumericField @bind-Value="_cenaPoKm"
                                             Label="Cena po kilometru"
                                             Variant="Variant.Outlined"
                                             Format="F2"
                                             Adornment="Adornment.End"
                                             AdornmentText="EUR/km" />
                        </MudItem>
                    }

                </MudGrid>
            </MudTabPanel>

            @* ── TAB 3 — Bankovni podaci ─────────────────────────────── *@
            <MudTabPanel Text="Bankovni podaci" Icon="@Icons.Material.Filled.AccountBalance">
                <MudGrid Spacing="3" Class="mt-2">
                    <MudItem xs="12">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="() => OtvoriDodajRacun()">
                            DODAJ RAČUN
                        </MudButton>
                    </MudItem>

                    <MudItem xs="12">
                        @if (_racuni.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                Nema bankovnih računa.
                            </MudText>
                        }
                        else
                        {
                            <MudDataGrid T="VozacRacun"
                                         @key="_racuni"
                                         Items="_racuni"
                                         Dense="true"
                                         Striped="true"
                                         Hover="true"
                                         Bordered="true">
                                <Columns>
                                    <PropertyColumn Property="x => x.nazivBanke" Title="Naziv banke" />
                                    <PropertyColumn Property="x => x.racun" Title="Broj računa" />
                                    <PropertyColumn Property="x => x.IBAN" Title="IBAN" />
                                    <PropertyColumn Property="x => x.valuta" Title="Valuta" />
                                    <PropertyColumn Property="x => x.tipRacuna" Title="Tip" />
                                    <TemplateColumn Title="Glavni" Width="110px">
                                        <CellTemplate>
                                            @if (context.Item.glavniRacun == 1)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" />
                                            }
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <TemplateColumn Title="" Width="70px">
                                        <CellTemplate>
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           OnClick="@(() => UkloniRacun(context.Item))" />
                                        </CellTemplate>
                                    </TemplateColumn>
                                </Columns>
                            </MudDataGrid>
                        }
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

        </MudTabs>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="@(async () => await SacuvajDugme())">
            Sačuvaj
        </MudButton>

        @if (EfektivniVozacId > 0)
        {
            @* Upravljanje web pristupom (registracija/aktivacija naloga) — samo vlasnik firme
               ili superadmin (v215). Skrivanje dugmeta nije zaštita — server-side provera je
               u Registruj()/Sacuvaj() unutar odgovarajućih dijaloga. *@
            @if (_jeVlasnik)
            {
                @if (_webKorisnik is null)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.PersonAdd"
                               OnClick="OtvoriRegistraciju">
                        Registruj kao korisnika
                    </MudButton>
                }
                else
                {
                    @if (_clanstvo?.Aktivan == false)
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Style="margin:0;">Pristup deaktiviran</MudChip>
                    }
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.ManageAccounts"
                               OnClick="OtvoriUpravljanje">
                        Upravljaj pristupom
                    </MudButton>
                }
            }

            @* Aktivacija/deaktivacija ZAPOSLENOG (HR akcija) — Vlasnik/Administrator, NE Operater.
               Kaskada na web pristup (ispod, u Deaktiviraj()) ima sopstvene, dodatne provere. *@
            @if (_smeHrAkcije)
            {
                @if (_entitet?.aktivan == 1)
                {
                    @if (RazlogZabraneDeaktivacije is { } razlogZabrane)
                    {
                        <MudTooltip Text="@razlogZabrane">
                            <span>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Error"
                                           StartIcon="@Icons.Material.Filled.PersonOff"
                                           Disabled="true">
                                    Deaktiviraj
                                </MudButton>
                            </span>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.PersonOff"
                                   OnClick="Deaktiviraj">
                            Deaktiviraj
                        </MudButton>
                    }
                }
                else
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.PersonAdd"
                               OnClick="Aktiviraj">
                        Reaktiviraj
                    </MudButton>
                }
            }
        }

        <MudButton Variant="Variant.Outlined"
                   OnClick="() => MudDialog.Cancel()">
            Odustani
        </MudButton>
    </DialogActions>
</MudDialog>

@implements IDisposable

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter]          public int        VozacId  { get; set; }

    // VozacId ([Parameter]) ostaje 0 za nov unos i ne menja se kad Sačuvaj popuni
    // _entitet.Broj — efektivni ID prati stvarno stanje bez potrebe da se dijalog
    // zatvori i ponovo otvori.
    private int EfektivniVozacId => VozacId > 0 ? VozacId : (_entitet?.Broj ?? 0);

    private Vozac?      _entitet;
    private WebKorisnik? _webKorisnik;
    private WebClanstvo? _clanstvo;
    private bool         _jeVlasnik;
    private bool         _smeHrAkcije;
    private bool         _disposed;

    // Tab 1
    private string    _ime          = string.Empty;
    private string    _prezime      = string.Empty;
    private string?   _adresa;
    private string?   _mesto;
    private string?   _telefon;
    private string?   _telefonMob;
    private string?   _mail;
    private string?   _zaposlenje;
    private string?   _jmbg;
    private string?   _brojLK;
    private string?   _pasos;
    private string?   _komentar;
    private string _istekDozvole    = string.Empty;
    private string _istekPasosa     = string.Empty;
    private string _datumZaposlenja = string.Empty;
    private string _datumRodjenja   = string.Empty;

    // Tab 2
    private string   _tipIsplate  = "DNEVNICA";
    private decimal? _dnevnica;
    private decimal? _procenat;
    private decimal? _fixnoPlata;
    private decimal? _cenaPoKm;

    private List<VozacRacun> _racuni = [];

    protected override async Task OnInitializedAsync()
    {
        var rola     = await TenantService.RolaTrenutneFirme();
        _jeVlasnik   = rola == 1;
        _smeHrAkcije = rola == 1 || rola == 2; // Vlasnik/Administrator — Operater (3) nema HR akcije

        if (VozacId > 0)
        {
            _entitet = await Db.Vozaci.IgnoreQueryFilters()
                                      .FirstOrDefaultAsync(v => v.Broj == VozacId);
            if (_entitet is not null)
            {
                _ime             = _entitet.Ime         ?? string.Empty;
                _prezime         = _entitet.Prezime     ?? string.Empty;
                _adresa          = _entitet.Adresa;
                _mesto           = _entitet.Mesto;
                _telefon         = _entitet.Telefon;
                _telefonMob      = _entitet.TelefonMob;
                _mail            = _entitet.Mail;
                _zaposlenje      = _entitet.Zaposlenje;
                _jmbg            = _entitet.JMBG;
                _brojLK          = _entitet.BrojLK;
                _pasos           = _entitet.pasos;
                _komentar        = _entitet.Komentar;
                _tipIsplate      = _entitet.tipIsplate  ?? "DNEVNICA";
                _dnevnica        = _entitet.dnevnica;
                _procenat        = _entitet.procenatZaPlatu;
                _fixnoPlata      = _entitet.fixnoPlata;
                _cenaPoKm        = _entitet.cenaPoKm;

                _istekDozvole    = ToIso(_entitet.istekDozvole);
                _istekPasosa     = ToIso(_entitet.istekPasosa);
                _datumZaposlenja = ToIso(_entitet.datumZaposlenja);
                _datumRodjenja   = ToIso(_entitet.datumRodjenja);

                await UcitajRacune();
            }
        }

        if (VozacId > 0)
            await UcitajWebKorisnika();
    }

    // IdZaposlenog je PER-FIRMA polje na tbl_web_clanstvo (isti web korisnik može imati
    // različit Broj zaposlenog u različitim klijentskim bazama, jedno po članstvu) —
    // zato se traži OVDE, ne na WebKorisnik.IdZaposlenog. Taj je globalan (jedna vrednost
    // za CELOG korisnika, kroz sve firme) i ProvisioningService (novi vlasnik pri kreiranju
    // firme) ga ne popunjava — samo WebKorisnikRegistracijaDialog. Bez ove izmene, vlasnik
    // dobijen kroz "Nova firma" panel je zaveden kao neregistrovan (VozacDialog nudi
    // "Registruj kao korisnika" umesto "Upravljaj pristupom").
    private async Task UcitajWebKorisnika()
    {
        // Bez filtera po Aktivan — mora naći i deaktivirano članstvo, inače "Upravljaj
        // pristupom"/reaktivacija ne bi bila moguća (vidi VozacDialog čip "Pristup deaktiviran").
        var idFirme = TenantService.GetIdFirme();
        var red = await (from c in MasterDb.WebClanstva
                          join k in MasterDb.WebKorisnici on c.IdKorisnika equals k.IdKorisnika
                          where c.IdWebLicence == idFirme && c.IdZaposlenog == VozacId
                          select new { Korisnik = k, Clanstvo = c })
                         .FirstOrDefaultAsync();

        // Fallback za redove kod kojih je veza "izgubljena" (IdZaposlenog na članstvu je
        // NULL — stariji podaci od pre ove izmene): ako u OVOJ firmi već postoji web
        // korisnik sa ISTIM email-om kao ovaj zaposleni, poveži ih sada (upiši IdZaposlenog)
        // umesto da dijalog ponudi novu registraciju za već postojećeg korisnika.
        if (red is null && !string.IsNullOrWhiteSpace(_mail))
        {
            var email = _mail.Trim().ToLowerInvariant();
            red = await (from c in MasterDb.WebClanstva
                         join k in MasterDb.WebKorisnici on c.IdKorisnika equals k.IdKorisnika
                         where c.IdWebLicence == idFirme && c.IdZaposlenog == null
                            && k.Email != null && k.Email.ToLower() == email
                         select new { Korisnik = k, Clanstvo = c })
                        .FirstOrDefaultAsync();

            if (red is not null)
            {
                var clanstvo = await MasterDb.WebClanstva.FirstOrDefaultAsync(c => c.IdClanstva == red.Clanstvo.IdClanstva);
                if (clanstvo is not null)
                {
                    clanstvo.IdZaposlenog = VozacId;
                    await MasterDb.SaveChangesAsync();
                }
            }
        }

        _webKorisnik = red?.Korisnik;
        _clanstvo    = red?.Clanstvo;
    }

    private async Task OtvoriRegistraciju()
    {
        if (_disposed) return;

        if (_entitet is null || _entitet.Broj == 0)
        {
            var sacuvano = await Sacuvaj(false);
            if (!sacuvano || _disposed) return;
        }

        if (_entitet is null) return;

        var imeZaposlenog = $"{_ime} {_prezime}".Trim();
        var opts = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var prms = new DialogParameters<WebKorisnikRegistracijaDialog>
        {
            { x => x.VozacId,       EfektivniVozacId },
            { x => x.ImeZaposlenog, imeZaposlenog }
        };
        var dialog = await Dialog.ShowAsync<WebKorisnikRegistracijaDialog>("Registruj kao korisnika", prms, opts);

        if (!(await dialog.Result).Canceled && !_disposed)
        {
            await UcitajWebKorisnika();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OtvoriUpravljanje()
    {
        if (_disposed || _webKorisnik is null) return;

        var opts = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var prms = new DialogParameters<WebKorisnikUpravljanjeDialog>
        {
            { x => x.KorisnikId, _webKorisnik.IdKorisnika }
        };
        var dialog = await Dialog.ShowAsync<WebKorisnikUpravljanjeDialog>("Upravljaj pristupom", prms, opts);

        if (!(await dialog.Result).Canceled && !_disposed)
        {
            await UcitajWebKorisnika();
            await InvokeAsync(StateHasChanged);
        }
    }

    // Dugme "Sačuvaj" u DialogActions: prvo čuvanje NOVOG zaposlenog ostavlja dijalog
    // otvorenim (da se odmah pojavi dugme "Registruj kao korisnika"); svako sledeće
    // čuvanje (izmena postojećeg) zatvara dijalog kao i do sad.
    private async Task SacuvajDugme()
    {
        var jeNov = _entitet is null || _entitet.Broj == 0;
        await Sacuvaj(closeDialog: !jeNov);
    }

    private async Task<bool> Sacuvaj(bool closeDialog = true)
    {
        if (string.IsNullOrWhiteSpace(_ime))
        {
            Snackbar.Add("Ime je obavezno polje.", Severity.Warning);
            return false;
        }

        if (_entitet is null)
        {
            _entitet = new Vozac { aktivan = 1 };
            Db.Vozaci.Add(_entitet);
        }

        _entitet.Ime             = _ime;
        _entitet.Prezime         = _prezime;
        _entitet.Adresa          = _adresa;
        _entitet.Mesto           = _mesto;
        _entitet.Telefon         = _telefon;
        _entitet.TelefonMob      = _telefonMob;
        _entitet.Mail            = _mail;
        _entitet.Zaposlenje      = _zaposlenje;
        _entitet.JMBG            = _jmbg;
        _entitet.BrojLK          = _brojLK;
        _entitet.pasos           = _pasos;
        _entitet.Komentar        = _komentar;
        _entitet.tipIsplate      = _tipIsplate;
        _entitet.dnevnica        = _tipIsplate == "DNEVNICA" ? _dnevnica       : null;
        _entitet.procenatZaPlatu = _tipIsplate == "PROCENAT" ? _procenat       : null;
        _entitet.fixnoPlata      = _tipIsplate == "FIXNO"    ? _fixnoPlata     : null;
        _entitet.cenaPoKm        = _tipIsplate == "PO_KM"    ? _cenaPoKm       : null;
        _entitet.istekDozvole    = FromIso(_istekDozvole);
        _entitet.istekPasosa     = FromIso(_istekPasosa);
        _entitet.datumZaposlenja = FromIso(_datumZaposlenja);
        _entitet.datumRodjenja   = FromIso(_datumRodjenja);

        await Db.SaveChangesAsync();
        if (_disposed) return false;

        Snackbar.Add("Zaposleni sačuvan.", Severity.Success);

        if (closeDialog && !_disposed)
        {
            MudDialog.Close(DialogResult.Ok(true));
        }

        return true;
    }

    private void OtvoriDodajRacun()
    {
        if (_disposed) return;
        _ = OtvoriDodajRacunAsync();
    }

    private async Task OtvoriDodajRacunAsync()
    {
        if (_disposed) return;

        if (_entitet is null || _entitet.Broj == 0)
        {
            var sacuvano = await Sacuvaj(false);
            if (!sacuvano || _disposed) return;
        }

        if (_entitet is null) return;

        var opts = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var parameters = new DialogParameters<RacunVozacaDialog> { { x => x.VozacId, _entitet.Broj } };
        var dialog = await Dialog.ShowAsync<RacunVozacaDialog>("Novi račun", parameters, opts);

        try
        {
            var result = await dialog.Result;
            if (_disposed) return;
            if (!result.Canceled)
            {
                await UcitajRacune();
                if (!_disposed)
                {
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (ObjectDisposedException)
        {
            if (!_disposed)
            {
                Snackbar.Add("Dialog je zatvoren pre nego što je rezultat mogao da se obradi.", Severity.Error);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            if (!_disposed)
            {
                Snackbar.Add($"Greška pri otvaranju računa: {ex.Message}", Severity.Error);
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task UcitajRacune()
    {
        if (_disposed) return;

        if (_entitet is null || _entitet.Broj == 0)
        {
            _racuni.Clear();
            return;
        }

        _racuni = await Db.VozacRacuni
            .Where(r => r.idVozaca == _entitet.Broj)
            .OrderByDescending(r => r.glavniRacun)
            .ThenBy(r => r.nazivBanke)
            .ToListAsync();
    }

    private async Task UkloniRacun(VozacRacun racun)
    {
        if (_disposed || racun is null) return;

        racun.aktivan = 0;
        await Db.SaveChangesAsync();
        if (_disposed) return;

        Snackbar.Add("Račun je uklonjen.", Severity.Info);
        await UcitajRacune();
    }

    // Kaskada iz Deaktiviraj() gasi članstvo SAMO ako je izvršilac vlasnik trenutne firme
    // (ili superadmin — _jeVlasnik već obuhvata oba, vidi JeVlasnikTrenutneFirme). Pristupom
    // upravlja isključivo vlasnik, bez obzira kojim putem se do promene dolazi — HR akcija
    // (deaktivacija zaposlenog) ne sme da bude zaobilazni put. Ni tako, kaskada nikad ne gasi
    // vlasničko ni sopstveno članstvo — firma mora uvek imati bar jedno aktivno JeVlasnik=1.
    private bool KaskadaSmeDaGasiClanstvo()
        => _jeVlasnik
        && _clanstvo is not null
        && _clanstvo.Aktivan
        && !_clanstvo.JeVlasnik
        && _clanstvo.IdKorisnika != TenantService.GetIdKorisnika();

    // HR akcija (deaktivacija ZAPOSLENOG) je odvojena od kaskade na članstvo iznad — bez
    // ovoga, izvršilac je mogao ugasiti sopstveni zaposleni red (aktivan=0) čak i kad
    // kaskada ispravno štiti njegovo/vlasničko ČLANSTVO (web pristup), pošto ta provera
    // nikad nije doticala samu HR akciju. _clanstvo je već po TRENUTNOJ firmi (učitano u
    // UcitajWebKorisnika preko WebClanstvo.IdZaposlenog za ovog zaposlenog).
    private string? RazlogZabraneDeaktivacije
    {
        get
        {
            if (_clanstvo is null) return null;
            if (_clanstvo.IdKorisnika == TenantService.GetIdKorisnika())
                return "Ne možete deaktivirati sopstveni nalog.";
            if (_clanstvo.JeVlasnik)
                return "Zaposleni je vlasnik firme — ne može se deaktivirati.";
            return null;
        }
    }

    private async Task Deaktiviraj()
    {
        if (_disposed || _entitet is null) return;

        // Server-side provera — skrivanje/disable dugmeta NIJE zaštita.
        if (!_smeHrAkcije)
        {
            Snackbar.Add("Nemate ovlašćenje za ovu radnju.", Severity.Error);
            return;
        }

        if (RazlogZabraneDeaktivacije is { } razlog)
        {
            Snackbar.Add(razlog, Severity.Error);
            return;
        }

        var poruka = KaskadaSmeDaGasiClanstvo()
            ? "Da li ste sigurni? Zaposleni neće biti obrisan, samo deaktiviran. Njegov web pristup za ovu firmu će takođe biti deaktiviran."
            : "Da li ste sigurni? Zaposleni neće biti obrisan, samo deaktiviran.";

        var potvrda = await Dialog.ShowMessageBox(
            "Potvrda deaktivacije",
            poruka,
            yesText: "Da, deaktiviraj",
            cancelText: "Odustani");

        if (_disposed || potvrda != true) return;

        _entitet.aktivan = 0;
        await Db.SaveChangesAsync();
        if (_disposed) return;

        // Kaskadna deaktivacija: gasi ČLANSTVO za ovu firmu (ne korisnika globalno —
        // ista osoba može biti zaposlena i imati web pristup u više firmi istovremeno).
        // Vlasničko članstvo (JeVlasnik=1) i sopstveno članstvo se NIKAD ne gase ovim putem.
        if (KaskadaSmeDaGasiClanstvo())
        {
            _clanstvo!.Aktivan = false;
            await MasterDb.SaveChangesAsync();
        }
        else if (_clanstvo is not null && _clanstvo.Aktivan)
        {
            Snackbar.Add("Zaposleni je deaktiviran. Web pristup nije ukinut — to može samo vlasnik firme.", Severity.Warning);
        }

        Snackbar.Add("Zaposleni deaktiviran.", Severity.Info);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private async Task Aktiviraj()
    {
        if (_disposed || _entitet is null) return;

        // Server-side provera — skrivanje dugmeta NIJE zaštita.
        if (!_smeHrAkcije)
        {
            Snackbar.Add("Nemate ovlašćenje za ovu radnju.", Severity.Error);
            return;
        }

        var potvrda = await Dialog.ShowMessageBox(
            "Potvrda reaktivacije",
            "Da li ste sigurni da želite da reaktivirate ovog zaposlenog? Web pristup (ako je postojao) se ne vraća automatski — to se radi zasebno kroz \"Upravljaj pristupom\".",
            yesText: "Da, reaktiviraj",
            cancelText: "Odustani");

        if (_disposed || potvrda != true) return;

        _entitet.aktivan = 1;
        await Db.SaveChangesAsync();
        if (_disposed) return;

        Snackbar.Add("Zaposleni reaktiviran.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private static string ToIso(DateOnly? d)
        => d.HasValue ? d.Value.ToString("yyyy-MM-dd") : string.Empty;

    private static DateOnly? FromIso(string s)
        => DateTime.TryParse(s, out var dt) ? DateOnly.FromDateTime(dt) : null;

    public void Dispose()
    {
        _disposed = true;
    }
}
