@page "/ds"
@layout SuperAdminLayout

@using Microsoft.EntityFrameworkCore
@using Transport.Domain.Entities
@using Transport.Infrastructure.Data

@inject ITenantService                     TenantService
@inject IDbContextFactory<MasterDbContext> MasterDbFactory
@inject NavigationManager                  Nav
@inject IDialogService                     Dialog

<PageTitle>Super admin — Autoprevoz</PageTitle>

<style>
    /* table-layout fixed — bez ovoga je procenat širine kolone samo predlog i browser
       širi kolonu preko procenta kad sadržaj (chip, dugme) prirodno ne staje, što
       izaziva horizontalni scroll uprkos definisanim širinama. */
    .ds-licence-table table {
        table-layout: fixed;
        width: 100%;
    }
</style>

<MudText Typo="Typo.h4" Class="mb-4">Super admin panel</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Ulogovani korisnik: <b>@TenantService.GetImeKorisnika()</b>
</MudText>

@if (!string.IsNullOrEmpty(Greska))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@Greska</MudAlert>
}

<MudGrid Spacing="3">

    @* ── LEVO — Licence ──────────────────────────────────────────────── *@
    <MudItem xs="12" md="6">
        <MudPaper Elevation="1" Class="pa-3">
            <div class="d-flex align-center justify-space-between mb-2">
                <MudText Typo="Typo.subtitle1" Style="font-weight:600; color:#2D3E50;">Licence</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@_licencePrikazane.Count prikazano</MudText>
            </div>

            <div class="mb-2">
                <NativniInput TValue="string" Label="Pretraga (naziv ili PIB)" Value="@_licencaPretraga"
                              ValueChanged="@(v => { _licencaPretraga = v ?? string.Empty; AzurirajLicence(); })" />
            </div>

            <div class="d-flex align-center mb-2" style="gap:16px;">
                <MudCheckBox T="bool" Value="_samoWebAktivne" Dense="true" Color="Color.Primary"
                             Label="Samo web aktivne"
                             ValueChanged="@((bool v) => { _samoWebAktivne = v; AzurirajLicence(); })" />
                <MudCheckBox T="bool" Value="_samoVazece" Dense="true" Color="Color.Primary"
                             Label="Samo važeće"
                             ValueChanged="@((bool v) => { _samoVazece = v; AzurirajLicence(); })" />
            </div>

            @if (_licencePrikazane.Count == 0)
            {
                <MudText Align="Align.Center" Class="mud-text-secondary my-6" Style="display:block;">
                    Nema rezultata.
                </MudText>
            }
            else
            {
                <MudTable Items="_licencePrikazane" T="Licenca"
                          Dense="true" Hover="true" FixedHeader="true" Height="60vh"
                          Class="ds-licence-table" Style="overflow-x:hidden;"
                          RowClick="OnLicencaRowClick"
                          RowStyleFunc="@((l, _) => l.IdLicence == _izabranaLicencaId ? "background:#F3E5F5;" : "")">
                    <HeaderContent>
                        <MudTh Style="width:34%; font-size:0.75rem;">Naziv</MudTh>
                        <MudTh Style="width:16%; font-size:0.75rem;">PIB</MudTh>
                        <MudTh Style="width:15%; font-size:0.75rem;">Datum licence</MudTh>
                        <MudTh Style="width:10%; font-size:0.75rem;">Web</MudTh>
                        <MudTh Style="width:10%; font-size:0.75rem;">Kor.</MudTh>
                        <MudTh Style="width:15%; font-size:0.75rem;"></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Naziv">
                            <span style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; font-size:0.8rem;"
                                  title="@context.Naziv">@context.Naziv</span>
                        </MudTd>
                        <MudTd DataLabel="PIB">@context.PIB</MudTd>
                        <MudTd DataLabel="Datum licence">
                            @if (context.DatumLicence.HasValue)
                            {
                                var istekla = context.DatumLicence.Value < DateOnly.FromDateTime(DateTime.Today);
                                <span style="@(istekla ? "color:#c62828;" : "")">
                                    @context.DatumLicence.Value.ToString("dd.MM.yy")
                                </span>
                            }
                        </MudTd>
                        <MudTd DataLabel="Web">
                            <MudChip T="string" Size="Size.Small" Color="@(context.WebAktivan == 1 ? Color.Success : Color.Default)">
                                @(context.WebAktivan == 1 ? "DA" : "NE")
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Kor.">@_brojKorisnikaPoLicenci.GetValueOrDefault(context.IdLicence, 0)</MudTd>
                        <MudTd Style="text-align:center; white-space:nowrap;">
                            <span @onclick="@(() => { })" @onclick:stopPropagation="true">
                                <MudTooltip Text="Izmeni">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Size="Size.Small"
                                                   Color="Color.Default"
                                                   OnClick="@(() => IzmeniLicencu(context))" />
                                </MudTooltip>
                                <MudTooltip Text="Uđi u firmu">
                                    <span>
                                        <MudIconButton Icon="@Icons.Material.Filled.Login"
                                                       Size="Size.Small"
                                                       Color="Color.Primary"
                                                       Disabled="@(string.IsNullOrEmpty(context.ConnectionString))"
                                                       OnClick="@(() => UdjiUFirmu(context.IdLicence))" />
                                    </span>
                                </MudTooltip>
                            </span>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    </MudItem>

    @* ── DESNO — Web korisnici ───────────────────────────────────────── *@
    <MudItem xs="12" md="6">
        <MudPaper Elevation="1" Class="pa-3">
            <div class="d-flex align-center justify-space-between mb-2">
                <MudText Typo="Typo.subtitle1" Style="font-weight:600; color:#2D3E50;">Web korisnici</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@_korisniciPrikazani.Count prikazano</MudText>
            </div>

            @if (_izabranaLicencaId is not null)
            {
                <MudChip T="string" Color="Color.Secondary" Class="mb-2"
                         OnClose="@(() => PonistiIzborLicence())">
                    Firma: @_izabranaLicencaNaziv
                </MudChip>
            }

            <div class="mb-2">
                <NativniInput TValue="string" Label="Pretraga (ime ili email)" Value="@_korisnikPretraga"
                              ValueChanged="@(v => { _korisnikPretraga = v ?? string.Empty; AzurirajKorisnike(); })" />
            </div>

            @if (_korisniciPrikazani.Count == 0)
            {
                <MudText Align="Align.Center" Class="mud-text-secondary my-6" Style="display:block;">
                    Nema rezultata.
                </MudText>
            }
            else
            {
                <MudTable Items="_korisniciPrikazani" T="WebKorisnik"
                          Dense="true" Hover="true" FixedHeader="true" Height="60vh">
                    <HeaderContent>
                        <MudTh Style="width:20%;">Ime</MudTh>
                        <MudTh Style="width:28%;">Email</MudTh>
                        <MudTh Style="width:24%;">Firma</MudTh>
                        <MudTh Style="width:10%;">Aktivan</MudTh>
                        <MudTh Style="width:18%;">Zadnja prijava</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Ime">@context.Ime</MudTd>
                        <MudTd DataLabel="Email" Style="font-size:0.8rem; word-break:break-all;">@context.Email</MudTd>
                        <MudTd DataLabel="Firma">
                            <span style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;"
                                  title="@(context.Licenca?.Naziv ?? "—")">@(context.Licenca?.Naziv ?? "—")</span>
                        </MudTd>
                        <MudTd DataLabel="Aktivan">
                            <MudChip T="string" Size="Size.Small" Color="@(context.Aktivan == 1 ? Color.Success : Color.Error)">
                                @(context.Aktivan == 1 ? "DA" : "NE")
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Zadnja prijava" Style="white-space:nowrap;">@(context.ZadnjaPrijava?.ToString("dd.MM.yy HH:mm") ?? "—")</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    </MudItem>

</MudGrid>

@code {
    [SupplyParameterFromQuery(Name = "greska")]
    public string? Greska { get; set; }

    private List<Licenca>     _sveLicence    = [];
    private List<WebKorisnik> _sviKorisnici  = []; // već bez Privilegija==9 (superadmin)
    private Dictionary<int, int> _brojKorisnikaPoLicenci = [];

    private List<Licenca>     _licencePrikazane   = [];
    private List<WebKorisnik> _korisniciPrikazani = [];

    private string _licencaPretraga  = "";
    private string _korisnikPretraga = "";

    private bool _samoWebAktivne = true;
    private bool _samoVazece     = false;

    private int?    _izabranaLicencaId;
    private string? _izabranaLicencaNaziv;

    protected override async Task OnInitializedAsync()
    {
        await UcitajLicence();

        // Kratkotrajan, izolovan MasterDbContext preko IDbContextFactory (ne deljeni
        // scoped) — SuperAdminLayout guard i ova stranica se inicijalizuju preklapajuće
        // u istom Blazor circuit-u, pa bi deljena scoped instanca izazvala
        // "A second operation was started on this context instance...".
        await using var db = await MasterDbFactory.CreateDbContextAsync();

        _sviKorisnici = await db.WebKorisnici.AsNoTracking()
            .Include(k => k.Licenca)
            .Where(k => k.Privilegija != 9)
            .OrderBy(k => k.Ime)
            .ToListAsync();

        _brojKorisnikaPoLicenci = _sviKorisnici
            .Where(k => k.IdLicence.HasValue)
            .GroupBy(k => k.IdLicence!.Value)
            .ToDictionary(g => g.Key, g => g.Count());

        AzurirajKorisnike();
    }

    private async Task UcitajLicence()
    {
        await using var db = await MasterDbFactory.CreateDbContextAsync();

        _sveLicence = await db.Licence.AsNoTracking()
            .OrderBy(l => l.Naziv)
            .ToListAsync();

        AzurirajLicence();
    }

    private void AzurirajLicence()
    {
        var tekst = _licencaPretraga.Trim();

        IEnumerable<Licenca> izvor = _sveLicence;

        // Filteri (checkbox + checkbox + tekst) rade ZAJEDNO (AND).
        if (_samoWebAktivne)
            izvor = izvor.Where(l => l.WebAktivan == 1);

        if (_samoVazece)
        {
            var danas = DateOnly.FromDateTime(DateTime.Today);
            izvor = izvor.Where(l => l.DatumLicence.HasValue && l.DatumLicence.Value >= danas);
        }

        if (!string.IsNullOrEmpty(tekst))
            izvor = izvor.Where(l =>
                (l.Naziv ?? "").Contains(tekst, StringComparison.OrdinalIgnoreCase) ||
                (l.PIB   ?? "").Contains(tekst, StringComparison.OrdinalIgnoreCase));

        _licencePrikazane = [.. izvor];
    }

    private void AzurirajKorisnike()
    {
        var tekst = _korisnikPretraga.Trim();

        IEnumerable<WebKorisnik> izvor = _sviKorisnici;

        // Filter po tekstu i filter po izabranoj licenci rade ZAJEDNO (AND).
        if (_izabranaLicencaId is not null)
            izvor = izvor.Where(k => k.IdLicence == _izabranaLicencaId);

        if (!string.IsNullOrEmpty(tekst))
            izvor = izvor.Where(k =>
                (k.Ime   ?? "").Contains(tekst, StringComparison.OrdinalIgnoreCase) ||
                (k.Email ?? "").Contains(tekst, StringComparison.OrdinalIgnoreCase));

        _korisniciPrikazani = [.. izvor];
    }

    private void OnLicencaRowClick(TableRowClickEventArgs<Licenca> e)
    {
        if (_izabranaLicencaId == e.Item.IdLicence)
        {
            // Ponovni klik na isti red — poništi izbor.
            PonistiIzborLicence();
        }
        else
        {
            _izabranaLicencaId    = e.Item.IdLicence;
            _izabranaLicencaNaziv = e.Item.Naziv;
            AzurirajKorisnike();
        }
    }

    private void PonistiIzborLicence()
    {
        _izabranaLicencaId    = null;
        _izabranaLicencaNaziv = null;
        AzurirajKorisnike();
    }

    private void UdjiUFirmu(int idLicence) =>
        Nav.NavigateTo($"/api/superadmin/udji?id={idLicence}", forceLoad: true);

    private async Task IzmeniLicencu(Licenca licenca)
    {
        var opts = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var prms = new DialogParameters<LicencaDialog> { { x => x.IdLicence, licenca.IdLicence } };
        var dialog = await Dialog.ShowAsync<LicencaDialog>($"Licenca — {licenca.Naziv}", prms, opts);

        if (!(await dialog.Result).Canceled)
            await UcitajLicence();
    }
}
