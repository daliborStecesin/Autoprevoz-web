@page "/finansije/duznici-novi"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using Transport.Domain.Entities
@using Transport.Infrastructure.Data

@inject ITenantService    TenantService
@inject NavigationManager Nav
@inject TransportDbContext Db
@inject IJSRuntime        JS

<PageTitle>Dužnici i dugovanja (novi) — Autoprevoz</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3">
    <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Class="mr-2" />
    Dužnici i dugovanja
</MudText>

<MudPaper Elevation="1" Class="pa-3 mb-3">
    <MudTextField Value="_pretragaNaziv"
                   ValueChanged="@((string v) => { _pretragaNaziv = v; Filtriraj(); })"
                   Label="Naziv partnera" Variant="Variant.Outlined"
                   Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                   Immediate="true" Margin="Margin.Dense"
                   T="string" />
</MudPaper>

@if (_ucitava)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="false">

        @* ── TAB 1: DUŽNICI (kupci) ─────────────────────── *@
        <MudTabPanel Text="Dužnici (kupci)" Icon="@Icons.Material.Filled.TrendingUp">
            <MudGrid Spacing="2" Class="mt-2">

                @* ── DOM (RSD) ── *@
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">
                        Dugovanja:
                        <strong>@SumaKupciRsd.ToString("N2") RSD</strong>
                        &nbsp;|&nbsp; Van valute:
                        <strong>@_duzniciDomVV.ToString("N2") RSD</strong>
                    </MudText>
                    <div class="d-flex gap-2 mb-1">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Receipt"
                                   Disabled="@(_selDuzniciDom is null)"
                                   OnClick="@(() => OtvoriKarticu(_selDuzniciDom!, "KUPAC", "RSD"))">
                            Prikaži karticu
                        </MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.Print"
                                   OnClick="@(() => Stampaj("duznici_dom"))">
                            Štampa
                        </MudButton>
                    </div>
                    <MudDataGrid T="PartnerSaldo" Items="_duzniciDom" Dense="true" Hover="true" Striped="true"
                                 RowStyleFunc="@((item, _) => RedStil(item, _selDuzniciDom))"
                                 RowClick="@((DataGridRowClickEventArgs<PartnerSaldo> e) => { _selDuzniciDom = e.Item; })">
                        <Columns>
                            <PropertyColumn Property="x => x.Naziv" Title="Naziv partnera" />
                            <TemplateColumn Title="Preostalo" HeaderStyle="text-align:right;">
                                <CellTemplate>
                                    <span style="display:block; text-align:right; @(context.Item.Saldo < 0 ? "color:#B71C1C;" : "")">
                                        @context.Item.Saldo.ToString("N2")
                                    </span>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Van valute" HeaderStyle="text-align:right;">
                                <CellTemplate>
                                    <span style="display:block; text-align:right; @(context.Item.VanValute > 0 ? "color:#E65100;" : "")">
                                        @context.Item.VanValute.ToString("N2")
                                    </span>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <PagerContent><MudDataGridPager T="PartnerSaldo" /></PagerContent>
                    </MudDataGrid>
                </MudItem>

                @* ── INO (EUR) ── *@
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">
                        Dugovanja INO:
                        <strong>@SumaKupciEur.ToString("N2") EUR</strong>
                        &nbsp;|&nbsp; Van valute:
                        <strong>@_duzniciInoVV.ToString("N2") EUR</strong>
                    </MudText>
                    <div class="d-flex gap-2 mb-1">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Receipt"
                                   Disabled="@(_selDuzniciIno is null)"
                                   OnClick="@(() => OtvoriKarticu(_selDuzniciIno!, "KUPAC", "EUR"))">
                            Prikaži karticu
                        </MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.Print"
                                   OnClick="@(() => Stampaj("duznici_ino"))">
                            Štampa
                        </MudButton>
                    </div>
                    <MudDataGrid T="PartnerSaldo" Items="_duzniciIno" Dense="true" Hover="true" Striped="true"
                                 RowStyleFunc="@((item, _) => RedStil(item, _selDuzniciIno))"
                                 RowClick="@((DataGridRowClickEventArgs<PartnerSaldo> e) => { _selDuzniciIno = e.Item; })">
                        <Columns>
                            <PropertyColumn Property="x => x.Naziv" Title="Naziv partnera" />
                            <TemplateColumn Title="Preostalo" HeaderStyle="text-align:right;">
                                <CellTemplate>
                                    <span style="display:block; text-align:right; @(context.Item.Saldo < 0 ? "color:#B71C1C;" : "")">
                                        @context.Item.Saldo.ToString("N2")
                                    </span>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Van valute" HeaderStyle="text-align:right;">
                                <CellTemplate>
                                    <span style="display:block; text-align:right; @(context.Item.VanValute > 0 ? "color:#E65100;" : "")">
                                        @context.Item.VanValute.ToString("N2")
                                    </span>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <PagerContent><MudDataGridPager T="PartnerSaldo" /></PagerContent>
                    </MudDataGrid>
                </MudItem>

            </MudGrid>
        </MudTabPanel>

        @* ── TAB 2: DUGOVANJA (dobavljači) ──────────────── *@
        <MudTabPanel Text="Dugovanja (dobavljači)" Icon="@Icons.Material.Filled.TrendingDown">
            <MudGrid Spacing="2" Class="mt-2">

                @* ── DOM (RSD) ── *@
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">
                        Obaveze:
                        <strong>@SumaDobavljacRsd.ToString("N2") RSD</strong>
                        &nbsp;|&nbsp; Van valute:
                        <strong>@_dugovanjaDomVV.ToString("N2") RSD</strong>
                    </MudText>
                    <div class="d-flex gap-2 mb-1">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Receipt"
                                   Disabled="@(_selDugovanjaDom is null)"
                                   OnClick="@(() => OtvoriKarticu(_selDugovanjaDom!, "DOBAVLJAC", "RSD"))">
                            Prikaži karticu
                        </MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.Print"
                                   OnClick="@(() => Stampaj("dugovanja_dom"))">
                            Štampa
                        </MudButton>
                    </div>
                    <MudDataGrid T="PartnerSaldo" Items="_dugovanjaDom" Dense="true" Hover="true" Striped="true"
                                 RowStyleFunc="@((item, _) => RedStil(item, _selDugovanjaDom))"
                                 RowClick="@((DataGridRowClickEventArgs<PartnerSaldo> e) => { _selDugovanjaDom = e.Item; })">
                        <Columns>
                            <PropertyColumn Property="x => x.Naziv" Title="Naziv partnera" />
                            <TemplateColumn Title="Preostalo" HeaderStyle="text-align:right;">
                                <CellTemplate>
                                    <span style="display:block; text-align:right;">
                                        @context.Item.Saldo.ToString("N2")
                                    </span>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Van valute" HeaderStyle="text-align:right;">
                                <CellTemplate>
                                    <span style="display:block; text-align:right; @(context.Item.VanValute > 0 ? "color:#E65100;" : "")">
                                        @context.Item.VanValute.ToString("N2")
                                    </span>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <PagerContent><MudDataGridPager T="PartnerSaldo" /></PagerContent>
                    </MudDataGrid>
                </MudItem>

                @* ── INO (EUR) ── *@
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">
                        Obaveze INO:
                        <strong>@SumaDobavljacEur.ToString("N2") EUR</strong>
                        &nbsp;|&nbsp; Van valute:
                        <strong>@_dugovanjaInoVV.ToString("N2") EUR</strong>
                    </MudText>
                    <div class="d-flex gap-2 mb-1">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Receipt"
                                   Disabled="@(_selDugovanjaIno is null)"
                                   OnClick="@(() => OtvoriKarticu(_selDugovanjaIno!, "DOBAVLJAC", "EUR"))">
                            Prikaži karticu
                        </MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.Print"
                                   OnClick="@(() => Stampaj("dugovanja_ino"))">
                            Štampa
                        </MudButton>
                    </div>
                    <MudDataGrid T="PartnerSaldo" Items="_dugovanjaIno" Dense="true" Hover="true" Striped="true"
                                 RowStyleFunc="@((item, _) => RedStil(item, _selDugovanjaIno))"
                                 RowClick="@((DataGridRowClickEventArgs<PartnerSaldo> e) => { _selDugovanjaIno = e.Item; })">
                        <Columns>
                            <PropertyColumn Property="x => x.Naziv" Title="Naziv partnera" />
                            <TemplateColumn Title="Preostalo" HeaderStyle="text-align:right;">
                                <CellTemplate>
                                    <span style="display:block; text-align:right;">
                                        @context.Item.Saldo.ToString("N2")
                                    </span>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Van valute" HeaderStyle="text-align:right;">
                                <CellTemplate>
                                    <span style="display:block; text-align:right; @(context.Item.VanValute > 0 ? "color:#E65100;" : "")">
                                        @context.Item.VanValute.ToString("N2")
                                    </span>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <PagerContent><MudDataGridPager T="PartnerSaldo" /></PagerContent>
                    </MudDataGrid>
                </MudItem>

            </MudGrid>
        </MudTabPanel>

    </MudTabs>
}

@code {
    private class PartnerSaldo
    {
        public string  Kljuc      { get; set; } = "";
        public int?    IdPartnera { get; set; }
        public string  Naziv      { get; set; } = "";
        public decimal Saldo      { get; set; }   // SUM(k.Saldo) per group — neto saldo partnera
        public decimal VanValute  { get; set; }   // SUM(k.Preostalo) dospelih otvorenih zaduženja
    }

    // tipDokumenta koji otvaraju obavezu (zaduženja) — jedino ovi ulaze u van-valute logiku
    private static readonly string[] ZaduzenjaTip = ["RACUN", "KNJIZNO_ZADUZENJE", "POCETNO"];

    private List<KarticaNova> _sve = [];

    private List<PartnerSaldo> _duzniciDomSve   = [];
    private List<PartnerSaldo> _duzniciInoSve   = [];
    private List<PartnerSaldo> _dugovanjaDomSve = [];
    private List<PartnerSaldo> _dugovanjaInoSve = [];

    private List<PartnerSaldo> _duzniciDom   = [];
    private List<PartnerSaldo> _duzniciIno   = [];
    private List<PartnerSaldo> _dugovanjaDom = [];
    private List<PartnerSaldo> _dugovanjaIno = [];

    // Van-valute sume po podgrupi (ne ukupno — ukupno se računaju u Filtriraj)
    private decimal _duzniciDomVV, _duzniciInoVV;
    private decimal _dugovanjaDomVV, _dugovanjaInoVV;

    // Sume preostalog (samo pravi dužnici / obaveze, bez pretplaćenih)
    private decimal SumaKupciRsd     => _duzniciDom.Where(p => p.Saldo > 0).Sum(p => p.Saldo);
    private decimal SumaKupciEur     => _duzniciIno.Where(p => p.Saldo > 0).Sum(p => p.Saldo);
    private decimal SumaDobavljacRsd => _dugovanjaDom.Where(p => p.Saldo < 0).Sum(p => p.Saldo);
    private decimal SumaDobavljacEur => _dugovanjaIno.Where(p => p.Saldo < 0).Sum(p => p.Saldo);

    private string _pretragaNaziv = "";
    private bool   _ucitava;

    private PartnerSaldo? _selDuzniciDom;
    private PartnerSaldo? _selDuzniciIno;
    private PartnerSaldo? _selDugovanjaDom;
    private PartnerSaldo? _selDugovanjaIno;

    // Ključ grupisanja: PIB ako postoji, inače "ID:{IdPartnera}"
    private static string GrupniKljuc(KarticaNova k) =>
        !string.IsNullOrWhiteSpace(k.PIB) ? k.PIB! : $"ID:{k.IdPartnera}";

    protected override async Task OnInitializedAsync()
    {
        if (!TenantService.IsAuthenticated()) { Nav.NavigateTo("/login"); return; }
        await Ucitaj();
    }

    private async Task Ucitaj()
    {
        _ucitava = true; StateHasChanged();
        try
        {
            _sve = await Db.KarticeNova.AsNoTracking().ToListAsync();

            _duzniciDomSve   = GrupisiSaldo(_sve, "KUPAC",     "RSD").OrderByDescending(p => p.Saldo).ToList();
            _duzniciInoSve   = GrupisiSaldo(_sve, "KUPAC",     "EUR").OrderByDescending(p => p.Saldo).ToList();
            _dugovanjaDomSve = GrupisiSaldo(_sve, "DOBAVLJAC", "RSD").OrderBy(p => p.Saldo).ToList();
            _dugovanjaInoSve = GrupisiSaldo(_sve, "DOBAVLJAC", "EUR").OrderBy(p => p.Saldo).ToList();

            Filtriraj();
        }
        finally
        {
            _ucitava = false;
            StateHasChanged();
        }
    }

    private List<PartnerSaldo> GrupisiSaldo(List<KarticaNova> redovi, string uloga, string valuta)
    {
        var danas = DateTime.Today;

        return redovi
            .Where(k => k.PartnerUloga == uloga && k.Valuta == valuta)
            .GroupBy(GrupniKljuc)
            .Select(g =>
            {
                var poslednjiRed = g.OrderByDescending(x => x.Id).First();
                return new PartnerSaldo
                {
                    Kljuc      = g.Key,
                    IdPartnera = g.FirstOrDefault(x => x.IdPartnera.HasValue)?.IdPartnera,
                    Naziv      = poslednjiRed.NazivPartnera ?? "",
                    Saldo      = g.Sum(x => x.Saldo),
                    VanValute  = g.Where(x => ZaduzenjaTip.Contains(x.TipDokumenta)
                                           && x.DatumValute.HasValue
                                           && x.DatumValute.Value.Date < danas
                                           && x.Preostalo > 0)
                                  .Sum(x => x.Preostalo)
                };
            })
            .Where(p => p.Saldo != 0)
            .ToList();
    }

    private void Filtriraj()
    {
        if (string.IsNullOrWhiteSpace(_pretragaNaziv))
        {
            _duzniciDom   = _duzniciDomSve;
            _duzniciIno   = _duzniciInoSve;
            _dugovanjaDom = _dugovanjaDomSve;
            _dugovanjaIno = _dugovanjaInoSve;
        }
        else
        {
            _duzniciDom   = _duzniciDomSve  .Where(p => p.Naziv.Contains(_pretragaNaziv, StringComparison.OrdinalIgnoreCase)).ToList();
            _duzniciIno   = _duzniciInoSve  .Where(p => p.Naziv.Contains(_pretragaNaziv, StringComparison.OrdinalIgnoreCase)).ToList();
            _dugovanjaDom = _dugovanjaDomSve.Where(p => p.Naziv.Contains(_pretragaNaziv, StringComparison.OrdinalIgnoreCase)).ToList();
            _dugovanjaIno = _dugovanjaInoSve.Where(p => p.Naziv.Contains(_pretragaNaziv, StringComparison.OrdinalIgnoreCase)).ToList();
        }

        _duzniciDomVV   = _duzniciDom  .Sum(p => p.VanValute);
        _duzniciInoVV   = _duzniciIno  .Sum(p => p.VanValute);
        _dugovanjaDomVV = _dugovanjaDom.Sum(p => p.VanValute);
        _dugovanjaInoVV = _dugovanjaIno.Sum(p => p.VanValute);
    }

    private static string RedStil(PartnerSaldo p, PartnerSaldo? selektovan) =>
        selektovan is not null && selektovan.Kljuc == p.Kljuc ? "background-color:#BBDEFB;" : "";

    private void OtvoriKarticu(PartnerSaldo p, string uloga, string valuta)
    {
        var url = p.IdPartnera.HasValue
            ? $"/finansije/kartica-nova?idPartnera={p.IdPartnera}&uloga={uloga}&valuta={valuta}"
            : $"/finansije/kartica-nova?kljuc={Uri.EscapeDataString(p.Kljuc)}&uloga={uloga}&valuta={valuta}";
        Nav.NavigateTo(url);
    }

    private async Task Stampaj(string tip)
    {
        var url = $"/finansije/duznici-novi/stampa?tip={tip}";
        if (!string.IsNullOrWhiteSpace(_pretragaNaziv))
            url += $"&pretraga={Uri.EscapeDataString(_pretragaNaziv)}";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }
}
