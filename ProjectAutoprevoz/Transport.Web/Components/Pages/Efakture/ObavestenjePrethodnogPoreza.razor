@page "/efakture/obavestenje-prethodnog-poreza"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using Transport.Domain.Entities
@using Transport.Application.Interfaces
@using Transport.Application.Services.Sef

@inject ITenantService         TenantService
@inject NavigationManager      Nav
@inject IObavestenjaPPService  ObavestenjaPPService
@inject IDefaultValuesService  DefaultValues
@inject ISnackbar              Snackbar
@inject IJSRuntime             JS

<PageTitle>Obaveštenje o prethodnom porezu — Autoprevoz</PageTitle>

<ZahtevaModul Kod="EFAKTURA">

<div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-3">
    <MudText Typo="Typo.h5" Style="color:#2D3E50;">
        <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Class="mr-2" />
        Obaveštenje o prethodnom porezu
    </MudText>

    <div class="d-flex align-center flex-wrap gap-2">
        @* ── Toggle Primljena / Poslata ──────────────────────────────── *@
        <MudToggleGroup T="string" Value="_tipSender" ValueChanged="PromeniTip"
                         Exclusive="true" Color="Color.Primary" Size="Size.Small"
                         Disabled="@(_ucitava || _uvozi)" Class="mr-2">
            <MudToggleItem T="string" Value="@("PRIMLJENA")" Text="Primljena" />
            <MudToggleItem T="string" Value="@("POSLATA")" Text="Poslata" />
        </MudToggleGroup>

        @if (_tipSender == "POSLATA")
        {
            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Add" OnClick="KreirajObavestenje">
                Kreiraj obaveštenje
            </MudButton>
        }

        @* ── Sekundarne akcije — ikonice (PDF trenutno ne radi zbog SEF-a,
           dugmad ostaju i rade nad selektovanim redom) ─────────────────── *@
        <MudTooltip Text="Pregled - otvori PDF u novom tabu" ShowOnHover="true" Placement="Placement.Top">
            <span>
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                               Disabled="@(_selektovan is null)" OnClick="Pregled" />
            </span>
        </MudTooltip>
        <MudTooltip Text="Preuzmi PDF" ShowOnHover="true" Placement="Placement.Top">
            <span>
                <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small"
                               Disabled="@(_selektovan is null)" OnClick="PreuzmiPdf" />
            </span>
        </MudTooltip>

        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="IzlazIzModula">
            Izlaz
        </MudButton>
    </div>
</div>

<MudGrid Spacing="3">

    @* ── LEVA STRANA — Učitaj za period + Filteri (ručni accordion, isti
       obrazac kao IzlazneEFakture.razor) ── *@
    <MudItem xs="12" md="3">
        <MudPaper Elevation="1" Class="pa-2">

            @* Panel: Učitaj za period *@
            <div style="border:1px solid rgba(0,0,0,0.12); border-radius:4px;">
                <div @onclick="OnUcitajPanelToggle"
                     style="display:flex; align-items:center; justify-content:space-between;
                            padding:8px 12px; cursor:pointer; user-select:none;
                            background:#fafafa; border-radius:4px;">
                    <div style="display:flex; align-items:center; gap:8px; font-size:0.85rem; font-weight:600; color:#2D3E50;">
                        <MudIcon Icon="@Icons.Material.Filled.CloudDownload" Size="Size.Small" />
                        Učitaj za period
                    </div>
                    <MudIcon Icon="@(_ucitajSekcijaOtvorena ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                             Size="Size.Small" Style="color:#888;" />
                </div>
                @if (_ucitajSekcijaOtvorena)
                {
                    <div style="padding:8px 12px 10px;">
                        <div class="mb-2"><DateInput Label="Datum OD" @bind-Value="_importOd" /></div>
                        <div class="mb-3"><DateInput Label="Datum DO" @bind-Value="_importDo" /></div>

                        <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.CloudDownload"
                                   OnClick="UcitajZaPeriod"
                                   Disabled="_uvozi"
                                   FullWidth="true">
                            @if (_uvozi)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                            }
                            Učitaj za period
                        </MudButton>
                    </div>
                }
            </div>

            @* Panel: Filteri *@
            <div style="border:1px solid rgba(0,0,0,0.12); border-radius:4px; margin-top:10px;">
                <div @onclick="OnFilteriPanelToggle"
                     style="display:flex; align-items:center; justify-content:space-between;
                            padding:8px 12px; cursor:pointer; user-select:none;
                            background:#fafafa; border-radius:4px;">
                    <div style="display:flex; align-items:center; gap:8px; font-size:0.85rem; font-weight:600; color:#2D3E50;">
                        <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="Size.Small" />
                        Filteri
                    </div>
                    <MudIcon Icon="@(_filteriOtvoreni ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                             Size="Size.Small" Style="color:#888;" />
                </div>
                @if (_filteriOtvoreni)
                {
                    <div style="padding:8px 12px 10px;">
                        <div class="mb-2">
                            <NativniInput TValue="string" Label="@(_tipSender == "POSLATA" ? "Primalac" : "Pošiljalac")"
                                          Value="@_nazivFilter"
                                          ValueChanged="@(v => _nazivFilter = v ?? string.Empty)"
                                          OnEnter="Izlistaj" />
                        </div>

                        <div class="mb-2">
                            <NativniInput TValue="string" Label="Broj obaveštenja"
                                          Value="@_brojFilter"
                                          ValueChanged="@(v => _brojFilter = v ?? string.Empty)"
                                          OnEnter="Izlistaj" />
                        </div>

                        <div class="mb-2"><DateInput Label="Datum dokumenta OD" @bind-Value="_datumOd" /></div>
                        <div class="mb-3"><DateInput Label="Datum dokumenta DO" @bind-Value="_datumDo" /></div>

                        <div class="d-flex flex-column gap-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Search"
                                       OnClick="Izlistaj"
                                       Disabled="_ucitava"
                                       FullWidth="true">
                                Izlistaj
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.List"
                                       OnClick="IzlistajSve"
                                       Disabled="_ucitava"
                                       FullWidth="true">
                                Izlistaj sve
                            </MudButton>
                        </div>
                    </div>
                }
            </div>

        </MudPaper>
    </MudItem>

    @* ── DESNA STRANA — Grid ────────────────────────────────────────── *@
    <MudItem xs="12" md="9">

        @if (_ucitava)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <MudDataGrid T="ObavestenjePP" Items="_lista" Dense="true" Hover="true"
                         FixedHeader="true" Height="calc(100vh - 340px)"
                         RowClick="NaKlikReda"
                         RowStyleFunc="@BojaReda"
                         Class="obavestenja-grid">
                <Columns>
                    <PropertyColumn Property="x => x.noticeNumber" Title="Broj obaveštenja" HeaderStyle="width:12%;" />
                    <PropertyColumn Property="x => x.documentNumber" Title="Broj dokumenta" HeaderStyle="width:12%;" />
                    <TemplateColumn Title="Datum obaveštenja" SortBy="x => x.NoticeDate" HeaderStyle="width:10%;">
                        <CellTemplate Context="red">
                            <span style="white-space:nowrap;">@red.Item.NoticeDate?.ToString("dd.MM.yyyy")</span>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.Sender" Title="@NazivHeader" HeaderStyle="width:30%;" />
                    <PropertyColumn Property="x => x.recipientPIB" Title="@PibHeader" HeaderStyle="width:12%;" />
                    <TemplateColumn Title="Iznos PDV" SortBy="x => x.totalVatAmount" HeaderStyle="width:18%; text-align:right;">
                        <CellTemplate Context="red">
                            <span style="display:block; text-align:right; font-weight:600; padding-right:6px;">@red.Item.totalVatAmount?.ToString("N2")</span>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Status" SortBy="x => x.statust" HeaderStyle="width:6%; max-width:70px;"
                                    Hidden="@(_tipSender != "POSLATA")">
                        <CellTemplate Context="red">
                            <MudChip T="string" Size="Size.Small" Color="@BojaStatusa(red.Item.statust)"
                                     Style="font-weight:600;">
                                @red.Item.statust
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="ObavestenjePP" PageSizeOptions="@(new int[]{20,50,100,200})"
                                      RowsPerPageString="Redova po strani:" />
                </PagerContent>
            </MudDataGrid>

            @if (_lista.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                    Nema obaveštenja za izabrane filtere.
                </MudAlert>
            }
        }

    </MudItem>
</MudGrid>

</ZahtevaModul>

@code {
    private string _tipSender = "PRIMLJENA"; // PRIMLJENA / POSLATA

    private string _nazivFilter = "";
    private string _brojFilter  = "";
    private string _datumOd     = "";
    private string _datumDo     = "";

    private string _importOd = DateTime.Today.AddMonths(-1).ToString("yyyy-MM-dd");
    private string _importDo = DateTime.Today.ToString("yyyy-MM-dd");

    private List<ObavestenjePP> _lista = [];
    private ObavestenjePP?      _selektovan;

    private bool _ucitava;
    private bool _uvozi;
    private bool _filteriOtvoreni       = true;
    private bool _ucitajSekcijaOtvorena = true;

    private string NazivHeader => _tipSender == "POSLATA" ? "Naziv primaoca" : "Naziv pošiljaoca";
    private string PibHeader   => _tipSender == "POSLATA" ? "PIB primaoca"   : "PIB pošiljaoca";

    protected override async Task OnInitializedAsync()
    {
        if (!TenantService.IsAuthenticated()) { Nav.NavigateTo("/login"); return; }

        var uid = TenantService.GetIdKorisnika();
        var pUcitaj  = await DefaultValues.GetDefault("ObavestenjaPP", "panel_ucitaj",  uid);
        var pFilteri = await DefaultValues.GetDefault("ObavestenjaPP", "panel_filteri", uid);
        if (pUcitaj  is not null) _ucitajSekcijaOtvorena = pUcitaj  == "True";
        if (pFilteri is not null) _filteriOtvoreni       = pFilteri == "True";

        await Ucitaj(primeniFiltere: false);
    }

    private async Task OnUcitajPanelToggle()
    {
        _ucitajSekcijaOtvorena = !_ucitajSekcijaOtvorena;
        await DefaultValues.SaveDefault("ObavestenjaPP", "panel_ucitaj", _ucitajSekcijaOtvorena.ToString(), TenantService.GetIdKorisnika());
    }

    private async Task OnFilteriPanelToggle()
    {
        _filteriOtvoreni = !_filteriOtvoreni;
        await DefaultValues.SaveDefault("ObavestenjaPP", "panel_filteri", _filteriOtvoreni.ToString(), TenantService.GetIdKorisnika());
    }

    private async Task PromeniTip(string tip)
    {
        if (_tipSender == tip) return;
        _tipSender    = tip;
        _nazivFilter  = "";
        _brojFilter   = "";
        _datumOd      = "";
        _datumDo      = "";
        await Ucitaj(primeniFiltere: false);
    }

    private Task Izlistaj()    => Ucitaj(primeniFiltere: true);

    private Task IzlistajSve()
    {
        _nazivFilter = "";
        _brojFilter  = "";
        _datumOd     = "";
        _datumDo     = "";
        return Ucitaj(primeniFiltere: false);
    }

    private async Task Ucitaj(bool primeniFiltere)
    {
        _ucitava = true; _selektovan = null; StateHasChanged();
        try
        {
            string? naziv = null, broj = null;
            DateTime? od = null, doDatum = null;

            if (primeniFiltere)
            {
                naziv   = string.IsNullOrWhiteSpace(_nazivFilter) ? null : _nazivFilter;
                broj    = string.IsNullOrWhiteSpace(_brojFilter)  ? null : _brojFilter;
                od      = DateTime.TryParse(_datumOd, out var odD) ? odD : null;
                doDatum = DateTime.TryParse(_datumDo, out var doD) ? doD : null;
            }

            _lista = await ObavestenjaPPService.GetListaAsync(_tipSender, naziv, broj, od, doDatum);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
        }
        finally
        {
            _ucitava = false;
            StateHasChanged();
        }
    }

    private void NaKlikReda(DataGridRowClickEventArgs<ObavestenjePP> args)
    {
        _selektovan = args.Item;
    }

    private async Task UcitajZaPeriod()
    {
        if (!DateTime.TryParse(_importOd, out var od) || !DateTime.TryParse(_importDo, out var doDatum))
        {
            Snackbar.Add("Unesite ispravan period.", Severity.Warning);
            return;
        }

        _uvozi = true; StateHasChanged();
        try
        {
            var broj = _tipSender == "POSLATA"
                ? await ObavestenjaPPService.ImportPoslataAsync(od, doDatum)
                : await ObavestenjaPPService.ImportPrimljenaAsync(od, doDatum);

            Snackbar.Add($"Uvezeno novih obaveštenja: {broj}", Severity.Success);
            await Ucitaj(primeniFiltere: false);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri uvozu: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
        }
        finally
        {
            _uvozi = false;
            StateHasChanged();
        }
    }

    private async Task<string?> UcitajPdfBase64(ObavestenjePP stavka)
    {
        if (stavka.noticeId is null)
        {
            Snackbar.Add("Nema ID obaveštenja za preuzimanje PDF-a.", Severity.Warning);
            return null;
        }

        try
        {
            var isSender = _tipSender == "POSLATA";
            var bytes    = await ObavestenjaPPService.PreuzmiPdfAsync(stavka.noticeId.Value, isSender);
            return Convert.ToBase64String(bytes);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri preuzimanju PDF-a: {ex.Message}", Severity.Error);
            return null;
        }
    }

    private async Task Pregled()
    {
        if (_selektovan is null) return;

        var b64 = await UcitajPdfBase64(_selektovan);
        if (b64 is not null)
            await JS.InvokeVoidAsync("openPdfPreview", b64);
    }

    private async Task PreuzmiPdf()
    {
        if (_selektovan is null) return;

        var b64 = await UcitajPdfBase64(_selektovan);
        if (b64 is not null)
            await JS.InvokeVoidAsync("downloadFilePdf", $"Obavestenje_{_selektovan.noticeNumber}.pdf", b64);
    }

    // Boja statusnog čipa (samo POSLATA): Prihvaćeno=zeleno, Odbijeno/Greška=crveno,
    // sve ostalo (Nacrt/Poslato/Poništeno/Primljeno)=žuto.
    private static Color BojaStatusa(string? status) => status switch
    {
        "Prihvaćeno"            => Color.Success,
        "Odbijeno" or "Greška"  => Color.Error,
        _                       => Color.Warning
    };

    // Vizuelno isticanje selektovanog reda (isti stil kao Ulazne/Izlazne).
    private string BojaReda(ObavestenjePP item, int _) =>
        _selektovan is not null && _selektovan.ObavestenjeID == item.ObavestenjeID
            ? "background-color:rgba(61,142,185,0.18); border-left:4px solid #3D8EB9;"
            : string.Empty;

    private void KreirajObavestenje() => Nav.NavigateTo("/efakture/obavestenje-prethodnog-poreza/unos");

    private void IzlazIzModula() => Nav.NavigateTo("/dashboard");
}
