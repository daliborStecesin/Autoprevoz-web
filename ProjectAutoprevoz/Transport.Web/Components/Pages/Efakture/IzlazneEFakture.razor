    private async Task Brisanje()
    {
        if (_selektovan is null) return;

        var potvrda = await Dialog.ShowMessageBox(
            "Brisanje izlaznog računa",
            "BRISANJEM IZLAZNOG RAČUNA, NE UKLANJATE GA SA SISTEMA E-FAKTURA, NEGO SAMO IZ LISTE U PROGRAMU. " +
            "PRI SLEDEĆEM UČITAVANJU LISTE, BRISANI RAČUN ĆE PONOVO BITI UPISAN. DA LI ŽELITE DA NASTAVITE SA BRISANJEM?",
            yesText: "Da, obriši", cancelText: "Odustani");

        if (potvrda != true) return;

        try
        {
            Db.EInvoices.Remove(_selektovan);
            await Db.SaveChangesAsync();

            _lista.Remove(_selektovan);
            _selektovan = null;
            StateHasChanged();

            Snackbar.Add("Red je obrisan iz liste.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri brisanju: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
        }
    }

    // ── Integracija sa karticom — SAMO za fakture koje NISU kreirane kroz naš
    // sistem fakturisanja (idRacuna==null). Regularne fakture (idRacuna postavljen)
    // već idu kroz KarticaNovaService.UpisiIzRacuna — dugmad se za njih ne prikazuju.
    private bool PrikaziUpisiUKarticu => _selektovan is null || _selektovan.idRacuna is null;

    private bool MozeUpisatiUKarticu =>
        _selektovan is not null
        && _selektovan.idRacuna is null
        && _selektovan.statusDokumenta is not ("Priprema" or "Slanje" or "Otkazano" or "Stornirano" or "Odbijeno");

    private async Task UpisiUKarticu()
    {
        if (_selektovan is null) return;

        if (string.IsNullOrWhiteSpace(_selektovan.pib))
        {
            Snackbar.Add("Dokument nema PIB partnera — ne može se upisati u karticu.", Severity.Warning);
            return;
        }

        var partner = await Db.Partneri.AsNoTracking().FirstOrDefaultAsync(p => p.PIB == _selektovan.pib);
        if (partner is null)
        {
            Snackbar.Add(
                $"Partner sa PIB {_selektovan.pib} ne postoji u imeniku. Molimo evidentirajte partnera pre upisa u karticu.",
                Severity.Warning);
            return;
        }

        // Scoped i po PartnerUloga — idEfakture kolona je deljena između tbl_eFakturaUlaz
        // (DOBAVLJAC) i tbl_eInvoice (KUPAC), koje su odvojene tabele sa sopstvenim
        // auto-increment ID prostorom, pa se vrednosti mogu poklopiti bez veze.
        var vecUpisano = await Db.KarticeNova.AnyAsync(
            k => k.IdEfakture == _selektovan.idEfakture && k.PartnerUloga == "KUPAC");
        if (vecUpisano)
        {
            Snackbar.Add("Ova izlazna faktura je već upisana u karticu.", Severity.Info);
            return;
        }

        // SEF izlazne fakture su uvek domaći kupci.
        var domacaValuta = (await Db.Podesavanja.AsNoTracking()
            .Select(p => p.OpcijaString13)
            .FirstOrDefaultAsync()) ?? "RSD";

        try
        {
            var stavka = new KarticaNova
            {
                IdPartnera     = partner.Broj,
                PIB            = partner.PIB,
                NazivPartnera  = partner.Naziv,
                PartnerUloga   = "KUPAC",
                TipDokumenta   = "RACUN",
                BrojDokumenta  = _selektovan.brojDokumenta,
                IdRacun        = null,
                IdEfakture     = _selektovan.idEfakture,
                Valuta         = domacaValuta,
                DatumDokumenta = _selektovan.invoiceDateUtc,
                DatumPrometa   = _selektovan.accountingDateUtc,
                DatumValute    = _selektovan.paymentDateUtc
            };

            await KarticaNovaServis.DodajStavku(stavka, _selektovan.sumWithVat ?? 0);
            Snackbar.Add("Izlazna faktura je dodata u karticu!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri upisu u karticu: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
        }
    }

    private async Task UnosFinansija()
    {
        if (_selektovan is null) return;

        if (string.IsNullOrWhiteSpace(_selektovan.pib))
        {
            Snackbar.Add("Dokument nema PIB partnera — ne može se otvoriti unos finansija.", Severity.Warning);
            return;
        }

        var partner = await Db.Partneri.AsNoTracking().FirstOrDefaultAsync(p => p.PIB == _selektovan.pib);
        if (partner is null)
        {
            Snackbar.Add(
                $"Partner sa PIB {_selektovan.pib} ne postoji u imeniku. Molimo evidentirajte partnera pre upisa u karticu.",
                Severity.Warning);
            return;
        }

        var red = _selektovan;
        var url = "/finansije/unos"
            + $"?idPartnera={partner.Broj}"
            + "&smer=IZLAZ"
            + "&tip=RACUN_RSD"
            + $"&iznos={(red.sumWithVat ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture)}"
            + $"&brojDokumenta={Uri.EscapeDataString(red.brojDokumenta ?? "")}"
            + $"&datumDokumenta={red.invoiceDateUtc?.ToString("yyyy-MM-dd")}"
            + $"&datumValute={red.paymentDateUtc?.ToString("yyyy-MM-dd")}"
            + $"&datumPrometa={red.accountingDateUtc?.ToString("yyyy-MM-dd")}"
            + $"&idEfakture={red.idEfakture}";

        Nav.NavigateTo(url);
    }

    // Skraćeni prikaz tipa dokumenta u tabeli (pun naziv ostaje u tooltip-u).
    // Stara terminologija (KNJIZNO ODOBRENJE/ZADUZENJE) mapira se isto kao nova.
    private static string SkraceniTip(string? tip) => tip switch
    {
        "FAKTURA"                 => "FAKTURA",
        "AVANSNA FAKTURA"         => "AVANS",
        "DOKUMENT O SMANJENJU"    => "DOK. SMANJENJA",
        "DOKUMENT O POVECANJU"    => "DOK. POVEĆANJA",
        "KNJIZNO ODOBRENJE"       => "DOK. SMANJENJA",
        "KNJIZNO ZADUZENJE"       => "DOK. POVEĆANJA",
        _                         => tip ?? ""
    };

    // Boja statusnog čipa — deljeno sa kolonom "SEF-Status" na /fakture,
    // vidi EFakturaStatusUi.BojaStatusa (Transport.Web/Components/Shared).

    // Bojenje celog reda je uklonjeno (boju sad nosi statusni čip) — ovde ostaje
    // samo vizuelno isticanje selektovanog reda.
    private string BojaReda(EInvoice item, int _) =>
        _selektovan is not null && _selektovan.idEfakture == item.idEfakture
            ? "background-color:rgba(61,142,185,0.18); border-left:4px solid #3D8EB9;"
            : string.Empty;

