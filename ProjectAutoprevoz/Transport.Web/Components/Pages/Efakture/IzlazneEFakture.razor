    // Isto kao stari kod — očisti / i \ iz broja dokumenta pre nego što postane naziv fajla.
    private static string OcistiNazivFajla(string? brojDokumenta) =>
        (brojDokumenta ?? "dokument").Replace("/", "").Replace("\\", "");

    // Bira izvor bajtova prema izabranom tipu iz split-button menija.
    private async Task<byte[]?> UcitajPdfPoTipuAsync(string invoiceId) => _tipPdf switch
    {
        "PREUZMI PDF"     => await EFaktureService.PreuzmiProsireniPdfAsync(invoiceId),
        "PROMENE STATUSA" => await EFaktureService.PreuzmiStatusHistoryPdfAsync(invoiceId),
        _                 => await EFaktureService.PreuzmiPdfAsync(invoiceId) // "PDF SAZETAK"
    };

    private string SufiksZaTipPdf() => _tipPdf switch
    {
        "PREUZMI PDF"     => "_prosireni",
        "PROMENE STATUSA" => "_promene_statusa",
        _                 => ""
    };

    private async Task PreuzmiPdfPoTipu()
    {
        if (_selektovan?.salesInvoiceID is null) return;

        try
        {
            var bytes = await UcitajPdfPoTipuAsync(_selektovan.salesInvoiceID);
            if (bytes is null)
            {
                Snackbar.Add(
                    "PDF prikaz još uvek nije formiran, pokušajte malo kasnije, kada se status promeni u POSLATO ili PRIHVACENO",
                    Severity.Warning);
                return;
            }

            var naziv = $"Racun_{OcistiNazivFajla(_selektovan.brojDokumenta)}{SufiksZaTipPdf()}.pdf";
            var b64   = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadFilePdf", naziv, b64);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri preuzimanju PDF-a: {ex.Message}", Severity.Error);
        }
    }

    private async Task Pregled()
    {
        if (_selektovan?.salesInvoiceID is null) return;

        try
        {
            var bytes = await UcitajPdfPoTipuAsync(_selektovan.salesInvoiceID);
            if (bytes is null)
            {
                Snackbar.Add(
                    "PDF prikaz još uvek nije formiran, pokušajte malo kasnije, kada se status promeni u POSLATO ili PRIHVACENO",
                    Severity.Warning);
                return;
            }

            var b64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("openPdfPreview", b64);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri pregledu PDF-a: {ex.Message}", Severity.Error);
        }
    }

