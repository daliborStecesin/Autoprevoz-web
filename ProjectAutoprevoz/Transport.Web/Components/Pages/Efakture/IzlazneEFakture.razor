@page "/efakture/izlazne"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using Transport.Domain.Entities
@using Transport.Infrastructure.Data
@using Transport.Application.Interfaces
@using Transport.Application.Services.Sef

@inject ITenantService         TenantService
@inject NavigationManager      Nav
@inject TransportDbContext     Db
@inject IEFaktureIzlazService  EFaktureService
@inject IKarticaNovaService    KarticaNovaServis
@inject ISnackbar              Snackbar
@inject IDialogService         Dialog
@inject IJSRuntime             JS

<PageTitle>Izlazne e-fakture — Autoprevoz</PageTitle>

<div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-3">
    <MudText Typo="Typo.h5" Style="color:#2D3E50;">
        <MudIcon Icon="@Icons.Material.Filled.Upload" Class="mr-2" />
        Izlazne e-fakture
    </MudText>

    <div class="d-flex flex-wrap gap-2">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Sync"
                   Disabled="@_osvezavaSve" OnClick="OsveziSve">
            @if (_osvezavaSve)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
            }
            Osveži sve
        </MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Sync"
                   Disabled="@(_selektovan is null)" OnClick="OsveziStatus">
            Osveži status
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Undo"
                   Disabled="@(_selektovan is null)" OnClick="Storno">
            Storno
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Cancel"
                   Disabled="@(_selektovan is null)" OnClick="Otkazi">
            Otkaži
        </MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PictureAsPdf"
                   Disabled="@(_selektovan is null)" OnClick="PreuzmiPdf">
            Preuzmi PDF
        </MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Visibility"
                   Disabled="@(_selektovan is null)" OnClick="Pregled">
            Pregled
        </MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Code"
                   Disabled="@(_selektovan is null)" OnClick="PreuzmiXml">
            Preuzmi XML
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                   Disabled="@(_selektovan is null)" OnClick="Brisanje">
            Brisanje
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteSweep"
                   OnClick="Placeholder">
            Brisanje dokumenata u pripremi
        </MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AttachFile"
                   Disabled="@(_selektovan is null)" OnClick="Placeholder">
            Prikaz pratećih dokumenata
        </MudButton>
        @if (PrikaziUpisiUKarticu)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.CreditCard"
                       Disabled="@(!MozeUpisatiUKarticu)" OnClick="UpisiUKarticu">
                Upiši u karticu
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Payment"
                       Disabled="@(!MozeUpisatiUKarticu)" OnClick="UnosFinansija">
                Unos finansija
            </MudButton>
        }
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Print" OnClick="Placeholder">
            Štampa liste
        </MudButton>
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="IzlazIzModula">
            Izlaz
        </MudButton>
    </div>
</div>

<MudGrid Spacing="3">

    @* ── LEVA STRANA — Filteri ─────────────────────────────────────── *@
    <MudItem xs="12" md="3">
        <MudPaper Elevation="1" Class="pa-3">
            <MudText Typo="Typo.subtitle2" Class="mb-2">Filteri</MudText>

            <div class="mb-2">
                <NativniInput TValue="string" Label="Naziv ili PIB kupca"
                              Value="@_nazivIliPibFilter"
                              ValueChanged="@(v => _nazivIliPibFilter = v ?? string.Empty)"
                              OnEnter="Izlistaj" />
            </div>

            <div class="mb-2">
                <NativniInput TValue="string" Label="Broj dokumenta"
                              Value="@_brojDokumentaFilter"
                              ValueChanged="@(v => _brojDokumentaFilter = v ?? string.Empty)"
                              OnEnter="Izlistaj" />
            </div>

            <div class="mb-2">
                <NativniSelect Label="Tip Dokumenta" Value="@_tipDokumentaFilter"
                               ValueChanged="@(v => _tipDokumentaFilter = v ?? "SVI TIPOVI")">
                    <option value="SVI TIPOVI">SVI TIPOVI</option>
                    <option value="FAKTURA">FAKTURA</option>
                    <option value="AVANS">AVANS</option>
                    <option value="DOKUMENT O SMANJENJU">DOKUMENT O SMANJENJU</option>
                    <option value="DOKUMENT O POVECANJU">DOKUMENT O POVECANJU</option>
                </NativniSelect>
            </div>

            <div class="mb-2">
                <NativniSelect Label="Status dokumenta" Value="@_statusFilter"
                               ValueChanged="@(v => _statusFilter = v ?? "SVI STATUSI")">
                    <option value="SVI STATUSI">SVI STATUSI</option>
                    <option value="Priprema">Priprema</option>
                    <option value="Poslato">Poslato</option>
                    <option value="Prihvaceno">Prihvaceno</option>
                    <option value="Odbijeno">Odbijeno</option>
                    <option value="Stornirano">Stornirano</option>
                </NativniSelect>
            </div>

            <div class="mb-2">
                <NativniSelect Label="Tip datuma" Value="@_tipDatuma"
                               ValueChanged="@(v => _tipDatuma = v ?? "DATUM RACUNA")">
                    <option value="DATUM RACUNA">DATUM RACUNA</option>
                    <option value="DATUM PROMETA">DATUM PROMETA</option>
                </NativniSelect>
            </div>

            <div class="mb-2"><DateInput Label="Datum dokumenta OD" @bind-Value="_datumOd" /></div>
            <div class="mb-3"><DateInput Label="Datum dokumenta DO" @bind-Value="_datumDo" /></div>

            <div class="d-flex flex-column gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="Izlistaj"
                           Disabled="_ucitava"
                           FullWidth="true">
                    Izlistaj
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.List"
                           OnClick="IzlistajSve"
                           Disabled="_ucitava"
                           FullWidth="true">
                    Izlistaj sve
                </MudButton>
            </div>
        </MudPaper>

        @* ── UČITAVANJE ZA PERIOD (povlači NOVE fakture SA SEF-a, odvojeno od filtera) ── *@
        <MudPaper Elevation="1" Class="pa-3 mt-3">
            <MudText Typo="Typo.subtitle2" Class="mb-2">Učitavanje za period</MudText>

            <div class="mb-2"><DateInput Label="Datum OD" @bind-Value="_sinhOd" /></div>
            <div class="mb-3"><DateInput Label="Datum DO" @bind-Value="_sinhDo" /></div>

            <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.CloudDownload"
                       OnClick="UcitajNoveZaPeriod"
                       Disabled="_sinhronizujem"
                       FullWidth="true">
                @if (_sinhronizujem)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                }
                Učitaj nove za period
            </MudButton>
        </MudPaper>
    </MudItem>

    @* ── DESNA STRANA — Grid ────────────────────────────────────────── *@
    <MudItem xs="12" md="9">

        @if (_ucitava)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <MudDataGrid T="EInvoice" Items="_lista" Dense="true" Striped="false" Hover="true"
                         RowClick="NaKlikReda"
                         RowStyleFunc="@BojaReda">
                <Columns>
                    <PropertyColumn Property="x => x.tipDokumenta" Title="Tip dokumenta" HeaderStyle="width:13%;" />
                    <PropertyColumn Property="x => x.brojDokumenta" Title="Broj dokumenta" HeaderStyle="width:12%;" />
                    <PropertyColumn Property="x => x.partner" Title="Partner" HeaderStyle="width:20%;" />
                    <TemplateColumn Title="Datum slanja" SortBy="x => x.invoiceSentDateUtc" HeaderStyle="width:9%;">
                        <CellTemplate>@context.Item.invoiceSentDateUtc?.ToString("dd.MM.yyyy")</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Datum valute" SortBy="x => x.paymentDateUtc" HeaderStyle="width:9%;">
                        <CellTemplate>@context.Item.paymentDateUtc?.ToString("dd.MM.yyyy")</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Datum prometa" SortBy="x => x.accountingDateUtc" HeaderStyle="width:9%;">
                        <CellTemplate>@context.Item.accountingDateUtc?.ToString("dd.MM.yyyy")</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Osnovica" SortBy="x => x.sumWithoutVat" HeaderStyle="width:9%; text-align:right;">
                        <CellTemplate>
                            <span style="display:block; text-align:right;">@context.Item.sumWithoutVat?.ToString("N2")</span>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="PDV" SortBy="x => x.vatSum" HeaderStyle="width:8%; text-align:right;">
                        <CellTemplate>
                            <span style="display:block; text-align:right;">@context.Item.vatSum?.ToString("N2")</span>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Vrednost" SortBy="x => x.sumWithVat" HeaderStyle="width:9%; text-align:right;">
                        <CellTemplate>
                            <span style="display:block; text-align:right; font-weight:600;">@context.Item.sumWithVat?.ToString("N2")</span>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.statusDokumenta" Title="Status" HeaderStyle="width:8%;" />
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="EInvoice" PageSizeOptions="@(new int[]{20,50,100,200})"
                                      RowsPerPageString="Redova po strani:" />
                </PagerContent>
            </MudDataGrid>

            @if (_lista.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                    Nema izlaznih e-faktura za izabrane filtere.
                </MudAlert>
            }

            @if (_selektovan is not null && _selektovan.statusDokumenta == "Odbijeno")
            {
                <MudPaper Elevation="1" Class="pa-3 mt-3">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Komentar odbijanja</MudText>
                    <MudText Typo="Typo.body2" Style="white-space:pre-wrap;">
                        @(_liveKomentarOdbijanja
                            ?? (string.IsNullOrWhiteSpace(_selektovan.acceptRejectMessage)
                                ? _selektovan.cancelInvoiceMessage
                                : _selektovan.acceptRejectMessage))
                    </MudText>
                </MudPaper>
            }
        }

    </MudItem>
</MudGrid>

@code {
    private string _nazivIliPibFilter    = "";
    private string _brojDokumentaFilter  = "";
    private string _tipDokumentaFilter   = "SVI TIPOVI";
    private string _statusFilter         = "SVI STATUSI";
    private string _tipDatuma            = "DATUM RACUNA";
    private string _datumOd              = "";
    private string _datumDo              = "";

    private List<EInvoice> _lista = [];
    private EInvoice?      _selektovan;

    private bool _ucitava;

    // ── Učitavanje za period (SEF sinhronizacija, odvojeno od lokalnih filtera) ──
    private string _sinhOd = DateTime.Today.AddMonths(-1).ToString("yyyy-MM-dd");
    private string _sinhDo = DateTime.Today.ToString("yyyy-MM-dd");
    private bool   _sinhronizujem;

    private bool    _osvezavaSve;
    private string? _liveKomentarOdbijanja;

    // Status vrednosti koje se smatraju "u toku" — Osveži sve preskače sve ostalo
    // (Prihvaceno/Odbijeno/Otkazano/Stornirano/Placeno) jer je taj status finalan.
    private static readonly string[] StatusiUToku = ["Slanje", "Poslato", "Novi", "Priprema"];

    protected override async Task OnInitializedAsync()
    {
        if (!TenantService.IsAuthenticated()) { Nav.NavigateTo("/login"); return; }
        await Ucitaj(primeniFiltere: false);
    }

    private Task Izlistaj()    => Ucitaj(primeniFiltere: true);

    private Task IzlistajSve()
    {
        _nazivIliPibFilter   = "";
        _brojDokumentaFilter = "";
        _tipDokumentaFilter  = "SVI TIPOVI";
        _statusFilter        = "SVI STATUSI";
        _tipDatuma           = "DATUM RACUNA";
        _datumOd             = "";
        _datumDo             = "";
        return Ucitaj(primeniFiltere: false);
    }

    private async Task Ucitaj(bool primeniFiltere)
    {
        _ucitava = true; _selektovan = null; StateHasChanged();
        try
        {
            string? nazivPib = null, broj = null, tip = null, status = null;
            string  tipDatuma = "DATUM RACUNA";
            DateTime? od = null, doDatum = null;

            if (primeniFiltere)
            {
                nazivPib  = string.IsNullOrWhiteSpace(_nazivIliPibFilter)   ? null : _nazivIliPibFilter;
                broj      = string.IsNullOrWhiteSpace(_brojDokumentaFilter) ? null : _brojDokumentaFilter;
                tip       = _tipDokumentaFilter;
                status    = _statusFilter;
                tipDatuma = _tipDatuma;
                od        = DateTime.TryParse(_datumOd, out var odD) ? odD : null;
                doDatum   = DateTime.TryParse(_datumDo, out var doD) ? doD : null;
            }

            _lista = await EFaktureService.GetListaAsync(nazivPib, broj, tip, status, tipDatuma, od, doDatum);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
        }
        finally
        {
            _ucitava = false;
            StateHasChanged();
        }
    }

    private void NaKlikReda(DataGridRowClickEventArgs<EInvoice> args)
    {
        _selektovan = args.Item;
        _liveKomentarOdbijanja = null;
    }

    // ── Učitaj nove za period — povlači sa SEF-a (Faza B), zatim osvežava lokalnu listu ──
    private async Task UcitajNoveZaPeriod()
    {
        if (!DateTime.TryParse(_sinhOd, out var od) || !DateTime.TryParse(_sinhDo, out var doDatum))
        {
            Snackbar.Add("Unesite ispravan period.", Severity.Warning);
            return;
        }

        _sinhronizujem = true; StateHasChanged();
        try
        {
            var (brojNovih, upozorenjaPartner) = await EFaktureService.SinhronizujAsync(od, doDatum);

            var poruka = $"Uvezeno novih faktura: {brojNovih}.";
            if (upozorenjaPartner.Count > 0)
                poruka += " Sledeći partneri ne postoje u imeniku i preporučljivo je da ih evidentirate: "
                          + string.Join(", ", upozorenjaPartner);

            Snackbar.Add(poruka,
                upozorenjaPartner.Count > 0 ? Severity.Warning : Severity.Success,
                cfg => cfg.VisibleStateDuration = 8000);

            await Ucitaj(primeniFiltere: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri učitavanju sa SEF-a: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
        }
        finally
        {
            _sinhronizujem = false;
            StateHasChanged();
        }
    }

    // ── Osveži sve — nad svim trenutno prikazanim redovima, bez selekcije ────
    private async Task OsveziSve()
    {
        _osvezavaSve = true; StateHasChanged();
        try
        {
            foreach (var red in _lista)
            {
                if (red.invoiceID is null) continue;
                if (!StatusiUToku.Contains(red.statusDokumenta)) continue;

                try
                {
                    red.statusDokumenta = await EFaktureService.OsveziStatusAsync(red.invoiceID);
                }
                catch
                {
                    // Isti duh kao sinhronizacija — pojedinačan neuspeh ne prekida ostatak liste.
                }
            }

            Snackbar.Add("Lista je osvežena", Severity.Success);
        }
        finally
        {
            _osvezavaSve = false;
            StateHasChanged();
        }
    }

    private async Task OsveziStatus()
    {
        if (_selektovan?.invoiceID is null) return;

        try
        {
            var noviStatus = await EFaktureService.OsveziStatusAsync(_selektovan.invoiceID);
            _selektovan.statusDokumenta = noviStatus;

            if (noviStatus == "Odbijeno")
                _liveKomentarOdbijanja = await EFaktureService.UzmiKomentarOdbijanjaAsync(_selektovan.invoiceID);

            StateHasChanged();
            Snackbar.Add("Status ažuriran", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
        }
    }

    private async Task Storno()
    {
        if (_selektovan?.invoiceID is null) return;

        var opts = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var parametri = new DialogParameters<OdbijDokumentDialog>
        {
            { x => x.ValidationError,   "Da biste stornirali E-Fakturu, morate upisati komentar i zatim kliknuti na POTVRDI ZAHTEV" },
            { x => x.ConfirmButtonText, "Potvrdi zahtev" }
        };
        var dialog = await Dialog.ShowAsync<OdbijDokumentDialog>("Storno e-fakture", parametri, opts);
        var result = await dialog.Result;

        if (result is null || result.Canceled) return;
        var komentar = (string)result.Data!;

        try
        {
            var (uspesno, poruka) = await EFaktureService.StornoAsync(_selektovan.invoiceID, komentar);
            if (!uspesno)
            {
                Snackbar.Add(poruka, Severity.Error);
                return;
            }

            _selektovan.statusDokumenta = await EFaktureService.OsveziStatusAsync(_selektovan.invoiceID);
            StateHasChanged();
            Snackbar.Add("E-Faktura je uspešno Stornirana!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
        }
    }

    private async Task Otkazi()
    {
        if (_selektovan?.invoiceID is null) return;

        var opts = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var parametri = new DialogParameters<OdbijDokumentDialog>
        {
            { x => x.ValidationError,   "Da biste otkazali slanje E-Fakture, morate upisati komentar i zatim kliknuti na POTVRDI ZAHTEV" },
            { x => x.ConfirmButtonText, "Potvrdi zahtev" }
        };
        var dialog = await Dialog.ShowAsync<OdbijDokumentDialog>("Otkazivanje slanja e-fakture", parametri, opts);
        var result = await dialog.Result;

        if (result is null || result.Canceled) return;
        var komentar = (string)result.Data!;

        try
        {
            var (uspesno, poruka) = await EFaktureService.OtkaziAsync(_selektovan.invoiceID, komentar);
            if (!uspesno)
            {
                Snackbar.Add(poruka, Severity.Error);
                return;
            }

            _selektovan.statusDokumenta = await EFaktureService.OsveziStatusAsync(_selektovan.invoiceID);
            StateHasChanged();
            Snackbar.Add("Slanje E-Fakture je uspešno otkazano!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
        }
    }

    // Isto kao stari kod — očisti / i \ iz broja dokumenta pre nego što postane naziv fajla.
    private static string OcistiNazivFajla(string? brojDokumenta) =>
        (brojDokumenta ?? "dokument").Replace("/", "").Replace("\\", "");

    private async Task PreuzmiPdf()
    {
        if (_selektovan?.invoiceID is null) return;

        try
        {
            var bytes = await EFaktureService.PreuzmiPdfAsync(_selektovan.invoiceID);
            if (bytes is null)
            {
                Snackbar.Add(
                    "PDF prikaz još uvek nije formiran, pokušajte malo kasnije, kada se status promeni u POSLATO ili PRIHVACENO",
                    Severity.Warning);
                return;
            }

            var naziv = $"Racun_{OcistiNazivFajla(_selektovan.brojDokumenta)}.pdf";
            var b64   = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadFilePdf", naziv, b64);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri preuzimanju PDF-a: {ex.Message}", Severity.Error);
        }
    }

    private async Task Pregled()
    {
        if (_selektovan?.invoiceID is null) return;

        try
        {
            var bytes = await EFaktureService.PreuzmiPdfAsync(_selektovan.invoiceID);
            if (bytes is null)
            {
                Snackbar.Add(
                    "PDF prikaz još uvek nije formiran, pokušajte malo kasnije, kada se status promeni u POSLATO ili PRIHVACENO",
                    Severity.Warning);
                return;
            }

            var b64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("openPdfPreview", b64);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri pregledu PDF-a: {ex.Message}", Severity.Error);
        }
    }

    private async Task PreuzmiXml()
    {
        if (_selektovan?.invoiceID is null) return;

        try
        {
            var xml = await EFaktureService.PreuzmiXmlAsync(_selektovan.invoiceID);
            if (string.IsNullOrWhiteSpace(xml))
            {
                Snackbar.Add("XML nije dostupan za ovaj dokument", Severity.Warning);
                return;
            }

            var naziv = $"Racun_{OcistiNazivFajla(_selektovan.brojDokumenta)}.xml";
            await JS.InvokeVoidAsync("downloadTextFile", naziv, xml);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri preuzimanju XML-a: {ex.Message}", Severity.Error);
        }
    }

    private async Task Brisanje()
    {
        if (_selektovan is null) return;

        var potvrda = await Dialog.ShowMessageBox(
            "Brisanje izlaznog računa",
            "BRISANJEM IZLAZNOG RAČUNA, NE UKLANJATE GA SA SISTEMA E-FAKTURA, NEGO SAMO IZ LISTE U PROGRAMU. " +
            "PRI SLEDEĆEM UČITAVANJU LISTE, BRISANI RAČUN ĆE PONOVO BITI UPISAN. DA LI ŽELITE DA NASTAVITE SA BRISANJEM?",
            yesText: "Da, obriši", cancelText: "Odustani");

        if (potvrda != true) return;

        try
        {
            Db.EInvoices.Remove(_selektovan);
            await Db.SaveChangesAsync();

            _lista.Remove(_selektovan);
            _selektovan = null;
            StateHasChanged();

            Snackbar.Add("Red je obrisan iz liste.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri brisanju: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
        }
    }

    // ── Integracija sa karticom — SAMO za fakture koje NISU kreirane kroz naš
    // sistem fakturisanja (idRacuna==null). Regularne fakture (idRacuna postavljen)
    // već idu kroz KarticaNovaService.UpisiIzRacuna — dugmad se za njih ne prikazuju.
    private bool PrikaziUpisiUKarticu => _selektovan is null || _selektovan.idRacuna is null;

    private bool MozeUpisatiUKarticu =>
        _selektovan is not null
        && _selektovan.idRacuna is null
        && _selektovan.statusDokumenta is not ("Priprema" or "Slanje" or "Otkazano" or "Stornirano" or "Odbijeno");

    private async Task UpisiUKarticu()
    {
        if (_selektovan is null) return;

        if (string.IsNullOrWhiteSpace(_selektovan.pib))
        {
            Snackbar.Add("Dokument nema PIB partnera — ne može se upisati u karticu.", Severity.Warning);
            return;
        }

        var partner = await Db.Partneri.AsNoTracking().FirstOrDefaultAsync(p => p.PIB == _selektovan.pib);
        if (partner is null)
        {
            Snackbar.Add(
                $"Partner sa PIB {_selektovan.pib} ne postoji u imeniku. Molimo evidentirajte partnera pre upisa u karticu.",
                Severity.Warning);
            return;
        }

        // Scoped i po PartnerUloga — idEfakture kolona je deljena između tbl_eFakturaUlaz
        // (DOBAVLJAC) i tbl_eInvoice (KUPAC), koje su odvojene tabele sa sopstvenim
        // auto-increment ID prostorom, pa se vrednosti mogu poklopiti bez veze.
        var vecUpisano = await Db.KarticeNova.AnyAsync(
            k => k.IdEfakture == _selektovan.idEfakture && k.PartnerUloga == "KUPAC");
        if (vecUpisano)
        {
            Snackbar.Add("Ova izlazna faktura je već upisana u karticu.", Severity.Info);
            return;
        }

        // SEF izlazne fakture su uvek domaći kupci.
        var domacaValuta = (await Db.Podesavanja.AsNoTracking()
            .Select(p => p.OpcijaString13)
            .FirstOrDefaultAsync()) ?? "RSD";

        try
        {
            var stavka = new KarticaNova
            {
                IdPartnera     = partner.Broj,
                PIB            = partner.PIB,
                NazivPartnera  = partner.Naziv,
                PartnerUloga   = "KUPAC",
                TipDokumenta   = "RACUN",
                BrojDokumenta  = _selektovan.brojDokumenta,
                IdRacun        = null,
                IdEfakture     = _selektovan.idEfakture,
                Valuta         = domacaValuta,
                DatumDokumenta = _selektovan.invoiceDateUtc,
                DatumPrometa   = _selektovan.accountingDateUtc,
                DatumValute    = _selektovan.paymentDateUtc
            };

            await KarticaNovaServis.DodajStavku(stavka, _selektovan.sumWithVat ?? 0);
            Snackbar.Add("Izlazna faktura je dodata u karticu!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri upisu u karticu: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
        }
    }

    private async Task UnosFinansija()
    {
        if (_selektovan is null) return;

        if (string.IsNullOrWhiteSpace(_selektovan.pib))
        {
            Snackbar.Add("Dokument nema PIB partnera — ne može se otvoriti unos finansija.", Severity.Warning);
            return;
        }

        var partner = await Db.Partneri.AsNoTracking().FirstOrDefaultAsync(p => p.PIB == _selektovan.pib);
        if (partner is null)
        {
            Snackbar.Add(
                $"Partner sa PIB {_selektovan.pib} ne postoji u imeniku. Molimo evidentirajte partnera pre upisa u karticu.",
                Severity.Warning);
            return;
        }

        var red = _selektovan;
        var url = "/finansije/unos"
            + $"?idPartnera={partner.Broj}"
            + "&smer=IZLAZ"
            + "&tip=RACUN_RSD"
            + $"&iznos={(red.sumWithVat ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture)}"
            + $"&brojDokumenta={Uri.EscapeDataString(red.brojDokumenta ?? "")}"
            + $"&datumDokumenta={red.invoiceDateUtc?.ToString("yyyy-MM-dd")}"
            + $"&datumValute={red.paymentDateUtc?.ToString("yyyy-MM-dd")}"
            + $"&datumPrometa={red.accountingDateUtc?.ToString("yyyy-MM-dd")}"
            + $"&idEfakture={red.idEfakture}";

        Nav.NavigateTo(url);
    }

    // Isto kao stari kod: Odbijeno/Stornirano→crveno, Prihvaceno→zeleno, sve
    // ostalo (Priprema/Poslato/Novo)→žuto. NEMA posebne boje za Otkazano ovde
    // (za razliku od Ulaznih e-faktura).
    private string BojaReda(EInvoice item, int _)
    {
        var boja = item.statusDokumenta switch
        {
            "Odbijeno" or "Stornirano" => "#F4C7C3",
            "Prihvaceno"                => "#C5E1A5",
            _                           => "#FFF9C4"
        };

        var stil = $"background-color:{boja}; color:#000;";

        if (_selektovan is not null && _selektovan.idEfakture == item.idEfakture)
            stil += "box-shadow:inset 0 0 0 9999px rgba(61,142,185,0.22); border-left:4px solid #3D8EB9;";

        return stil;
    }

    private void Placeholder() => Snackbar.Add("Dostupno u sledećoj fazi.", Severity.Info);

    private void IzlazIzModula() => Nav.NavigateTo("/dashboard");
}
