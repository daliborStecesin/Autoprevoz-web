@page "/efakture/ulazne"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using Transport.Domain.Entities
@using Transport.Infrastructure.Data
@using Transport.Application.Interfaces
@using Transport.Application.Services.Sef
@using Transport.Application.Services.Sef.Models

@inject ITenantService         TenantService
@inject NavigationManager      Nav
@inject TransportDbContext     Db
@inject IEFaktureUlazService   EFaktureService
@inject IKarticaNovaService    KarticaNovaServis
@inject IDefaultValuesService  DefaultValues
@inject ISnackbar              Snackbar
@inject IDialogService         Dialog
@inject IJSRuntime             JS

<PageTitle>Ulazne e-fakture — Autoprevoz</PageTitle>

<ZahtevaModul Kod="EFAKTURA">

<div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-3">
    <MudText Typo="Typo.h5" Style="color:#2D3E50;">
        <MudIcon Icon="@Icons.Material.Filled.Download" Class="mr-2" />
        Ulazne e-fakture
    </MudText>

    <div class="d-flex align-center flex-wrap gap-2">
        @* ── Primarne akcije ─────────────────────────────────────────── *@
        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Sync"
                   Disabled="@(_selektovan is null)" OnClick="OsveziStatus">
            Osveži status dokumenta
        </MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check"
                   Disabled="@(!MozePrihvatitiOdbiti)" OnClick="Prihvati">
            Prihvati
        </MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" StartIcon="@Icons.Material.Filled.Close"
                   Disabled="@(!MozePrihvatitiOdbiti)" OnClick="Odbij">
            Odbij
        </MudButton>

        @* ── Sekundarne akcije — ikonice ──────────────────────────────── *@
        @* Span omotač oko dugmeta unutar MudTooltip-a — čuva hover metu i kad je
           MudIconButton Disabled (nema selektovanog reda). *@
        <MudTooltip Text="@_tipPdf" ShowOnHover="true" Placement="Placement.Top">
            <span>
                <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                    <MudButton StartIcon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small"
                               Disabled="@(_selektovan is null)" OnClick="PreuzmiPdf">
                        @_tipPdf
                    </MudButton>
                    <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small"
                             Disabled="@(_selektovan is null)">
                        <MudMenuItem OnClick="@(() => _tipPdf = "PDF SAZETAK")">PDF SAZETAK</MudMenuItem>
                        <MudMenuItem OnClick="@(() => _tipPdf = "PREUZMI PDF")">PREUZMI PDF</MudMenuItem>
                        <MudMenuItem OnClick="@(() => _tipPdf = "PROMENE STATUSA")">PROMENE STATUSA</MudMenuItem>
                    </MudMenu>
                </MudButtonGroup>
            </span>
        </MudTooltip>
        <MudTooltip Text="Pregled - otvori PDF u novom tabu" ShowOnHover="true" Placement="Placement.Top">
            <span>
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                               Disabled="@(_selektovan is null)" OnClick="Pregled" />
            </span>
        </MudTooltip>
        <MudTooltip Text="Preuzmi XML" ShowOnHover="true" Placement="Placement.Top">
            <span>
                <MudIconButton Icon="@Icons.Material.Filled.Code" Size="Size.Small"
                               Disabled="@(_selektovan is null)" OnClick="PreuzmiXml" />
            </span>
        </MudTooltip>
        <MudTooltip Text="Prikaz pratećih dokumenata" ShowOnHover="true" Placement="Placement.Top">
            <span>
                <MudIconButton Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small"
                               Disabled="@(_selektovan is null)" OnClick="PrikaziPrateceDokumente" />
            </span>
        </MudTooltip>

        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Announcement"
                   Disabled="@(_selektovan is null)" OnClick="KreirajObavestenje">
            Kreiraj obaveštenje
        </MudButton>

        @* ── Finansije ─────────────────────────────────────────────────── *@
        <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Success" StartIcon="@Icons.Material.Filled.CreditCard"
                   Disabled="@(!MozeUnetiFinansije)" OnClick="UpisiUKarticuDugme">
            Upiši u karticu
        </MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Payment"
                   Disabled="@(!MozeUnetiFinansije)" OnClick="UnosFinansija">
            Unos finansija
        </MudButton>

        @* ── Destruktivne akcije — vizuelno odvojene ──────────────────── *@
        <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
        <MudTooltip Text="Brisanje iz liste" ShowOnHover="true" Placement="Placement.Top">
            <span>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               Disabled="@(_selektovan is null)" OnClick="Placeholder" />
            </span>
        </MudTooltip>

        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="IzlazIzModula">
            Izlaz
        </MudButton>
    </div>
</div>

<MudGrid Spacing="3">

    @* ── LEVA STRANA — Učitaj sa SEF-a + Filteri (ručni accordion, bez
       MudExpansionPanels — isti obrazac kao IzlazneEFakture.razor, jer
       MudExpansionPanels ne pouzdano čuva Expanded stanje po detetu) ── *@
    <MudItem xs="12" md="3">
        <MudPaper Elevation="1" Class="pa-2">

            @* Panel: Učitaj sa SEF-a *@
            <div style="border:1px solid rgba(0,0,0,0.12); border-radius:4px;">
                <div @onclick="OnUcitajPanelToggle"
                     style="display:flex; align-items:center; justify-content:space-between;
                            padding:8px 12px; cursor:pointer; user-select:none;
                            background:#fafafa; border-radius:4px;">
                    <div style="display:flex; align-items:center; gap:8px; font-size:0.85rem; font-weight:600; color:#2D3E50;">
                        <MudIcon Icon="@Icons.Material.Filled.CloudDownload" Size="Size.Small" />
                        Učitaj sa SEF-a
                    </div>
                    <MudIcon Icon="@(_ucitajSekcijaOtvorena ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                             Size="Size.Small" Style="color:#888;" />
                </div>
                @if (_ucitajSekcijaOtvorena)
                {
                    <div style="padding:8px 12px 10px;">
                        <div class="mb-2"><DateInput Label="Datum OD" @bind-Value="_sinhOd" /></div>
                        <div class="mb-3"><DateInput Label="Datum DO" @bind-Value="_sinhDo" /></div>

                        <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.CloudDownload"
                                   OnClick="UcitajNoveZaPeriod"
                                   Disabled="_sinhronizujem"
                                   FullWidth="true">
                            @if (_sinhronizujem)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                            }
                            Učitaj sa SEF-a
                        </MudButton>
                    </div>
                }
            </div>

            @* Panel: Filteri *@
            <div style="border:1px solid rgba(0,0,0,0.12); border-radius:4px; margin-top:10px;">
                <div @onclick="OnFilteriPanelToggle"
                     style="display:flex; align-items:center; justify-content:space-between;
                            padding:8px 12px; cursor:pointer; user-select:none;
                            background:#fafafa; border-radius:4px;">
                    <div style="display:flex; align-items:center; gap:8px; font-size:0.85rem; font-weight:600; color:#2D3E50;">
                        <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="Size.Small" />
                        Filteri
                    </div>
                    <MudIcon Icon="@(_filteriOtvoreni ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                             Size="Size.Small" Style="color:#888;" />
                </div>
                @if (_filteriOtvoreni)
                {
                    <div style="padding:8px 12px 10px;">
                        <div class="mb-2">
                            <NativniInput TValue="string" Label="Naziv ili PIB kupca"
                                          Value="@_nazivIliPibFilter"
                                          ValueChanged="@(v => _nazivIliPibFilter = v ?? string.Empty)"
                                          OnEnter="Izlistaj" />
                        </div>

                        <div class="mb-2">
                            <NativniInput TValue="string" Label="Broj dokumenta"
                                          Value="@_brojDokumentaFilter"
                                          ValueChanged="@(v => _brojDokumentaFilter = v ?? string.Empty)"
                                          OnEnter="Izlistaj" />
                        </div>

                        <div class="mb-2">
                            <NativniSelect Label="Tip Dokumenta" Value="@_tipDokumentaFilter"
                                           ValueChanged="@(v => _tipDokumentaFilter = v ?? "SVI TIPOVI")">
                                <option value="SVI TIPOVI">SVI TIPOVI</option>
                                <option value="FAKTURA">FAKTURA</option>
                                <option value="AVANSNA FAKTURA">AVANSNA FAKTURA</option>
                                <option value="DOKUMENT O SMANJENJU">DOKUMENT O SMANJENJU</option>
                                <option value="DOKUMENT O POVECANJU">DOKUMENT O POVECANJU</option>
                            </NativniSelect>
                        </div>

                        <div class="mb-2">
                            <NativniSelect Label="Status dokumenta" Value="@_statusFilter"
                                           ValueChanged="@(v => _statusFilter = v ?? "SVI STATUSI")">
                                <option value="SVI STATUSI">SVI STATUSI</option>
                                <option value="Novo">Novo</option>
                                <option value="Odobreno">Odobreno</option>
                                <option value="Odbijeno">Odbijeno</option>
                                <option value="Stornirano">Stornirano</option>
                            </NativniSelect>
                        </div>

                        <div class="mb-2">
                            <NativniSelect Label="Tip datuma" Value="@_tipDatuma"
                                           ValueChanged="@(v => _tipDatuma = v ?? "DATUM RACUNA")">
                                <option value="DATUM RACUNA">DATUM RACUNA</option>
                                <option value="DATUM PROMETA">DATUM PROMETA</option>
                            </NativniSelect>
                        </div>

                        <div class="mb-2"><DateInput Label="Datum dokumenta OD" @bind-Value="_datumOd" /></div>
                        <div class="mb-3"><DateInput Label="Datum dokumenta DO" @bind-Value="_datumDo" /></div>

                        <div class="d-flex flex-column gap-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Search"
                                       OnClick="Izlistaj"
                                       Disabled="_ucitava"
                                       FullWidth="true">
                                Izlistaj
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.List"
                                       OnClick="IzlistajSve"
                                       Disabled="_ucitava"
                                       FullWidth="true">
                                Izlistaj sve
                            </MudButton>
                        </div>
                    </div>
                }
            </div>

        </MudPaper>
    </MudItem>

    @* ── DESNA STRANA — Grid ────────────────────────────────────────── *@
    <MudItem xs="12" md="9">

        @if (_ucitava)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <MudDataGrid T="EFakturaUlaz" Items="_lista" Dense="true" Hover="true"
                         FixedHeader="true" Height="calc(100vh - 340px)"
                         RowClick="NaKlikReda"
                         RowStyleFunc="@BojaReda"
                         Class="ulazne-grid">
                <Columns>
                    <TemplateColumn Title="Tip dokumenta" SortBy="x => x.tipDokumenta" HeaderStyle="width:12%;">
                        <CellTemplate Context="red">
                            <MudTooltip Text="@(red.Item.tipDokumenta ?? "")">
                                <span style="white-space:nowrap;">@SkraceniTip(red.Item.tipDokumenta)</span>
                            </MudTooltip>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Broj dokumenta" SortBy="x => x.brojDokumenta" HeaderStyle="width:8%; max-width:100px;">
                        <CellTemplate Context="red">
                            @{ var broj = red.Item.brojDokumenta; }
                            <MudTooltip Text="@(broj ?? "")">
                                <span style="white-space:nowrap;">@(string.IsNullOrEmpty(broj) || broj.Length <= 11 ? broj : broj[..11] + "…")</span>
                            </MudTooltip>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Status" SortBy="x => x.statusDokumenta" HeaderStyle="width:6%; max-width:70px;">
                        <CellTemplate Context="red">
                            <MudChip T="string" Size="Size.Small" Color="@BojaStatusa(red.Item.statusDokumenta)"
                                     Style="font-weight:600;">
                                @red.Item.statusDokumenta
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.naziv" Title="Dobavljač" HeaderStyle="width:32%;" />
                    <TemplateColumn SortBy="x => x.paymentDateUtc" HeaderStyle="width:10%;">
                        <HeaderTemplate Context="zaglavlje">
                            <div class="ulazne-datum-naslov">Datum<br />valute</div>
                        </HeaderTemplate>
                        <CellTemplate Context="red">
                            <span style="white-space:nowrap;">@red.Item.paymentDateUtc?.ToString("dd.MM.yyyy")</span>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn SortBy="x => x.accountingDateUtc" HeaderStyle="width:9%;">
                        <HeaderTemplate Context="zaglavlje">
                            <div class="ulazne-datum-naslov">Datum<br />prometa</div>
                        </HeaderTemplate>
                        <CellTemplate Context="red">
                            <span style="white-space:nowrap;">@red.Item.accountingDateUtc?.ToString("dd.MM.yyyy")</span>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Vrednost" SortBy="x => x.Ukupno" HeaderStyle="width:23%; text-align:right;">
                        <CellTemplate Context="red">
                            <span style="display:block; text-align:right; font-weight:600; padding-right:6px;">@red.Item.Ukupno?.ToString("N2")</span>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="EFakturaUlaz" PageSizeOptions="@(new int[]{20,50,100,200})"
                                      RowsPerPageString="Redova po strani:" />
                </PagerContent>
            </MudDataGrid>

            @if (_lista.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                    Nema ulaznih e-faktura za izabrane filtere.
                </MudAlert>
            }

            @if (_selektovan is not null && _selektovan.statusDokumenta == "Odbijeno")
            {
                <MudPaper Elevation="1" Class="pa-3 mt-3">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Komentar odbijanja</MudText>
                    <MudText Typo="Typo.body2" Style="white-space:pre-wrap;">
                        @(string.IsNullOrWhiteSpace(_selektovan.acceptRejectMessage)
                            ? _selektovan.cancelInvoiceMessage
                            : _selektovan.acceptRejectMessage)
                    </MudText>
                </MudPaper>
            }
        }

    </MudItem>
</MudGrid>

</ZahtevaModul>

@code {
    private string _nazivIliPibFilter    = "";
    private string _brojDokumentaFilter  = "";
    private string _tipDokumentaFilter   = "SVI TIPOVI";
    private string _statusFilter         = "SVI STATUSI";
    private string _tipDatuma            = "DATUM RACUNA";
    private string _datumOd              = "";
    private string _datumDo              = "";

    private List<EFakturaUlaz> _lista = [];
    private EFakturaUlaz?      _selektovan;

    // Izabran tip PDF-a za split-button "Preuzmi PDF" — bira izvor bajtova
    // (PreuzmiPdf/Pregled) i sufiks naziva fajla pri preuzimanju.
    private string _tipPdf = "PDF SAZETAK";

    private bool _ucitava;
    private bool _filteriOtvoreni       = true;
    private bool _ucitajSekcijaOtvorena = true;

    // ── Učitavanje za period (SEF sinhronizacija, odvojeno od lokalnih filtera) ──
    private string _sinhOd = DateTime.Today.AddMonths(-1).ToString("yyyy-MM-dd");
    private string _sinhDo = DateTime.Today.ToString("yyyy-MM-dd");
    private bool   _sinhronizujem;

    protected override async Task OnInitializedAsync()
    {
        if (!TenantService.IsAuthenticated()) { Nav.NavigateTo("/login"); return; }

        var uid = TenantService.GetIdKorisnika();
        var pUcitaj  = await DefaultValues.GetDefault("UlazneEFakture", "panel_ucitaj",  uid);
        var pFilteri = await DefaultValues.GetDefault("UlazneEFakture", "panel_filteri", uid);
        if (pUcitaj  is not null) _ucitajSekcijaOtvorena = pUcitaj  == "True";
        if (pFilteri is not null) _filteriOtvoreni       = pFilteri == "True";

        // Jednokratni backfill invoiceIDint za stare redove (kolona već postoji, ranije
        // ostajala prazna) — pre učitavanja liste da sortiranje odmah bude ispravno.
        // Posle prvog uspešnog poziva postaje trajno no-op, pa se bezbedno zove svaki put.
        try
        {
            await EFaktureService.PopuniInvoiceIdIntBackfillAsync();
        }
        catch
        {
            // Tiho — backfill ne sme srušiti učitavanje liste.
        }

        await Ucitaj(primeniFiltere: false);
    }

    private async Task OnUcitajPanelToggle()
    {
        _ucitajSekcijaOtvorena = !_ucitajSekcijaOtvorena;
        await DefaultValues.SaveDefault("UlazneEFakture", "panel_ucitaj", _ucitajSekcijaOtvorena.ToString(), TenantService.GetIdKorisnika());
    }

    private async Task OnFilteriPanelToggle()
    {
        _filteriOtvoreni = !_filteriOtvoreni;
        await DefaultValues.SaveDefault("UlazneEFakture", "panel_filteri", _filteriOtvoreni.ToString(), TenantService.GetIdKorisnika());
    }

    private Task Izlistaj()    => Ucitaj(primeniFiltere: true);

    private Task IzlistajSve()
    {
        _nazivIliPibFilter   = "";
        _brojDokumentaFilter = "";
        _tipDokumentaFilter  = "SVI TIPOVI";
        _statusFilter        = "SVI STATUSI";
        _tipDatuma           = "DATUM RACUNA";
        _datumOd             = "";
        _datumDo             = "";
        return Ucitaj(primeniFiltere: false);
    }

    private async Task Ucitaj(bool primeniFiltere)
    {
        _ucitava = true; _selektovan = null; StateHasChanged();
        try
        {
            string? nazivPib = null, broj = null, tip = null, status = null;
            string  tipDatuma = "DATUM RACUNA";
            DateTime? od = null, doDatum = null;

            if (primeniFiltere)
            {
                nazivPib  = string.IsNullOrWhiteSpace(_nazivIliPibFilter)   ? null : _nazivIliPibFilter;
                broj      = string.IsNullOrWhiteSpace(_brojDokumentaFilter) ? null : _brojDokumentaFilter;
                tip       = _tipDokumentaFilter;
                status    = _statusFilter;
                tipDatuma = _tipDatuma;
                od        = DateTime.TryParse(_datumOd, out var odD) ? odD : null;
                doDatum   = DateTime.TryParse(_datumDo, out var doD) ? doD : null;
            }

            _lista = await EFaktureService.GetListaAsync(nazivPib, broj, tip, status, tipDatuma, od, doDatum);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
        }
        finally
        {
            _ucitava = false;
            StateHasChanged();
        }
    }

    private void NaKlikReda(DataGridRowClickEventArgs<EFakturaUlaz> args)
    {
        _selektovan = args.Item;
    }

    // ── Učitaj nove za period — povlači sa SEF-a (Faza B), zatim osvežava lokalnu listu ──
    private async Task UcitajNoveZaPeriod()
    {
        if (!DateTime.TryParse(_sinhOd, out var od) || !DateTime.TryParse(_sinhDo, out var doDatum))
        {
            Snackbar.Add("Unesite ispravan period.", Severity.Warning);
            return;
        }

        _sinhronizujem = true; StateHasChanged();
        try
        {
            var (brojNovih, upozorenjaPartner) = await EFaktureService.SinhronizujAsync(od, doDatum);

            var poruka = $"Uvezeno novih faktura: {brojNovih}.";
            if (upozorenjaPartner.Count > 0)
                poruka += " Sledeći partneri ne postoje u imeniku i preporučljivo je da ih evidentirate: "
                          + string.Join(", ", upozorenjaPartner);

            Snackbar.Add(poruka,
                upozorenjaPartner.Count > 0 ? Severity.Warning : Severity.Success,
                cfg => cfg.VisibleStateDuration = 8000);

            // Osveži lokalnu listu sa trenutnim filterima (prazna polja = isto kao Izlistaj sve).
            await Ucitaj(primeniFiltere: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri učitavanju sa SEF-a: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
        }
        finally
        {
            _sinhronizujem = false;
            StateHasChanged();
        }
    }

    // Već obrađen dokument (Odobreno/Odbijeno/Otkazano/Stornirano) se ne prihvata/odbija ponovo.
    private bool MozePrihvatitiOdbiti =>
        _selektovan is not null
        && _selektovan.statusDokumenta is not ("Odobreno" or "Odbijeno" or "Otkazano" or "Stornirano");

    private async Task OsveziStatus()
    {
        if (_selektovan?.invoiceID is null) return;

        try
        {
            var noviStatus = await EFaktureService.OsveziStatusAsync(_selektovan.invoiceID);
            _selektovan.statusDokumenta = noviStatus;
            StateHasChanged();
            Snackbar.Add("Status ažuriran", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
        }
    }

    private async Task Prihvati()
    {
        if (_selektovan is null) return;

        var potvrda = await Dialog.ShowMessageBox(
            "Potvrda",
            "Da li ste sigurni da želite da prihvatite ovaj dokument?",
            yesText: "Da, prihvati", cancelText: "Odustani");

        if (potvrda != true) return;

        await PrimeniPrihvatiOdbij(prihvati: true, komentar: "");
    }

    private async Task Odbij()
    {
        if (_selektovan is null) return;

        var opts   = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await Dialog.ShowAsync<OdbijDokumentDialog>("Odbijanje dokumenta", opts);
        var result = await dialog.Result;

        if (result is null || result.Canceled) return;

        var komentar = (string)result.Data!;
        await PrimeniPrihvatiOdbij(prihvati: false, komentar: komentar);
    }

    private async Task PrimeniPrihvatiOdbij(bool prihvati, string komentar)
    {
        if (_selektovan?.invoiceID is null) return;

        try
        {
            var (uspesno, poruka) = await EFaktureService.PrihvatiOdbijAsync(_selektovan.invoiceID, prihvati, komentar);

            if (!uspesno)
            {
                Snackbar.Add(poruka, Severity.Error);
                return;
            }

            // Isto kao stari kod: updateStatusa() se zove posle aceptReject() —
            // osvežava se samo ovaj jedan red, bez ponovnog učitavanja cele liste.
            var noviStatus = await EFaktureService.OsveziStatusAsync(_selektovan.invoiceID);
            _selektovan.statusDokumenta = noviStatus;
            StateHasChanged();

            Snackbar.Add(prihvati ? "Dokument je prihvaćen" : "Dokument je odbijen", Severity.Success);

            // Isto kao stari insertUKartice — poziva se SAMO za tip FAKTURA, posle uspešnog Prihvati.
            if (prihvati && _selektovan.tipDokumenta == "FAKTURA")
                await PitajUpisUKarticu(_selektovan);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
        }
    }

    // ── Integracija sa karticom (samo FAKTURA, posle uspešnog Prihvati) ──────
    private async Task PitajUpisUKarticu(EFakturaUlaz red)
    {
        var potvrda = await Dialog.ShowMessageBox(
            "Upis u karticu",
            "Odobrili ste E-Fakturu. Da li želite da upišete ovaj ulazni račun u karticu?",
            yesText: "Da", cancelText: "Ne");

        if (potvrda != true) return;

        if (string.IsNullOrWhiteSpace(red.PIB))
        {
            Snackbar.Add("Dokument nema PIB partnera — ne može se upisati u karticu.", Severity.Warning);
            return;
        }

        var partner = await Db.Partneri.AsNoTracking().FirstOrDefaultAsync(p => p.PIB == red.PIB);
        if (partner is null)
        {
            Snackbar.Add(
                $"Partner sa PIB {red.PIB} ne postoji u imeniku. Molimo evidentirajte partnera pre upisa u karticu.",
                Severity.Warning);
            return;
        }

        // Scoped i po PartnerUloga — idEfakture kolona je deljena između tbl_eFakturaUlaz
        // (DOBAVLJAC) i tbl_eInvoice (KUPAC), odvojene tabele sa sopstvenim auto-increment
        // ID prostorom, pa se vrednosti mogu poklopiti bez ikakve stvarne veze.
        var vecUpisano = await Db.KarticeNova.AnyAsync(
            k => k.IdEfakture == red.idEfakture && k.PartnerUloga == "DOBAVLJAC");
        if (vecUpisano)
        {
            Snackbar.Add("Ovaj ulazni račun je već upisan u karticu.", Severity.Info);
            return;
        }

        // Ulazne e-fakture preko SEF-a su UVEK domaći partneri (SEF je isključivo za srpske firme).
        var domacaValuta = (await Db.Podesavanja.AsNoTracking()
            .Select(p => p.OpcijaString13)
            .FirstOrDefaultAsync()) ?? "RSD";

        try
        {
            var stavka = new KarticaNova
            {
                IdPartnera     = partner.Broj,
                PIB            = partner.PIB,
                NazivPartnera  = partner.Naziv,
                PartnerUloga   = "DOBAVLJAC",
                TipDokumenta   = "RACUN",
                BrojDokumenta  = red.brojDokumenta,
                IdRacun        = null,
                IdEfakture     = red.idEfakture,
                Valuta         = domacaValuta,
                DatumDokumenta = red.invoiceDateUtc,
                DatumPrometa   = red.accountingDateUtc,
                DatumValute    = red.paymentDateUtc
            };

            await KarticaNovaServis.DodajStavku(stavka, red.Ukupno ?? 0);
            Snackbar.Add("Ulazni račun je dodat u karticu!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri upisu u karticu: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
        }
    }

    // Toolbar dugme "Upiši u karticu" — poziva ISTU metodu kao dosadašnji automatski
    // tok posle Prihvati (dedupe provera unutra ostaje ista, samo se sad može pozvati
    // i ručno na već odobrenom dokumentu).
    private Task UpisiUKarticuDugme() => _selektovan is null ? Task.CompletedTask : PitajUpisUKarticu(_selektovan);

    // ── Unos finansija (navigira na /finansije/unos sa predpopunjenim poljima) ──
    // Odvojeno od "Upiši u karticu" (direktan upis bez pregleda) — ovde korisnik
    // pregleda/menja podatke pre snimanja na postojećoj formi.
    private bool MozeUnetiFinansije =>
        _selektovan is not null
        && _selektovan.tipDokumenta == "FAKTURA"
        && _selektovan.statusDokumenta == "Odobreno";

    private async Task UnosFinansija()
    {
        if (_selektovan is null) return;

        if (string.IsNullOrWhiteSpace(_selektovan.PIB))
        {
            Snackbar.Add("Dokument nema PIB partnera — ne može se otvoriti unos finansija.", Severity.Warning);
            return;
        }

        var partner = await Db.Partneri.AsNoTracking().FirstOrDefaultAsync(p => p.PIB == _selektovan.PIB);
        if (partner is null)
        {
            Snackbar.Add(
                $"Partner sa PIB {_selektovan.PIB} ne postoji u imeniku. Molimo evidentirajte partnera pre upisa u karticu.",
                Severity.Warning);
            return;
        }

        var red = _selektovan;
        var url = "/finansije/unos"
            + $"?idPartnera={partner.Broj}"
            + "&smer=ULAZ"
            + "&tip=RACUN_RSD"
            + $"&iznos={(red.Ukupno ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture)}"
            + $"&brojDokumenta={Uri.EscapeDataString(red.brojDokumenta ?? "")}"
            + $"&datumDokumenta={red.invoiceDateUtc?.ToString("yyyy-MM-dd")}"
            + $"&datumValute={red.paymentDateUtc?.ToString("yyyy-MM-dd")}"
            + $"&datumPrometa={red.accountingDateUtc?.ToString("yyyy-MM-dd")}"
            + $"&idEfakture={red.idEfakture}";

        Nav.NavigateTo(url);
    }

    // ── Kreiraj obaveštenje (navigira na formu Obaveštenja o prethodnom porezu) ──
    private bool MozeKreiratiObavestenje(EFakturaUlaz red) =>
        (red.tipDokumenta is "FAKTURA" or "AVANSNA FAKTURA" or "KNJIZNO ZADUZENJE" or "DOKUMENT O POVECANJU"
            && red.statusDokumenta == "Stornirano")
        || (red.tipDokumenta is "KNJIZNO ODOBRENJE" or "DOKUMENT O SMANJENJU"
            && red.statusDokumenta == "Odobreno");

    private async Task KreirajObavestenje()
    {
        if (_selektovan is null) return;

        // Osveži status SAMO za ovaj dokument, SAMO u ovom trenutku (klik dugmeta) —
        // ne dira ostatak liste, ne postaje opšti auto-refresh mehanizam (taj ostaje
        // isključivo dugme "Osveži status", po dizajnu iz Faze C).
        if (_selektovan.invoiceID is not null)
        {
            try
            {
                var noviStatus = await EFaktureService.OsveziStatusAsync(_selektovan.invoiceID);
                _selektovan.statusDokumenta = noviStatus;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Greška pri osvežavanju statusa: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
                return;
            }
        }

        if (!MozeKreiratiObavestenje(_selektovan))
        {
            Snackbar.Add(
                "Za ovaj dokument, sa ovim statusom, ne može da se kreira obaveštenje. " +
                "Faktura, ili Avansna faktura moraju biti stornirani da bi se izdalo obaveštenje.",
                Severity.Warning);
            return;
        }

        var red = _selektovan;
        var url = "/efakture/obavestenje-prethodnog-poreza/unos"
            + "?source=ULAZNI"
            + $"&tipDokumenta={Uri.EscapeDataString(red.tipDokumenta ?? "")}"
            + $"&naziv={Uri.EscapeDataString(red.naziv ?? "")}"
            + $"&pib={Uri.EscapeDataString(red.PIB ?? "")}"
            + $"&mb={Uri.EscapeDataString(red.MB ?? "")}"
            + $"&iznosPdv={(red.PDV ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture)}"
            + $"&brojDokumenta={Uri.EscapeDataString(red.brojDokumenta ?? "")}"
            + $"&datumIzdavanja={red.invoiceDateUtc?.ToString("yyyy-MM-dd")}";

        Nav.NavigateTo(url);
    }

    // Skraćeni prikaz tipa dokumenta u tabeli (pun naziv ostaje u tooltip-u).
    // Stara terminologija (KNJIZNO ODOBRENJE/ZADUZENJE) mapira se isto kao nova.
    private static string SkraceniTip(string? tip) => tip switch
    {
        "FAKTURA"                 => "FAKTURA",
        "AVANSNA FAKTURA"         => "AVANS",
        "DOKUMENT O SMANJENJU"    => "DOK. SMANJENJA",
        "DOKUMENT O POVECANJU"    => "DOK. POVEĆANJA",
        "KNJIZNO ODOBRENJE"       => "DOK. SMANJENJA",
        "KNJIZNO ZADUZENJE"       => "DOK. POVEĆANJA",
        _                         => tip ?? ""
    };

    // Boja statusnog čipa — ista grupacija kao ranije bojenje celog reda.
    // RAZLIKA OD IZLAZNIH: ovde "Otkazano" ide u crvenu grupu zajedno sa
    // Odbijeno/Stornirano (potvrđeno iz originalnog BojaReda koda).
    private static Color BojaStatusa(string? status) => status switch
    {
        "Odobreno"                                => Color.Success,
        "Odbijeno" or "Stornirano" or "Otkazano"   => Color.Error,
        _                                          => Color.Warning
    };

    // Bojenje celog reda je uklonjeno (boju sad nosi statusni čip) — ovde ostaje
    // samo vizuelno isticanje selektovanog reda.
    private string BojaReda(EFakturaUlaz item, int _) =>
        _selektovan is not null && _selektovan.idEfakture == item.idEfakture
            ? "background-color:rgba(61,142,185,0.18); border-left:4px solid #3D8EB9;"
            : string.Empty;

    private void Placeholder() => Snackbar.Add("Dostupno u sledećoj fazi.", Severity.Info);

    // Isto kao stari kod — očisti / i \ iz broja dokumenta pre nego što postane naziv fajla.
    private static string OcistiNazivFajla(string? brojDokumenta) =>
        (brojDokumenta ?? "dokument").Replace("/", "").Replace("\\", "");

    // Bira izvor bajtova prema izabranom tipu iz split-button menija.
    private async Task<byte[]?> UcitajPdfPoTipuAsync(string invoiceId) => _tipPdf switch
    {
        "PREUZMI PDF"     => await EFaktureService.PreuzmiProsireniPdfAsync(invoiceId),
        "PROMENE STATUSA" => await EFaktureService.PreuzmiStatusHistoryPdfAsync(invoiceId),
        _                 => await EFaktureService.PreuzmiPdfAsync(invoiceId) // "PDF SAZETAK"
    };

    private string SufiksZaTipPdf() => _tipPdf switch
    {
        "PREUZMI PDF"     => "_prosireni",
        "PROMENE STATUSA" => "_promene_statusa",
        _                 => ""
    };

    // "PREUZMI PDF" (prošireni) je najčešće razlog izostanka dok SEF generiše
    // dokument posle slanja — ista poruka kao kod izlaznih; ostali tipovi
    // zadržavaju kraću, opštiju poruku.
    private string PorukaPdfNijeFormiran() => _tipPdf == "PREUZMI PDF"
        ? "PDF prikaz još uvek nije formiran, pokušajte malo kasnije, kada se status promeni u POSLATO ili PRIHVACENO"
        : "PDF nije dostupan za ovaj dokument";

    private async Task PreuzmiPdf()
    {
        if (_selektovan?.invoiceID is null) return;

        try
        {
            var bytes = await UcitajPdfPoTipuAsync(_selektovan.invoiceID);
            if (bytes is null)
            {
                Snackbar.Add(PorukaPdfNijeFormiran(), Severity.Warning);
                return;
            }

            var naziv = $"Racun_{OcistiNazivFajla(_selektovan.brojDokumenta)}{SufiksZaTipPdf()}.pdf";
            var b64   = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadFilePdf", naziv, b64);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri preuzimanju PDF-a: {ex.Message}", Severity.Error);
        }
    }

    private async Task Pregled()
    {
        if (_selektovan?.invoiceID is null) return;

        try
        {
            var bytes = await UcitajPdfPoTipuAsync(_selektovan.invoiceID);
            if (bytes is null)
            {
                Snackbar.Add(PorukaPdfNijeFormiran(), Severity.Warning);
                return;
            }

            var b64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("openPdfPreview", b64);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri pregledu PDF-a: {ex.Message}", Severity.Error);
        }
    }

    private async Task PreuzmiXml()
    {
        if (_selektovan?.invoiceID is null) return;

        try
        {
            var xml = await EFaktureService.PreuzmiXmlAsync(_selektovan.invoiceID);
            if (string.IsNullOrWhiteSpace(xml))
            {
                Snackbar.Add("XML nije dostupan za ovaj dokument", Severity.Warning);
                return;
            }

            var naziv = $"Racun_{OcistiNazivFajla(_selektovan.brojDokumenta)}.xml";
            await JS.InvokeVoidAsync("downloadTextFile", naziv, xml);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri preuzimanju XML-a: {ex.Message}", Severity.Error);
        }
    }

    private async Task PrikaziPrateceDokumente()
    {
        if (_selektovan?.invoiceID is null) return;

        try
        {
            var prilozi = await EFaktureService.UcitajPrateceDokumenteAsync(_selektovan.invoiceID);
            if (prilozi.Count == 0)
            {
                Snackbar.Add("Ova faktura nema priložene dokumente.", Severity.Info);
                return;
            }

            var parametri = new DialogParameters<PrateciDokumentiDialog> { { x => x.Prilozi, prilozi } };
            var opts = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
            await Dialog.ShowAsync<PrateciDokumentiDialog>(
                $"Prateći dokumenti — {_selektovan.brojDokumenta}", parametri, opts);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri učitavanju priloga: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
        }
    }

    private void IzlazIzModula() => Nav.NavigateTo("/dashboard");
}
