@page "/efakture/zbirna-evidencija"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using Transport.Domain.Entities
@using Transport.Application.Interfaces
@using Transport.Application.Services.Sef

@inject ITenantService                 TenantService
@inject NavigationManager              Nav
@inject IZbirnaEvidencijaPDVService    EvidencijaService
@inject IDefaultValuesService          DefaultValues
@inject ISnackbar                      Snackbar

<PageTitle>Zbirna evidencija PDV — Autoprevoz</PageTitle>

<div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-3">
    <MudText Typo="Typo.h5" Style="color:#2D3E50;">
        <MudIcon Icon="@Icons.Material.Filled.Summarize" Class="mr-2" />
        Zbirna evidencija PDV
    </MudText>

    <div class="d-flex align-center flex-wrap gap-2">
        @* ── Primarne akcije ─────────────────────────────────────────── *@
        <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="NovaEvidencija">
            Dodaj novu Zbirnu evidenciju PDV
        </MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Cancel"
                   Disabled="@(_selektovan is null)"
                   OnClick="Otkazi">
            Otkaži
        </MudButton>

        @* ── Sekundarne akcije — ikonice ──────────────────────────────── *@
        <MudTooltip Text="Pregled" ShowOnHover="true" Placement="Placement.Top">
            <span>
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                               Disabled="@(_selektovan is null)" OnClick="Pregled" />
            </span>
        </MudTooltip>

        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="IzlazIzModula">
            Izlaz
        </MudButton>
    </div>
</div>

<MudGrid Spacing="3">

    @* ── LEVA STRANA — Učitaj sa SEF-a + Filteri (ručni accordion, isti obrazac kao
       IzlazneEFakture.razor) ── *@
    <MudItem xs="12" md="3">
        <MudPaper Elevation="1" Class="pa-2">

            @* Panel: Učitaj sa SEF-a — SAMO VIZUELNO za sad, čeka Fazu B (SEF v2). *@
            <div style="border:1px solid rgba(0,0,0,0.12); border-radius:4px;">
                <div @onclick="OnUcitajPanelToggle"
                     style="display:flex; align-items:center; justify-content:space-between;
                            padding:8px 12px; cursor:pointer; user-select:none;
                            background:#fafafa; border-radius:4px;">
                    <div style="display:flex; align-items:center; gap:8px; font-size:0.85rem; font-weight:600; color:#2D3E50;">
                        <MudIcon Icon="@Icons.Material.Filled.CloudDownload" Size="Size.Small" />
                        Učitaj sa SEF-a
                    </div>
                    <MudIcon Icon="@(_ucitajSekcijaOtvorena ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                             Size="Size.Small" Style="color:#888;" />
                </div>
                @if (_ucitajSekcijaOtvorena)
                {
                    <div style="padding:8px 12px 10px;">
                        <div class="mb-2"><DateInput Label="Datum OD" @bind-Value="_sinhOd" /></div>
                        <div class="mb-3"><DateInput Label="Datum DO" @bind-Value="_sinhDo" /></div>

                        <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.CloudDownload"
                                   OnClick="UcitajNoveZaPeriod"
                                   Disabled="_sinhronizujem"
                                   FullWidth="true">
                            @if (_sinhronizujem)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                            }
                            Učitaj sa SEF-a
                        </MudButton>
                    </div>
                }
            </div>

            @* Panel: Filteri *@
            <div style="border:1px solid rgba(0,0,0,0.12); border-radius:4px; margin-top:10px;">
                <div @onclick="OnFilteriPanelToggle"
                     style="display:flex; align-items:center; justify-content:space-between;
                            padding:8px 12px; cursor:pointer; user-select:none;
                            background:#fafafa; border-radius:4px;">
                    <div style="display:flex; align-items:center; gap:8px; font-size:0.85rem; font-weight:600; color:#2D3E50;">
                        <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="Size.Small" />
                        Filteri
                    </div>
                    <MudIcon Icon="@(_filteriOtvoreni ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                             Size="Size.Small" Style="color:#888;" />
                </div>
                @if (_filteriOtvoreni)
                {
                    <div style="padding:8px 12px 10px;">
                        <div class="mb-2">
                            <NativniInput TValue="string" Label="Broj obračuna"
                                          Value="@_brojObracunaFilter"
                                          ValueChanged="@(v => _brojObracunaFilter = v ?? string.Empty)"
                                          OnEnter="Izlistaj" />
                        </div>

                        <div class="mb-2">
                            <NativniSelect Label="Status" Value="@_statusFilter"
                                           ValueChanged="@(v => _statusFilter = v ?? "SVI STATUSI")">
                                <option value="SVI STATUSI">SVI STATUSI</option>
                                <option value="U pripremi">U pripremi</option>
                                <option value="Evidentirano">Evidentirano</option>
                                <option value="Korigovano">Korigovano</option>
                                <option value="Ponisteno">Ponisteno</option>
                            </NativniSelect>
                        </div>

                        <div class="mb-2"><DateInput Label="Datum promene statusa OD" @bind-Value="_datumOd" /></div>
                        <div class="mb-3"><DateInput Label="Datum promene statusa DO" @bind-Value="_datumDo" /></div>

                        <div class="d-flex flex-column gap-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Search"
                                       OnClick="Izlistaj"
                                       Disabled="_ucitava"
                                       FullWidth="true">
                                Izlistaj
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.List"
                                       OnClick="IzlistajSve"
                                       Disabled="_ucitava"
                                       FullWidth="true">
                                Izlistaj sve
                            </MudButton>
                        </div>
                    </div>
                }
            </div>
        </MudPaper>
    </MudItem>

    @* ── DESNA STRANA — Grid ────────────────────────────────────────── *@
    <MudItem xs="12" md="9">

        @if (_ucitava)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <MudDataGrid T="GroupVatRecord" Items="_lista" Dense="true" Hover="true"
                         FixedHeader="true" Height="calc(100vh - 340px)"
                         RowClick="NaKlikReda"
                         RowStyleFunc="@BojaReda"
                         Class="evidencija-grid">
                <Columns>
                    <PropertyColumn Property="x => x.calculationNumber" Title="Broj Zbirne evidencije PDV" HeaderStyle="width:20%;" />
                    <PropertyColumn Property="x => x.vatPeriodStr" Title="Period" HeaderStyle="width:11%;" />
                    <PropertyColumn Property="x => x.year" Title="Godina" HeaderStyle="width:8%;" />
                    <TemplateColumn Title="Status" SortBy="x => x.vatRecordingStatus" HeaderStyle="width:7%; max-width:80px;">
                        <CellTemplate Context="red">
                            <MudChip T="string" Size="Size.Small" Color="@BojaStatusa(red.Item.vatRecordingStatus)"
                                     Style="font-weight:600;">
                                @red.Item.vatRecordingStatus
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Datum promene statusa" SortBy="x => x.statusChangeDate" HeaderStyle="width:13%;">
                        <CellTemplate Context="red">
                            <span style="white-space:nowrap;">@red.Item.statusChangeDate?.ToString("dd.MM.yyyy")</span>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Broj dokumenta" SortBy="x => x.documentNumber" HeaderStyle="width:14%; max-width:130px;">
                        <CellTemplate Context="red">
                            @{ var broj = red.Item.documentNumber; }
                            <MudTooltip Text="@(broj ?? "")">
                                <span style="white-space:nowrap;">@(string.IsNullOrEmpty(broj) || broj.Length <= 14 ? broj : broj[..14] + "…")</span>
                            </MudTooltip>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.relatedPartyIdentifier" Title="Identifikator partnera" HeaderStyle="width:27%;" />
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="GroupVatRecord" PageSizeOptions="@(new int[]{20,50,100,200})"
                                      RowsPerPageString="Redova po strani:" />
                </PagerContent>
            </MudDataGrid>

            @if (_lista.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                    Nema evidencija za izabrane filtere.
                </MudAlert>
            }
        }

    </MudItem>
</MudGrid>

@code {
    private string _brojObracunaFilter = "";
    private string _statusFilter       = "SVI STATUSI";
    private string _datumOd            = "";
    private string _datumDo            = "";

    private List<GroupVatRecord> _lista = [];
    private GroupVatRecord?      _selektovan;

    private bool _ucitava;
    private bool _filteriOtvoreni       = true;
    private bool _ucitajSekcijaOtvorena = false;

    // ── Učitaj sa SEF-a — SAMO VIZUELNO za sad (SEF v2 sinhronizacija je Faza B,
    // nije još implementirana). Datumi kao string, isto kao IzlazneEFakture.razor
    // (DateInput.Value je string, ne DateTime?). ──────────────────────────────
    private string _sinhOd = DateTime.Today.AddMonths(-1).ToString("yyyy-MM-dd");
    private string _sinhDo = DateTime.Today.ToString("yyyy-MM-dd");
    private bool   _sinhronizujem;

    protected override async Task OnInitializedAsync()
    {
        if (!TenantService.IsAuthenticated()) { Nav.NavigateTo("/login"); return; }

        var uid      = TenantService.GetIdKorisnika();
        var pUcitaj  = await DefaultValues.GetDefault("ZbirnaEvidencija", "panel_ucitaj",  uid);
        var pFilteri = await DefaultValues.GetDefault("ZbirnaEvidencija", "panel_filteri", uid);
        if (pUcitaj  is not null) _ucitajSekcijaOtvorena = pUcitaj  == "True";
        if (pFilteri is not null) _filteriOtvoreni       = pFilteri == "True";

        await Ucitaj(primeniFiltere: false);
    }

    private async Task OnUcitajPanelToggle()
    {
        _ucitajSekcijaOtvorena = !_ucitajSekcijaOtvorena;
        await DefaultValues.SaveDefault("ZbirnaEvidencija", "panel_ucitaj", _ucitajSekcijaOtvorena.ToString(), TenantService.GetIdKorisnika());
    }

    private async Task OnFilteriPanelToggle()
    {
        _filteriOtvoreni = !_filteriOtvoreni;
        await DefaultValues.SaveDefault("ZbirnaEvidencija", "panel_filteri", _filteriOtvoreni.ToString(), TenantService.GetIdKorisnika());
    }

    private async Task UcitajNoveZaPeriod()
    {
        if (!DateTime.TryParse(_sinhOd, out var od) || !DateTime.TryParse(_sinhDo, out var doDatum))
        {
            Snackbar.Add("Unesite ispravan period.", Severity.Warning);
            return;
        }

        _sinhronizujem = true; StateHasChanged();
        try
        {
            var (upisano, azurirano) = await EvidencijaService.SinhronizujSaSefaAsync(od, doDatum);
            Snackbar.Add($"Učitano: {upisano} novih, {azurirano} ažurirano.", Severity.Success);
            await Ucitaj(primeniFiltere: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri učitavanju sa SEF-a: {ex.Message}", Severity.Error);
        }
        finally
        {
            _sinhronizujem = false;
        }
    }

    private Task Izlistaj()    => Ucitaj(primeniFiltere: true);

    private Task IzlistajSve()
    {
        _brojObracunaFilter = "";
        _statusFilter       = "SVI STATUSI";
        _datumOd            = "";
        _datumDo            = "";
        return Ucitaj(primeniFiltere: false);
    }

    private async Task Ucitaj(bool primeniFiltere)
    {
        _ucitava = true; _selektovan = null; StateHasChanged();
        try
        {
            string? broj = null, status = null;
            DateTime? od = null, doDatum = null;

            if (primeniFiltere)
            {
                broj    = string.IsNullOrWhiteSpace(_brojObracunaFilter) ? null : _brojObracunaFilter;
                status  = _statusFilter;
                od      = DateTime.TryParse(_datumOd, out var odD) ? odD : null;
                doDatum = DateTime.TryParse(_datumDo, out var doD) ? doD : null;
            }

            _lista = await EvidencijaService.GetListaAsync(broj, status, od, doDatum);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
        }
        finally
        {
            _ucitava = false;
            StateHasChanged();
        }
    }

    private void NaKlikReda(DataGridRowClickEventArgs<GroupVatRecord> args)
    {
        _selektovan = args.Item;
    }

    // Boja statusnog čipa: Evidentirano=zeleno, Ponisteno/Stornirano=crveno,
    // sve ostalo (U pripremi/Korigovano)=žuto.
    private static Color BojaStatusa(string? status) => status switch
    {
        "Evidentirano"                => Color.Success,
        "Ponisteno" or "Stornirano"   => Color.Error,
        _                             => Color.Warning
    };

    // Vizuelno isticanje selektovanog reda (isti stil kao Ulazne/Izlazne).
    private string BojaReda(GroupVatRecord item, int _) =>
        _selektovan is not null && _selektovan.idZbirne == item.idZbirne
            ? "background-color:rgba(61,142,185,0.18); border-left:4px solid #3D8EB9;"
            : string.Empty;

    private void NovaEvidencija() => Nav.NavigateTo("/efakture/zbirna-evidencija/unos");

    private void Pregled() => Snackbar.Add("Dostupno u sledećoj fazi.", Severity.Info);

    private void Otkazi() => Snackbar.Add("Dostupno u sledećoj fazi.", Severity.Info);

    private void IzlazIzModula() => Nav.NavigateTo("/dashboard");
}
