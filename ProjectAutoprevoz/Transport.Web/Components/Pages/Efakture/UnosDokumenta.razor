    // Izvorne fakture istog kupca (PIB), stvarno poslate/prihvaćene na SEF — isti
    // kombinovani uslov statusa kao panel avansa (status="POSLATO" za direktno
    // poslate, statusDokumenta="Poslato"/"Prihvaceno" za sinhronizovane sa SEF-a).
    private async Task UcitajDostupneIzvorneFakture()
    {
        if (string.IsNullOrWhiteSpace(_model.Pib))
        {
            _dostupneIzvorneFakture = [];
            return;
        }

        _ucitavaIzvorneFakture = true;
        try
        {
            var vecIzabrane = _izabraneIzvorneFakture.Select(f => f.IdEfakture).ToHashSet();

            var lista = await Db.EInvoices.AsNoTracking()
                .Where(e => e.tipDokumenta == "FAKTURA" && e.pib == _model.Pib
                         && (e.status == "POSLATO" || e.statusDokumenta == "Poslato" || e.statusDokumenta == "Prihvaceno"))
                .OrderByDescending(e => e.invoiceDateUtc)
                .ToListAsync();

            _dostupneIzvorneFakture = [.. lista
                .Where(e => !vecIzabrane.Contains(e.idEfakture))
                .Select(e => new IzvornaFakturaVM
                {
                    IdEfakture     = e.idEfakture,
                    BrojDokumenta  = e.brojDokumenta ?? "",
                    DatumIzdavanja = e.invoiceDateUtc
                })];
        }
        finally
        {
            _ucitavaIzvorneFakture = false;
        }
    }

    private void DodajIzabranuFakturu()
