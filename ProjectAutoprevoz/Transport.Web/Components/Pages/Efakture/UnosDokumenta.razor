    private async Task OnSmanjenjeOdnosiSeNaChanged(string? v)
    {
        _smanjenjeOdnosiSeNa = v ?? "Pojedinačna faktura";

        // Promena moda menja i izvor pickera (FAKTURA <-> AVANSNA FAKTURA) — očisti
        // izabrane, ne mešaj fakture i avanse u istoj listi.
        _smanjenjeIzabraneFakture = [];
        _smanjenjeRucneFakture = [];

        if (_smanjenjeOdnosiSeNa is "Pojedinačna faktura" or "Pojedinačna avansna faktura" && !_smanjenjeNijeRegistrovano)
            await UcitajDostupneSmanjenjeFakture();
