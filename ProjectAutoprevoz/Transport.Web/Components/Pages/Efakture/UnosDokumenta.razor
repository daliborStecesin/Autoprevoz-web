        public decimal IskorisenoOsnovica { get; set; }
        public decimal IskorisenoPdv => Stopa > 0 ? Math.Round(IskorisenoOsnovica * Stopa / 100m, 2) : 0m;

        // Čisto UX polje (alternativni dvosmerni unos) — builderu i dalje ide
        // samo IskorisenoOsnovica/IskorisenoPdv, ovo je izvedeno/prikazno.
        public decimal IskorisenoBruto => IskorisenoOsnovica + IskorisenoPdv;
