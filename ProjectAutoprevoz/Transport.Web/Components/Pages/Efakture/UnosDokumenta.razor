@code {
    private UnosDokumentaModel _model = new();

    // ── Ulaz sa druge stranice (npr. dugme "E-faktura" na /fakture/unos) ──────
    // izvor/id se samo pamte za sad (prefill dolazi u sledećem koraku); tip se
    // odmah postavlja u padajući "Tip dokumenta".
    [SupplyParameterFromQuery(Name = "izvor")] public string? QIzvor { get; set; }
    [SupplyParameterFromQuery(Name = "id")]    public int?    QId    { get; set; }
    [SupplyParameterFromQuery(Name = "tip")]   public string? QTip   { get; set; }

    private string? _izvor;
    private int?    _izvorId;

    // Zaključavanja kad je forma popunjena iz računa (izvor=racun, uspešan prefill).
    private bool _izvorRacunLocked;

    // ── Partner (primalac) — autocomplete na polju Naziv, isti pattern kao
    // /fakture/unos: @onfocusin otvori sve, @onfocusout 150ms delay zatvori,
    // filter Contains OrdinalIgnoreCase. Read-only pristup imeniku partnera. ──
    private List<Partner> _sviPartneri     = [];
    private List<Partner> _partneriPredlozi = [];
    private bool          _partnerOpen;

    // ── Banka (žiro račun) — isti pattern kao /fakture/unos ──────────────────
    private List<Banka> _sveBanke = [];

    // ── Osnov oslobođenja od PDV — panel se prikazuje kad bar jedna stavka ima
    // stopu 0. Grupisanje je PO SLOVU (kategoriji) — jedan član po slovu (SEF
    // pravilo). Lista IzabraniClanovi drži do 2 člana (slot 0 uvek postoji, slot 1
    // samo kad je "Koristi više članova" uključeno); struktura kao lista da se
    // lako proširi na više članova kasnije. ──────────────────────────────────
    private List<TaxExemption>        _clanoviOslobodjenja = [];
    private List<ClanOslobodjenjaVM>  _izabraniClanovi     = [new()];
    private bool                      _koristiViseClanova;

    private bool PrikaziPanelOslobodjenja => Stavke.Any(s => s.Stopa == 0);

    // Sva RAZLIČITA slova od trenutno izabranih članova (0, 1 ili 2 slova).
    private List<string> AktivnaSlova =>
        [.. _izabraniClanovi
            .Where(c => !string.IsNullOrWhiteSpace(c.Slovo))
            .Select(c => c.Slovo!)
            .Distinct()];

    // Kolona "PDV kategorija" (slovo po stavci) ima smisla SAMO kad postoje 2
    // različita aktivna slova — sa jednim članom je slovo uvek isto, pa se ne
    // pita korisnik ništa (auto-primena, vidi AzurirajOslobodjenjeSlova).
    private bool PrikaziKolonuSlovo => _koristiViseClanova && AktivnaSlova.Count > 1;

    private class ClanOslobodjenjaVM
    {
        public int?    ReasonId { get; set; }
        public string? KeyClan  { get; set; }
        public string? Slovo    { get; set; } // TaxExemption.Category
    }

    // Kratak prikaz u padajućem — KeyClan + referenca (čl./st./tač.) + skraćen tekst.
    private static string OpisClana(TaxExemption c)
    {
        var delovi = new List<string>();
        if (!string.IsNullOrWhiteSpace(c.Article))   delovi.Add($"čl. {c.Article}");
        if (!string.IsNullOrWhiteSpace(c.Paragraph)) delovi.Add($"st. {c.Paragraph}");
        if (!string.IsNullOrWhiteSpace(c.Point))     delovi.Add($"tač. {c.Point}");

        var referenca   = string.Join(" ", delovi);
        var kratakTekst = string.IsNullOrWhiteSpace(c.Text)
            ? ""
            : (c.Text.Length > 40 ? c.Text[..40] + "…" : c.Text);

        var opis = string.Join(" — ", new[] { referenca, kratakTekst }.Where(x => !string.IsNullOrWhiteSpace(x)));
        return string.IsNullOrWhiteSpace(opis) ? (c.KeyClan ?? "") : $"{c.KeyClan} ({opis})";
    }

    private void OnKoristiViseClanovaChanged(bool v)
    {
        _koristiViseClanova = v;

        if (v)
        {
            if (_izabraniClanovi.Count < 2)
                _izabraniClanovi.Add(new ClanOslobodjenjaVM());
        }
        else if (_izabraniClanovi.Count > 1)
        {
            _izabraniClanovi.RemoveRange(1, _izabraniClanovi.Count - 1);
        }

        AzurirajOslobodjenjeSlova();
    }

    // slotIdx: 0 = prvi padajući (uvek postoji), 1 = drugi (samo kad je checkbox uključen).
    // Ista kategorija (slovo) ne sme biti na oba slota — SEF pravilo: 1 član po slovu.
    private void OnClanChanged(int slotIdx, string? v)
    {
        if (slotIdx == 1 && !_koristiViseClanova) return;

        var noviId    = int.TryParse(v, out var id) ? id : (int?)null;
        var novi      = _clanoviOslobodjenja.FirstOrDefault(c => c.ReasonId == noviId);
        var novoSlovo = novi?.Category ?? "";

        var drugiSlotIdx = slotIdx == 0 ? 1 : 0;
        var drugoSlovo   = drugiSlotIdx < _izabraniClanovi.Count ? _izabraniClanovi[drugiSlotIdx].Slovo : null;

        if (!string.IsNullOrWhiteSpace(novoSlovo) && novoSlovo == drugoSlovo)
        {
            Snackbar.Add("Ista PDV kategorija ne može imati dva člana.", Severity.Warning);
            return;
        }

        if (slotIdx >= _izabraniClanovi.Count)
            _izabraniClanovi.Add(new ClanOslobodjenjaVM());

        _izabraniClanovi[slotIdx].ReasonId = novi?.ReasonId;
        _izabraniClanovi[slotIdx].KeyClan  = novi?.KeyClan;
        _izabraniClanovi[slotIdx].Slovo    = novoSlovo;

        AzurirajOslobodjenjeSlova();
    }

    private void OnStopaChanged(StavkaVM stavka, string? v)
    {
        stavka.Stopa = decimal.TryParse(v, out var n) ? n : 20m;
        AzurirajOslobodjenjeSlova();
        AzurirajNastanakPdvObaveze();
    }

    // Primena slova na 0% stavke: jedan član -> svima automatski to slovo; dva
    // člana -> default prvi, korisnik po stavci bira između dva; nevalidno slovo
    // (npr. posle promene člana/checkbox-a) vraća se na prvi član.
    private void AzurirajOslobodjenjeSlova()
    {
        var slovaAktivna = AktivnaSlova;
        var prvoSlovo    = slovaAktivna.FirstOrDefault() ?? "";

        foreach (var s in Stavke.Where(s => s.Stopa == 0))
        {
            if (!slovaAktivna.Contains(s.OslobodjenjeSlovo))
                s.OslobodjenjeSlovo = prvoSlovo;
        }
    }

    // ── Avans — izbor postojećih avansnih računa (istog kupca) da se odbiju od
    // nove fakture. Samo unos podataka u memoriji — glavni obračun fakture
    // (TaxTotal/Sume/stavke) se ovde ne dira, builder ih koristi kasnije. ──────
    private List<DostupanAvansVM>  _dostupniAvansi = [];
    private List<IzabraniAvansVM>  _izabraniAvansi = [];
    private bool                   _ucitavaAvanse;

    // Sve SEF kategorije za fallback prikaz (avans bez sačuvanih stavki) — isti
    // skup kao stavke tabela. Van S20/S10 stopa je uvek 0 za PDV auto-obračun
    // (isto pravilo kao StavkaVM.Pdv — AE10/AE20 ne obračunavaju PDV ovde).
    private static readonly (string Slovo, decimal Stopa)[] SveKategorijeOslobodjenja =
    [
        ("S20", 20m), ("S10", 10m), ("AE10", 0m), ("AE20", 0m), ("O", 0m),
        ("E", 0m), ("R", 0m), ("Z", 0m), ("SS", 0m), ("OE", 0m), ("N", 0m)
    ];

    private class DostupanAvansVM
