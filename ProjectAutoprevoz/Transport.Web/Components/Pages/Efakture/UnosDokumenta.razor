    private string _smanjenjeOdnosiSeNa     = "Pojedinačna faktura"; // ili "Pojedinačna avansna faktura" / "Fakture u periodu"
    private bool   _smanjenjeNijeRegistrovano;
    private string _smanjenjePeriodOd       = "";
    private string _smanjenjePeriodDo       = "";
    private string _smanjenjeDatumSmanjenja = DateTime.Today.ToString("yyyy-MM-dd");

    private bool                   _ucitavaSmanjenjeFakture;
    private List<IzvornaFakturaVM> _smanjenjeDostupneFakture = [];
    private string?                _smanjenjeOdabranaFakturaId;
    private List<IzvornaFakturaVM> _smanjenjeIzabraneFakture = [];

