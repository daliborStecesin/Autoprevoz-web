    protected override async Task OnInitializedAsync()
    {
        if (!TenantService.IsAuthenticated()) { Nav.NavigateTo("/login"); return; }

        _sviPartneri = await Db.Partneri.AsNoTracking().OrderBy(p => p.Naziv).ToListAsync();
        _sveBanke    = await Db.Banke.AsNoTracking().Where(b => b.aktivan == 1).OrderBy(b => b.idBanke).ToListAsync();
        _clanoviOslobodjenja = await Db.TaxExemptions.AsNoTracking()
            .Where(t => t.Koristi == 1).OrderBy(t => t.KeyClan).ToListAsync();

        await UcitajIzIzvora();
    }

    // Dispatch po izvoru — dodavanje avans/knjizno prefill-a kasnije je samo
    // novi case ovde, bez diranja ostatka stranice.
    private async Task UcitajIzIzvora()
    {
        _izvor   = QIzvor;
        _izvorId = QId;

        int? idBankeSaRacuna = null;

        switch (_izvor)
        {
            case "racun":
                if (_izvorId is not null)
                    idBankeSaRacuna = await PrefillIzRacuna(_izvorId.Value);
                break;
            case "avans":
                // Prefill iz avansa — kasnije.
                break;
            case "knjizno":
                // Prefill iz knjižnog odobrenja/zaduženja — kasnije.
                break;
            default:
                // Bez izvora — prazna forma, kao i do sad.
                break;
        }

        if (!string.IsNullOrWhiteSpace(QTip))
            _model.TipDokumenta = QTip;

        AzurirajDefaultBanku(idBankeSaRacuna);
    }

    // Čita račun i stavke (READ-ONLY) i popunjava memorijski model. Ništa se ne
    // upisuje u bazu. Vraća idBanke sa računa (za default žiro računa), ili null
    // ako prefill nije urađen (nema računa / inostrani račun).
    private async Task<int?> PrefillIzRacuna(int idRacuna)
    {
        var racun = await Db.Racuni.AsNoTracking().FirstOrDefaultAsync(r => r.Broj == idRacuna);
        if (racun is null)
        {
            Snackbar.Add($"Račun #{idRacuna} nije pronađen.", Severity.Warning);
            return null;
        }

        // Druga brana (i na formi računa je dugme disabled za INOSTRANI, ali
        // proveravamo i ovde jer se na ovu formu može doći i direktnim linkom).
        if (racun.TipProdaje == "INOSTRANI")
        {
            Snackbar.Add("Inostrani račun se ne može poslati na SEF.", Severity.Warning);
            return null;
        }

        var stavkeRacuna = await Db.ArtikliRacuna.AsNoTracking()
            .Where(s => s.Id_Racuna == racun.Broj.ToString())
            .ToListAsync();

        // Glava
        _model.TipDokumenta     = "FAKTURA";
        _model.BrojDokumenta    = racun.BrojRacuna ?? "";
        _model.PozivNaBroj      = racun.BrojRacuna ?? "";
        _model.BrojNarudzbenice = racun.FiskIsecak ?? "";
        _model.DatumPrometa     = racun.DatumPrometa?.ToString("yyyy-MM-dd") ?? _model.DatumPrometa;
        _model.DatumValute      = racun.DatumValute?.ToString("yyyy-MM-dd") ?? _model.DatumValute;
        _model.Komentar         = racun.Komentar1 ?? "";
        _model.Vozilo           = racun.Vozilo ?? "";
        _model.BrojCmr          = racun.Otpremnica ?? ""; // CMR / Otpremnica na formi računa

        // Partner — fiksan sa računa (autocomplete se zaključava)
        _model.Naziv = racun.Naziv ?? "";
        _model.Pib   = racun.PIB ?? "";
        var partner = racun.IdPartnera is not null
            ? _sviPartneri.FirstOrDefault(p => p.Broj == racun.IdPartnera)
            : null;
        _model.MaticniBroj = partner?.PosBroj ?? "";

        // JBKJS se čuva u koloni Sifra (isto kao PartnerDialog.razor). Ako postoji,
        // popuni JBKJS i čekiraj CRF; ako ne, ostavi prazno/nečekirano.
        var jbkjs = partner?.Sifra;
        _model.Jbkjs     = jbkjs ?? "";
        _model.SaljiUCrf = !string.IsNullOrWhiteSpace(jbkjs);

        // Stavke
        Stavke = stavkeRacuna.Count > 0
            ? [.. stavkeRacuna.Select(MapirajStavkuRacuna)]
            : [new StavkaVM()];

        // Zamenjuje raniju logiku (OpcijaString11/pdvDatumObracuna fallback) —
        // "Nastanak PDV obaveze" se sad izvodi iz stavki (ima/nema PDV).
        AzurirajNastanakPdvObaveze();

        // Predizbor člana zakona za oslobođenje (samo ako panel treba da se prikaže)
        var reasonId = (racun.TipProdaje, racun.UvozIzvoz) switch
        {
            ("IZLAZ_BP", "IZVOZ") => 82,
            ("IZLAZ_BP", "UVOZ")  => 73,
            _                     => (int?)null
        };

        var predizabraniClan = reasonId is null ? null : _clanoviOslobodjenja.FirstOrDefault(c => c.ReasonId == reasonId);
        if (predizabraniClan is not null)
        {
            _izabraniClanovi[0].ReasonId = predizabraniClan.ReasonId;
            _izabraniClanovi[0].KeyClan  = predizabraniClan.KeyClan;
            _izabraniClanovi[0].Slovo    = predizabraniClan.Category ?? "";
        }

        AzurirajOslobodjenjeSlova();

        _izvorRacunLocked = true;

        return racun.IdBanke;
    }

    private static StavkaVM MapirajStavkuRacuna(Stavka s)
    {
        var cena     = s.CenaPoJMBP ?? 0;
        var kolicina = s.Kolicina ?? 0;

        // VrednostMinusRab je NETO vrednost (osnovica), ne iznos rabata — pravi
        // rabat se dobija oduzimanjem stvarne osnovice sa računa od bruto iznosa
        // (bez rabata daje 0, sa rabatom tačan iznos).
        var umanjenje = (cena * kolicina) - (s.Osnovica ?? 0);

        return new StavkaVM
        {
            Sifra     = s.Barcode ?? "",
            Naziv     = s.Artikal ?? "",
            Jm        = s.JM ?? "kom",
            Kolicina  = kolicina,
            Cena      = cena,
            Umanjenje = umanjenje,
            Stopa     = s.StopaPDV ?? 0
        };
    }

    // Default banka: žiro računa sa učitanog računa (ako postoji u aktivnim
    // bankama), inače podrazumevana banka (defaultRacun) ili prva po redu —
    // isti fallback kao AzurirajDefaultBanku u /fakture/unos.
    private void AzurirajDefaultBanku(int? idBankeSaRacuna)
    {
        if (idBankeSaRacuna is not null && _sveBanke.Any(b => b.idBanke == idBankeSaRacuna))
        {
            _model.IdBanke = idBankeSaRacuna;
            return;
        }

        var izbor = _sveBanke.OrderByDescending(b => b.defaultRacun).ThenBy(b => b.idBanke).FirstOrDefault();
        _model.IdBanke = izbor?.idBanke;
    }

    private static string OpisBanke(Banka b)
    {
        var racunPrikaz = b.TipRacuna == "INOSTRANI" ? (b.IBAN ?? b.racun) : b.racun;
        return $"{b.banka} — {racunPrikaz}";
    }

    // Mapiranje naših 4 opcije "Tip dokumenta" na desktop tipove/brojače
    // (tbl_Podesavanja): AVANSNI RAČUN -> Broj_Dok_2, KNJIZNO ODOBRENJE (KO) ==
    // DOKUMENT O SMANJENJU -> Broj_Dok_1, KNJIZNO ZADUŽENJE (KZ) == DOKUMENT O
    // POVECANJU -> Broj_Dok_3 (ista ekvivalencija terminologije kao Izlazne
    // e-fakture). FAKTURA nema sopstveni brojač ovde — broj dolazi iz računa.
    // NAPOMENA: vrednost mora biti BEZ Ć ("DOKUMENT O POVECANJU"), isto kao svuda
    // drugde u projektu (Izlazne/Ulazne liste, sync mapiranje) — sa Ć bi ovaj red
    // bio nevidljiv/nekonzistentan sa ostatkom sistema (isti bag kao Avans/AVANSNA
    // FAKTURA ranije).
    private static int? BrojacZaTip(Podesavanja? pod, string tipDokumenta) => tipDokumenta switch
    {
        "AVANSNA FAKTURA"      => pod?.Broj_Dok_2,
        "DOKUMENT O SMANJENJU" => pod?.Broj_Dok_1,
        "DOKUMENT O POVECANJU" => pod?.Broj_Dok_3,
        _                      => null
    };

    private bool JeAvansDokument => _model.TipDokumenta == "AVANSNA FAKTURA";
    private bool JePovecanjeDokument => _model.TipDokumenta == "DOKUMENT O POVECANJU";
    private bool JeSmanjenjeDokument => _model.TipDokumenta == "DOKUMENT O SMANJENJU";

    // Ukupan broj kolona u tabeli stavki — za "Nema stavki" colspan. Avans skida
    // kolonu Umanjenje (-1), 2 aktivna slova oslobođenja dodaju kolonu (+1).
    private int BrojKolonaStavki => (JeAvansDokument ? 12 : 13) + (PrikaziKolonuSlovo ? 1 : 0);

    private async Task OnTipDokumentaChanged(string? v)
    {
        _model.TipDokumenta = v ?? "FAKTURA";
        AzurirajZaTipDokumenta();
        await PredloziBrojDokumenta();

        if (JePovecanjeDokument && _povecanjeOdnosiSeNa == "Pojedinačna faktura" && !_povecanjeNijeRegistrovano)
            await UcitajDostupneIzvorneFakture();

        if (JeSmanjenjeDokument && _smanjenjeOdnosiSeNa is "Pojedinačna faktura" or "Pojedinačna avansna faktura"
            && !_smanjenjeNijeRegistrovano)
            await UcitajDostupneSmanjenjeFakture();
    }

    // AVANSNA FAKTURA menja ponašanje stavki (Kolicina fiksna 1, Umanjenje se ne
    // koristi, obrnut obračun Osnovica/PDV iz "Iznos uplate") i uvek ima PDV
    // obavezu po datumu plaćanja (ne po stavkama). Ostali tipovi — bez izmena,
    // normalna auto-logika se ponovo primeni pri izlasku iz avansa.
    private void AzurirajZaTipDokumenta()
    {
        var jeAvans = JeAvansDokument;

        foreach (var s in Stavke)
        {
            s.JeAvans = jeAvans;
            if (jeAvans)
            {
                s.Kolicina  = 1m;
                s.Umanjenje = 0m;
            }
        }

        if (jeAvans)
            _model.NastanakPdvObaveze = "Datum plaćanja";
        else
            AzurirajNastanakPdvObaveze();

        AzurirajOslobodjenjeSlova();
    }

    // Predlog broja dokumenta iz brojača u podešavanjima — SAMO za ručni unos
    // (bez izvornog računa) i SAMO za tipove koji imaju sopstveni brojač
    // (Avans/KO/KZ). Format: "{brojac}-{poslednje 2 cifre godine}". Ne
    // inkrementira ništa — samo predlog, polje ostaje editabilno. Ako brojač
    // nije dostupan (null/greška), ne blokira formu — polje ostaje prazno.
    private async Task PredloziBrojDokumenta()
    {
        if (_izvor == "racun") return; // broj dolazi iz računa, ne diramo

        try
        {
            var pod = await Db.Podesavanja.AsNoTracking().FirstOrDefaultAsync();
            var brojac = BrojacZaTip(pod, _model.TipDokumenta);
            if (brojac is null) return;

            var godina2 = (DateTime.Today.Year % 100).ToString("00");
            _model.BrojDokumenta = $"{brojac}-{godina2}";
        }
        catch
        {
            // Brojač nedostupan — ostavi polje kako jeste (ručni upis).
        }
    }

    private bool    _saljem;
    private string? _poslatSalesInvoiceId;

    // Forma se zaključava TEK posle uspešnog slanja (ima SalesInvoiceId) — sprečava
    // duplo slanje i dalje izmene dokumenta koji je već na SEF-u.
    private bool FormaZakljucana => _poslatSalesInvoiceId is not null;

    // ── Prateća dokumenta (PDF, max 3) — Base64 konverzija ODMAH pri dodavanju,
    // sve u memoriji, bez baze. Šalju se ugrađeni u UBL (EFakturaUblBuilder). ──
    private bool          _prikaziPriloge;
    private List<PrilogVM> _prilozi = [];

    private const long MaxPrilogBajta  = 25 * 1024 * 1024;
    private const int  MaxDuzinaImena  = 45;

    private async Task DodajPrilog(IBrowserFile file)
    {
        if (_prilozi.Count >= 3)
        {
            Snackbar.Add("Maksimalno 3 priloga po dokumentu.", Severity.Warning);
            return;
        }

        var jePdf = file.ContentType == "application/pdf"
                    || file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
        if (!jePdf)
        {
            Snackbar.Add("Dozvoljeni su samo PDF fajlovi.", Severity.Warning);
            return;
        }

        if (file.Size > MaxPrilogBajta)
        {
            Snackbar.Add("Fajl je veći od dozvoljenih 25 MB.", Severity.Warning);
            return;
        }

        if (file.Name.Length > MaxDuzinaImena)
        {
            Snackbar.Add($"Naziv fajla je predugačak (maksimalno {MaxDuzinaImena} znakova).", Severity.Warning);
            return;
        }

        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: MaxPrilogBajta).CopyToAsync(ms);

            _prilozi.Add(new PrilogVM
            {
                ImeFajla     = file.Name,
                VelicinaByte = ms.Length,
                Base64       = Convert.ToBase64String(ms.ToArray())
            });
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri učitavanju priloga: {ex.Message}", Severity.Error);
        }
    }

    private void UkloniPrilog(PrilogVM p) => _prilozi.Remove(p);

    private static string FormatVelicina(long bajta) =>
        bajta < 1024 * 1024 ? $"{bajta / 1024.0:N0} KB" : $"{bajta / 1024.0 / 1024.0:N2} MB";

    private class PrilogVM
    {
        public string ImeFajla { get; set; } = "";
        public long   VelicinaByte { get; set; }
        public string Base64 { get; set; } = "";
    }

    // Builder podržava sve 4 opcije Tip dokumenta (FAKTURA, AVANSNA FAKTURA,
    // DOKUMENT O POVECANJU, DOKUMENT O SMANJENJU — S2). Oslobođene (0%) stavke SU
    // podržane (C2). Zajednička provera i za Izvoz XML i za Pošalji (obe idu kroz
    // isti builder).
    private string? ProveriBuilderOgranicenja()
    {
        // Datum povećanja - ugovor ne sme biti u budućnosti u odnosu na datum izdavanja
        // (danas).
        if (JePovecanjeDokument && PovecanjeNastanakPdv == "PDV se obračunava"
            && _povecanjeVrstaDatuma == "Datum povećanja - ugovor")
        {
            var datumUgovora = ParsirajDatum(_povecanjeDatumUgovor);
            if (datumUgovora is not null && datumUgovora.Value.Date > DateTime.Today)
                return "Datum povećanja - ugovor ne može biti veći od datuma izdavanja.";
        }

        if (_model.TipDokumenta is not ("FAKTURA" or "AVANSNA FAKTURA" or "DOKUMENT O POVECANJU" or "DOKUMENT O SMANJENJU"))
            return "Ova akcija trenutno podržava samo tip dokumenta FAKTURA, AVANSNA FAKTURA, DOKUMENT O POVECANJU ili DOKUMENT O SMANJENJU.";

        if (Stavke.Count == 0)
            return "Dodajte bar jednu stavku.";

        return null;
    }

    private async Task IzvozXml()
    {
        var greska = ProveriBuilderOgranicenja();
        if (greska is not null)
        {
            Snackbar.Add(greska, Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.BrojDokumenta))
        {
            Snackbar.Add("Unesite broj dokumenta pre izvoza.", Severity.Warning);
            return;
        }

        var input      = await PripremiUblInput();
        var xml        = UblBuilder.Build(input);
        var nazivFajla = $"RACUN_{(_model.BrojDokumenta ?? "").Replace("/", "")}.xml";

        await JS.InvokeVoidAsync("downloadTextFile", nazivFajla, xml);
        Snackbar.Add("XML generisan.", Severity.Success);
    }

    // ── Pošalji na SEF (DEMO/PROD prema podešavanjima) — bez upisa u bazu, to je
    // sledeći korak. Validacije 1:1 prema specifikaciji, zatim potvrda pa slanje. ──
    private async Task Posalji()
    {
        // Idempotencija — već poslato, dugme je i vizuelno disabled ali provera
        // ostaje i ovde (npr. ako je klik već bio u letu kad je stanje promenjeno).
        if (FormaZakljucana) return;

        var greska = ValidirajZaSlanje();
        if (greska is not null)
        {
            Snackbar.Add(greska, Severity.Warning);
            return;
        }

        var potvrda = await Dialog.ShowMessageBox(
            "Slanje e-fakture",
            "Da li želite da pošaljete račun na sistem E-Faktura?",
            yesText: "Da", cancelText: "Ne");
        if (potvrda != true) return;

        _saljem = true; StateHasChanged();
        try
        {
            var input = await PripremiUblInput();
            var xml   = UblBuilder.Build(input);

            // tbl_eInvoice ima SAMO jednu kolonu za oslobođenje (idPoreskoOslobodjenje/
            // clanPoreskogOslobodjenje) — kad ima 2 člana, upisuje se prvi; upis za
            // više članova čeka proširenje šeme (van obima ovog koraka).
            var glavniClan = _izabraniClanovi[0];
            var kontekst = new EFakturaSlanjeKontekst
            {
                IdRacuna            = _izvor == "racun" ? _izvorId : null,
                IdClanOslobodjenja  = glavniClan.ReasonId,
                KeyClanOslobodjenja = glavniClan.KeyClan,
                Korisnik            = TenantService.GetImeKorisnika(),
                Model               = _model.Model,
                TipDokumenta        = _model.TipDokumenta
            };

            var (uspesno, poruka, salesInvoiceId, _, _) =
                await EFaktureService.PosaljiUblAsync(xml, _model.SaljiUCrf, input, kontekst);

            if (uspesno)
            {
                _poslatSalesInvoiceId = salesInvoiceId;
                Snackbar.Add($"Dokument uspešno poslat. SalesInvoiceId: {salesInvoiceId}", Severity.Success);
            }
            else
            {
                Snackbar.Add(poruka, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri slanju: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
        }
        finally
        {
            _saljem = false;
            StateHasChanged();
        }
    }

    private static string OcistiNazivFajla(string? brojDokumenta) =>
        (brojDokumenta ?? "dokument").Replace("/", "").Replace("\\", "");

    private async Task PreuzmiPdf()
    {
        if (_poslatSalesInvoiceId is null) return;

        try
        {
            var bytes = await EFaktureService.PreuzmiPdfAsync(_poslatSalesInvoiceId);
            if (bytes is null)
            {
                Snackbar.Add("Dokument je verovatno još u obradi, pokušajte malo kasnije", Severity.Warning);
                return;
            }

            var naziv = $"Racun_{OcistiNazivFajla(_model.BrojDokumenta)}.pdf";
            var b64   = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadFilePdf", naziv, b64);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri preuzimanju PDF-a: {ex.Message}", Severity.Error);
        }
    }

    private async Task PrikazStampa()
    {
        if (_poslatSalesInvoiceId is null) return;

        try
        {
            var bytes = await EFaktureService.PreuzmiPdfAsync(_poslatSalesInvoiceId);
            if (bytes is null)
            {
                Snackbar.Add("Dokument je verovatno još u obradi, pokušajte malo kasnije", Severity.Warning);
                return;
            }

            var b64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("openPdfPreview", b64);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška pri pregledu PDF-a: {ex.Message}", Severity.Error);
        }
    }

    private string? ValidirajZaSlanje()
    {
        if (string.IsNullOrWhiteSpace(_model.TipDokumenta))
            return "Izaberite tip dokumenta.";

        if ((_model.BrojDokumenta ?? "").Trim().Length < 3)
            return "Broj dokumenta mora imati bar 3 znaka.";

        if ((_model.Naziv ?? "").Trim().Length < 3)
            return "Naziv kupca mora imati bar 3 znaka.";

        if (string.IsNullOrWhiteSpace(_model.Pib))
            return "Unesite PIB kupca.";

        if (string.IsNullOrWhiteSpace(_model.MaticniBroj))
            return "Unesite matični broj kupca.";

        if (_model.TipDokumenta == "FAKTURA")
        {
            var datumPrometa = ParsirajDatum(_model.DatumPrometa);
            if (datumPrometa is not null && datumPrometa.Value.Date > DateTime.Today)
                return "Datum prometa ne sme biti veći od današnjeg.";
        }

        if (!string.IsNullOrWhiteSpace(_model.Jbkjs)
            && string.IsNullOrWhiteSpace(_model.BrojUgovora)
            && string.IsNullOrWhiteSpace(_model.BrojNarudzbenice))
            return "Kupac ima JBKJS (javna ustanova) — unesite Broj ugovora ili Broj narudžbenice.";

        var stavkeBezPdv = Stavke.Where(s => s.Stopa == 0).ToList();
        if (stavkeBezPdv.Count > 0)
        {
            if (AktivnaSlova.Count == 0)
                return "Ako postoji stavka bez PDV-a, obavezno je odabrati član oslobođenja.";

            foreach (var slovo in AktivnaSlova)
            {
                if (!stavkeBezPdv.Any(s => s.OslobodjenjeSlovo == slovo))
                    return $"Nije upotrebljena '{slovo}' kategorija oslobođenja.";
            }

            foreach (var s in stavkeBezPdv)
            {
                if (!AktivnaSlova.Contains(s.OslobodjenjeSlovo))
                    return "Svaka stavka bez PDV-a mora imati kategoriju oslobođenja iz izabranog člana.";
            }
        }

        return ProveriBuilderOgranicenja();
    }

    private async Task<EFakturaUblInput> PripremiUblInput()
    {
        var firma   = await Db.PodaciFirme.AsNoTracking().FirstOrDefaultAsync();
        var banka   = _sveBanke.FirstOrDefault(b => b.idBanke == _model.IdBanke);
        var partner = _sviPartneri.FirstOrDefault(p => p.PIB == _model.Pib);

        return new EFakturaUblInput
        {
            ProdavacNaziv         = firma?.NazivFirme ?? "",
            ProdavacPib           = firma?.PIB ?? "",
            ProdavacAdresa        = firma?.Adresa ?? "",
            ProdavacMesto         = firma?.Mesto ?? "",
            ProdavacPostanskiBroj = firma?.PosBroj ?? "",
            ProdavacMaticniBroj   = firma?.MaticniBroj ?? "",

            KupacNaziv       = _model.Naziv,
            KupacPib         = _model.Pib,
            KupacMaticniBroj = _model.MaticniBroj,
            KupacJbkjs       = string.IsNullOrWhiteSpace(_model.Jbkjs) ? null : _model.Jbkjs,
            // Partner entitet nema poštanski broj — KupacPostanskiBroj ostaje prazno.
            KupacAdresa      = partner?.Adresa,
            KupacMesto       = partner?.Mesto,

            TipDokumenta           = _model.TipDokumenta,
            BrojDokumenta          = _model.BrojDokumenta,
            DatumValute            = ParsirajDatum(_model.DatumValute),
            DatumPrometa           = ParsirajDatum(_model.DatumPrometa),
            InterniBrojZaRutiranje = _model.InterniBrojZaRutiranje,
            NastanakPdvObaveze     = _model.NastanakPdvObaveze,
            BrojNarudzbenice       = _model.BrojNarudzbenice,
            BrojTendera            = _model.BrojTendera,
            BrojUgovora            = _model.BrojUgovora,
            Vozilo                 = _model.Vozilo,
            BrojCmr                = _model.BrojCmr,
            Komentar               = _model.Komentar,
            PozivNaBroj            = _model.PozivNaBroj,
            ZiroRacunIzdavaoca     = banka?.racun ?? "",

            Stavke = [.. Stavke.Select(s => new EFakturaUblStavka
            {
                Sifra         = s.Sifra,
                Naziv         = s.Naziv,
                Jm            = s.Jm,
                Kolicina      = s.Kolicina,
                Cena          = s.Cena,
                Umanjenje     = s.Umanjenje,
                Osnovica      = s.Osnovica,
                PdvKategorija = s.PdvKategorija,
                PdvProcenat   = s.PdvProcenat,
                Pdv           = s.Pdv,
                Ukupno        = s.Ukupno
            })],

            // Već gotov Base64 iz memorije — nula konverzije u ovom trenutku.
            Prilozi = [.. _prilozi.Select(p => new EFakturaUblPrilog
            {
                ImeFajla = p.ImeFajla,
                Base64   = p.Base64
            })],

            // Slovo -> KeyClan izabranih članova (do 2) — builder ih koristi za
            // TaxExemptionReasonCode po grupi u TaxTotal-u.
            Oslobodjenja = [.. _izabraniClanovi
                .Where(c => !string.IsNullOrWhiteSpace(c.Slovo) && !string.IsNullOrWhiteSpace(c.KeyClan))
                .Select(c => new EFakturaUblOslobodjenje { Slovo = c.Slovo!, KeyClan = c.KeyClan! })],

            // Avansi izabrani u panelu "Odaberite avansne račune" — builder sam
            // filtrira kategorije bez iskorišćenog iznosa (>0) i ignoriše avans
            // ako mu nijedna kategorija nema uneti iznos.
            IzabraniAvansi = [.. _izabraniAvansi.Select(a => new EFakturaUblIzabraniAvans
            {
                BrojDokumenta  = a.BrojDokumenta,
                DatumIzdavanja = a.DatumIzdavanja,
                Kategorije = [.. a.Kategorije.Select(k => new EFakturaUblAvansKategorija
                {
                    Slovo              = k.Slovo,
                    Stopa              = k.Stopa,
                    IskorisenaOsnovica = k.IskorisenoOsnovica,
                    IskorisenPdv       = k.IskorisenoPdv
                })]
            })],

            // Dokument o povećanju — polja se prosleđuju SAMO za taj tip dokumenta.
            PovecanjeOdnosiSeNa    = JePovecanjeDokument ? _povecanjeOdnosiSeNa : null,
            PovecanjeNastanakPdv   = JePovecanjeDokument ? PovecanjeNastanakPdv : null,
            PovecanjeVrstaDatuma   = JePovecanjeDokument ? _povecanjeVrstaDatuma : null,
            PovecanjeDatumUgovor   = JePovecanjeDokument ? ParsirajDatum(_povecanjeDatumUgovor) : null,
            PovecanjePeriodOd      = JePovecanjeDokument ? ParsirajDatum(_povecanjePeriodOd) : null,
            PovecanjePeriodDo      = JePovecanjeDokument ? ParsirajDatum(_povecanjePeriodDo) : null,

            // Samo jedan od ova dva spiska ima sadržaj u isto vreme (checkbox
            // "nije registrovano" prebacuje mod i čisti onaj drugi — vidi
            // OnPovecanjeNijeRegistrovanoChanged), pa je bezbedno spojiti ih.
            PovecanjeIzvorneFakture = JePovecanjeDokument && _povecanjeOdnosiSeNa == "Pojedinačna faktura"
                ? [
                    .. _izabraneIzvorneFakture.Select(f => new EFakturaUblIzvornaFaktura
                    {
                        BrojDokumenta  = f.BrojDokumenta,
                        DatumIzdavanja = f.DatumIzdavanja
                    }),
                    .. _rucneIzvorneFakture.Select(broj => new EFakturaUblIzvornaFaktura
                    {
                        BrojDokumenta  = broj,
                        DatumIzdavanja = null
                    })
                  ]
                : [],

            // Dokument o smanjenju — polja se prosleđuju SAMO za taj tip dokumenta.
            SmanjenjeOdnosiSeNa     = JeSmanjenjeDokument ? _smanjenjeOdnosiSeNa : null,
            SmanjenjeDatumSmanjenja = JeSmanjenjeDokument ? ParsirajDatum(_smanjenjeDatumSmanjenja) : null,
            SmanjenjePeriodOd       = JeSmanjenjeDokument ? ParsirajDatum(_smanjenjePeriodOd) : null,
            SmanjenjePeriodDo       = JeSmanjenjeDokument ? ParsirajDatum(_smanjenjePeriodDo) : null,

            // Samo jedan od ova dva spiska ima sadržaj u isto vreme (checkbox
            // "nije registrovano" prebacuje mod i čisti onaj drugi).
            SmanjenjeIzvorneFakture = JeSmanjenjeDokument
                && _smanjenjeOdnosiSeNa is "Pojedinačna faktura" or "Pojedinačna avansna faktura"
                ? [
                    .. _smanjenjeIzabraneFakture.Select(f => new EFakturaUblIzvornaFaktura
                    {
                        BrojDokumenta  = f.BrojDokumenta,
                        DatumIzdavanja = f.DatumIzdavanja
                    }),
                    .. _smanjenjeRucneFakture.Select(broj => new EFakturaUblIzvornaFaktura
                    {
                        BrojDokumenta  = broj,
                        DatumIzdavanja = null
                    })
                  ]
                : []
        };
    }

    private static DateTime? ParsirajDatum(string? iso) =>
        DateTime.TryParseExact(iso, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var d) ? d : null;

    private void AzurirajPartnerPredloge()
    {
        _partneriPredlozi = string.IsNullOrWhiteSpace(_model.Naziv)
            ? [.. _sviPartneri]
            : [.. _sviPartneri.Where(p => (p.Naziv ?? "").Contains(_model.Naziv, StringComparison.OrdinalIgnoreCase))];
    }

    private void OnPartnerFocusin()
    {
        _partnerOpen = true;
        AzurirajPartnerPredloge();
    }

    private async Task OnPartnerFocusout()
    {
        await Task.Delay(150);
        _partnerOpen = false;
        StateHasChanged();
    }

    // Matični broj partnera se čuva u koloni PosBroj (isto kao PartnerDialog.razor).
    // Partner entitet nema JBKJS kolonu — ostaje ručni unos, "Šalji u CRF" se ne dira.
    private void IzaberiPartnera(Partner p)
    {
        _model.Naziv       = p.Naziv ?? "";
        _model.Pib         = p.PIB ?? "";
        _model.MaticniBroj = p.PosBroj ?? "";

        _partnerOpen      = false;
        _partneriPredlozi = [];
    }

    // ── Stavke ────────────────────────────────────────────────────────────
    private List<StavkaVM> Stavke = [new()];

    private decimal SumaOsnovica => Stavke.Sum(s => s.Osnovica);
    private decimal SumaRabat     => Stavke.Sum(s => s.Umanjenje);
    private decimal SumaPdv       => Stavke.Sum(s => s.Pdv);
    private decimal SumaRacuna    => Stavke.Sum(s => s.Ukupno);

    private void DodajStavku()
    {
        var jeAvans = JeAvansDokument;
        Stavke.Add(new StavkaVM { JeAvans = jeAvans, Kolicina = jeAvans ? 1m : 0m });
        AzurirajNastanakPdvObaveze();
        AzurirajOslobodjenjeSlova();
    }

    private void ObrisiStavku(int idx)
    {
        if (idx >= 0 && idx < Stavke.Count)
            Stavke.RemoveAt(idx);

        AzurirajNastanakPdvObaveze();
        AzurirajOslobodjenjeSlova();
    }

    // Auto-logika za "Nastanak PDV obaveze izdavaoca" — reaguje na stavke (prefill
    // i svaka izmena). Ima osnovicu ali nema PDV -> "Ne nastaje PDV obaveza". Ima
    // PDV -> ako je trenutno prazno/"Ne nastaje..." postavi "Datum prometa", inače
    // ne diraj ručan izbor korisnika (Datum plaćanja/Datum izdavanja). AVANSNA
    // FAKTURA je izuzetak — uvek "Datum plaćanja", ne diramo je odavde (postavlja
    // se i zaključava u AzurirajZaTipDokumenta).
    private void AzurirajNastanakPdvObaveze()
    {
        if (JeAvansDokument) return;

        var osnovica = SumaOsnovica;
        var pdv      = SumaPdv;

        if (osnovica != 0 && pdv == 0)
        {
            _model.NastanakPdvObaveze = "Ne nastaje PDV obaveza";
        }
        else if (pdv != 0 && (string.IsNullOrWhiteSpace(_model.NastanakPdvObaveze) || _model.NastanakPdvObaveze == "Ne nastaje PDV obaveza"))
        {
            _model.NastanakPdvObaveze = "Datum prometa";
        }
    }

    private class StavkaVM
    {
        public string Sifra { get; set; } = "";
        public string Naziv { get; set; } = "";
        public string Jm { get; set; } = "kom";
        public decimal Kolicina { get; set; }
        public decimal Cena { get; set; }
        public decimal Umanjenje { get; set; }

        // Stopa PDV (20/10/0) — birano select-om po redu (jedini ručni izbor po
        // stavci). 0 znači "bez PDV" (oslobođenje).
        public decimal Stopa { get; set; } = 20m;

        // Slovo kategorije oslobođenja (Z/O/OE/E/AE/SS/R/N...) — relevantno SAMO
        // kad je Stopa==0, dolazi iz izabranog člana (panel), ne bira se slobodno
        // osim kad su aktivna 2 člana (tada bira između njih po stavci).
        public string OslobodjenjeSlovo { get; set; } = "";

        // AVANSNA FAKTURA: Kolicina fiksna 1, Umanjenje se ne koristi, Cena je
        // "Iznos uplate" (bruto/Ukupno direktno) — obrnut obračun, Osnovica/PDV
        // se izvlače IZ Ukupno umesto da ga grade.
        public bool JeAvans { get; set; }

        public decimal Osnovica => JeAvans
            ? Math.Round(Cena / (1 + Stopa / 100m), 2)
            : Kolicina * Cena - Umanjenje;

        public decimal PdvProcenat => Stopa;

        // Avans: PDV = razlika Ukupno-Osnovica (ne nezavisan proizvod) da zbir
        // bude tačan do pare. Normalno: proizvod Osnovica*stopa.
        public decimal Pdv => JeAvans
            ? Ukupno - Osnovica
            : (Stopa > 0 ? Osnovica * Stopa / 100m : 0m);

        public decimal Ukupno => JeAvans ? Cena : Osnovica + Pdv;

        // SEF kategorija — IZVEDENA, ne bira se ručno. S-stavke prate stopu
        // (20->S20, 10->S10); 0%-stavke nose slovo dodeljenog člana oslobođenja.
        public string PdvKategorija => Stopa switch
        {
            20m => "S20",
            10m => "S10",
            _   => OslobodjenjeSlovo
        };
    }

