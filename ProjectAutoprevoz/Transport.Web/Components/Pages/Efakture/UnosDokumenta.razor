@* ── PRILOZI — Base64 konverzija odmah pri dodavanju, sve u memoriji ──────── *@
@if (_prikaziPriloge)
{
    <MudPaper Elevation="1" Class="pa-3 mt-3">
        <div class="d-flex justify-space-between align-center mb-2">
