        if (!int.TryParse(_odabranaIzvornaFakturaId, out var id)) return;

        var izvor = _dostupneIzvorneFakture.FirstOrDefault(f => f.IdEfakture == id);
        if (izvor is null) return;

        _izabraneIzvorneFakture.Add(izvor);
        _dostupneIzvorneFakture.Remove(izvor);
        _odabranaIzvornaFakturaId = null;
    }

    private void UkloniIzabranuFakturu(IzvornaFakturaVM f)
    {
        _izabraneIzvorneFakture.Remove(f);
        _dostupneIzvorneFakture = [.. _dostupneIzvorneFakture, f];
        _dostupneIzvorneFakture = [.. _dostupneIzvorneFakture.OrderByDescending(x => x.DatumIzdavanja)];
    }

    private void DodajRucnuFakturu()
