    private async Task OnDodajAvansChanged(bool v)
    {
        _model.DodajAvans = v;

        if (v)
        {
            await UcitajDostupneAvanse();
        }
        else
        {
            _dostupniAvansi = [];
            _izabraniAvansi = [];
        }
    }

    // Avansi istog kupca (PIB), stvarno poslati na SEF — READ-ONLY.
    private async Task UcitajDostupneAvanse()
    {
        if (string.IsNullOrWhiteSpace(_model.Pib))
        {
            _dostupniAvansi = [];
            return;
        }

        _ucitavaAvanse = true;
        try
        {
            // "status" se popunjava SAMO pri direktnom slanju kroz ovu aplikaciju
            // (PosaljiUblAsync); sinhronizovani (SEF-učitani) avansi imaju samo
            // statusDokumenta. Avans je upotrebljiv ako je uspešno poslat/prihvaćen
            // na SEF bez obzira kroz koji tok je ušao u bazu — "Nepoznato"/"Odbijeno"
            // se isključuju kao nesiguran/neuspešan status.
            var lista = await Db.EInvoices.AsNoTracking()
                .Where(e => e.tipDokumenta == "AVANSNA FAKTURA" && e.pib == _model.Pib
                         && (e.status == "POSLATO" || e.statusDokumenta == "Poslato" || e.statusDokumenta == "Prihvaceno"))
                .OrderByDescending(e => e.invoiceDateUtc)
                .ToListAsync();

            _dostupniAvansi = [.. lista.Select(e => new DostupanAvansVM
            {
                IdEfakture     = e.idEfakture,
                InvoiceID      = e.invoiceID,
                BrojDokumenta  = e.brojDokumenta ?? "",
                DatumIzdavanja = e.invoiceDateUtc,
                BrutoIznos     = e.sumWithVat ?? 0
            })];
        }
        finally
        {
            _ucitavaAvanse = false;
        }
    }

    private async Task OnAvansIzabran(DostupanAvansVM avans, bool v)
    {
        avans.Izabran = v;

        if (v)
        {
            _izabraniAvansi.Add(await UcitajDetaljAvansa(avans));
        }
        else
        {
            _izabraniAvansi.RemoveAll(x => x.IdEfakture == avans.IdEfakture);
        }
    }

    private void UkloniIzabraniAvans(IzabraniAvansVM izabran)
    {
        _izabraniAvansi.Remove(izabran);

        var dostupan = _dostupniAvansi.FirstOrDefault(a => a.IdEfakture == izabran.IdEfakture);
        if (dostupan is not null) dostupan.Izabran = false;
    }

    // Stavke avansa idu preko tbl_lineItem.invoiceId — to je SEF InvoiceId (isti
    // izvor kao EInvoice.invoiceID varchar), NE invoiceIDint (taj je SalesInvoiceId,
    // pogrešan ključ za ovaj join). Grupisano po (vatCategoryCode, vatRate).
    private async Task<IzabraniAvansVM> UcitajDetaljAvansa(DostupanAvansVM avans)
    {
        var detalj = new IzabraniAvansVM
        {
            IdEfakture     = avans.IdEfakture,
            BrojDokumenta  = avans.BrojDokumenta,
            DatumIzdavanja = avans.DatumIzdavanja
        };

        List<LineItem> stavkeAvansa = [];
        if (long.TryParse(avans.InvoiceID, out var invoiceIdLong))
        {
            stavkeAvansa = await Db.LineItems.AsNoTracking()
                .Where(li => li.invoiceId == invoiceIdLong)
                .ToListAsync();
        }

        if (stavkeAvansa.Count > 0)
        {
            detalj.Kategorije = [.. stavkeAvansa
                .GroupBy(li => (Slovo: li.vatCategoryCode ?? "", Stopa: li.vatRate ?? 0))
                .Select(g =>
                {
                    var raspoloziva = g.Sum(li => li.sumWithoutVat ?? 0);
                    return new AvansKategorijaVM
                    {
                        Slovo               = g.Key.Slovo,
                        Stopa               = g.Key.Stopa,
                        RaspoloziveOsnovica = raspoloziva,
                        IskorisenoOsnovica  = raspoloziva // prefill = ceo raspoloživi iznos
                    };
                })];
        }
        else
        {
            detalj.NemaPodatakaOStavkama = true;
            detalj.Kategorije = [.. SveKategorijeOslobodjenja.Select(k => new AvansKategorijaVM
            {
                Slovo               = k.Slovo,
                Stopa               = k.Stopa,
                RaspoloziveOsnovica = null,
                IskorisenoOsnovica  = 0m
            })];
        }

        return detalj;
    }

    // Korisnik može SMANJITI unetu osnovicu, nikad je povećati preko raspoloživog
    // (kad je raspoloživo poznato — fallback bez stavki nema gornju granicu).
    private void OnIskorisenoOsnovicaChanged(AvansKategorijaVM kat, decimal v)
    {
        if (v < 0) v = 0;
        if (kat.RaspoloziveOsnovica is not null && v > kat.RaspoloziveOsnovica.Value)
            v = kat.RaspoloziveOsnovica.Value;

        kat.IskorisenoOsnovica = v;
    }

    // Alternativni (bruto) unos — editovanje "Iznos sa PDV" izvodi Osnovicu unazad
    // (isti princip kao avans-stavka bruto unosa), pa prosleđuje kroz isti
    // floor/cap kao direktan unos Osnovice (ne sme preći raspoloživo).
    private void OnIskorisenoBrutoChanged(AvansKategorijaVM kat, decimal v)
    {
        if (kat.Stopa <= 0) return; // oslobođene kategorije nemaju editabilan bruto (uvek = osnovica)

        if (v < 0) v = 0;
        var novaOsnovica = Math.Round(v / (1 + kat.Stopa / 100m), 2);
        OnIskorisenoOsnovicaChanged(kat, novaOsnovica);
    }

