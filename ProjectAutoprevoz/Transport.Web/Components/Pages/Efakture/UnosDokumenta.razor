    // Izvorne (obične ili avansne, zavisno od moda) fakture istog kupca (PIB),
    // stvarno poslate/prihvaćene na SEF — isti kombinovani uslov statusa kao
    // paneli Avansa i Povećanja (status="POSLATO" za direktno poslate,
    // statusDokumenta="Poslato"/"Prihvaceno" za sinhronizovane sa SEF-a).
    private async Task UcitajDostupneSmanjenjeFakture()
    {
        if (string.IsNullOrWhiteSpace(_model.Pib))
        {
            _smanjenjeDostupneFakture = [];
            return;
        }

        var tipIzvora = SmanjenjeIzAvansa ? "AVANSNA FAKTURA" : "FAKTURA";

        _ucitavaSmanjenjeFakture = true;
        try
        {
            var vecIzabrane = _smanjenjeIzabraneFakture.Select(f => f.IdEfakture).ToHashSet();

            var lista = await Db.EInvoices.AsNoTracking()
                .Where(e => e.tipDokumenta == tipIzvora && e.pib == _model.Pib
                         && (e.status == "POSLATO" || e.statusDokumenta == "Poslato" || e.statusDokumenta == "Prihvaceno"))
                .OrderByDescending(e => e.invoiceDateUtc)
                .ToListAsync();

            _smanjenjeDostupneFakture = [.. lista
                .Where(e => !vecIzabrane.Contains(e.idEfakture))
                .Select(e => new IzvornaFakturaVM
                {
                    IdEfakture     = e.idEfakture,
                    BrojDokumenta  = e.brojDokumenta ?? "",
