    private void IzaberiPartnera(Partner? p)
    {
        _partner = p;
        _partnerPretraga = "";
        _partneriPredlozi = [];
        _partnerOpen = false;

        if (p is not null)
        {
            _partnerNaziv  = p.Naziv  ?? "";
            _partnerPib    = p.PIB    ?? "";
            _partnerAdresa = p.Adresa ?? "";
            _partnerMesto  = p.Mesto  ?? "";
            _idPartnera    = p.Broj;

            AzurirajValutu();
        }
    }

    // ── Stavke — dijalog za unos/izmenu ──────────────────────────────────
    // Dijalog radi sa neutralnim StavkaVM (deli ga i /dokumenti/unos) — ova
    // dva mapera su jedina veza između njega i Stavka/tbl_artikli_racuna.
    private async Task OtvoriStavkaDialog(int index)
    {
        var postojecaStavka = index >= 0 ? _stavke[index] : null;
        var postojecaVm     = postojecaStavka is null ? null : StavkuUVm(postojecaStavka);

        var prms = new DialogParameters<StavkaUnosDialog>
        {
            { x => x.Postojeca, postojecaVm },
            { x => x.KursEur, _kursEur },
            { x => x.TipRacuna, _tipRacuna },
            { x => x.PdvStopa, _pdvStopa },
            { x => x.NizaStopaPdv, _podesavanja?.nizaStopaPDV ?? 0 },
            { x => x.RadSaViseMoneta, _radSaViseMoneta },
            { x => x.DomacaValuta, _domacaValuta },
        };

        var opts = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dlg  = await Dialog.ShowAsync<StavkaUnosDialog>(
            index >= 0 ? "Izmena stavke" : "Unos stavke", prms, opts);

        var result = await dlg.Result;
        if (result is { Canceled: false, Data: StavkaVM vm })
        {
            var stavka = VmUStavku(vm);
            stavka.brisano = postojecaStavka?.brisano ?? 0;

            if (index >= 0)
                _stavke[index] = stavka;
            else
                _stavke.Add(stavka);

            AzurirajSumeGlave();
        }
    }

    private static StavkaVM StavkuUVm(Stavka s) => new()
    {
        Broj     = s.Broj,
        IdLager  = s.IdLager,
        Barcode  = s.Barcode ?? "",
        Artikal  = s.Artikal ?? "",
        JM       = s.JM ?? "kom",
        Kolicina = s.Kolicina ?? 1,
        CenaPoJM = s.CenaPoJMSP ?? 0,
        Rabat    = s.Rabat ?? 0,
        StopaPDV = s.StopaPDV ?? 0,
    };

    // vozilo/idVozila/datumUtovara/datumIstovara i Bon ne postoje na StavkaVM
    // (transport polja/valutni marker sa glave) — dodaje ih ovaj mapper, van
    // dijaloga, isto kao ranije unutar njega.
    private Stavka VmUStavku(StavkaVM vm)
    {
        var jeInostrani = _tipRacuna == "INOSTRANI";
        return new Stavka
        {
            Broj    = vm.Broj,
            IdLager = vm.IdLager,
            Barcode = vm.Barcode,
            Artikal = vm.Artikal,
            JM      = vm.JM,
            Kolicina = vm.Kolicina,

            CenaPoJMBP = vm.CenaPoJM,
            CenaPoJMSP = vm.CenaPoJM,
            Rabat      = vm.Rabat,

            CenaPoJMBPminusRab = vm.CenaPoJMminusRab,
            VrednostMinusRab   = vm.VrednostMinusRab,

            StopaPDV = vm.StopaPDV,
            Osnovica = vm.Osnovica,
            PDV      = vm.PDV,
            Ukupno   = vm.Ukupno,
            Suma     = vm.Suma,

            Bon = jeInostrani ? "EUR" : "RSD",

            vozilo   = _vozilo?.registarskaOznaka,
            idVozila = _vozilo?.VoziloId,

            datumUtovara  = DateTime.TryParse(_datumUtovara, out var du)  ? du : null,
            datumIstovara = DateTime.TryParse(_datumIstovara, out var di) ? di : null,

            brisano = 0,
        };
    }

    private void ObrisiStavku(int index)
    {
        _stavke.RemoveAt(index);
        AzurirajSumeGlave();
    }

    private void AzurirajSumeGlave()
    {
        _osnovica = _stavke.Sum(s => s.Osnovica ?? 0);
        _pdv      = _stavke.Sum(s => s.PDV ?? 0);
        _ukupno   = _stavke.Sum(s => s.Ukupno ?? 0);
    }

    // ── Akcije — Sačuvaj / Obriši ────────────────────────────────────────
    private async Task Sacuvaj()
    {
        if (_idPartnera is null && string.IsNullOrWhiteSpace(_partnerNaziv))
        {
            Snackbar.Add("Izaberite partnera.", Severity.Warning);
            return;
        }

        if (_stavke.Count == 0)
        {
            Snackbar.Add("Dodajte bar jednu stavku.", Severity.Warning);
            return;
        }

        if (Id is null)
            await SacuvajNovi();
        else
            await SacuvajPostojeci();
    }

    // Status (legacy numerički kod): IZLAZ → "1", IZLAZ_BP → "3", INOSTRANI → "4"
    private void PopuniGlavu(Racun r)
    {
        r.DatumRacuna    = DateTime.TryParse(_datumRacuna, out var dr)   ? dr : null;
        r.DatumValute    = DateTime.TryParse(_valuta, out var dv)        ? dv : null;
        r.DatumPrometa   = DateTime.TryParse(_datumUtovara, out var du)  ? du : null;
        r.DatumPrometaDo = DateTime.TryParse(_datumIstovara, out var di) ? di : null;
        r.DatumKursa     = DateTime.TryParse(_datumKursa, out var dk)    ? dk : null;
        r.Kurs           = _kursEur;

        r.FiskIsecak = _brojNaloga;
        r.Otpremnica = _cmr;

        r.TipProdaje = _tipRacuna;
        r.UvozIzvoz  = _tipRacuna == "IZLAZ" ? null : _uvozIzvoz;
        r.TipStampe  = _tipStampe;

        r.Status = _tipRacuna switch
        {
            "IZLAZ"     => "1",
            "IZLAZ_BP"  => "3",
            "INOSTRANI" => "4",
            _           => r.Status
        };

        r.Osnovica   = _osnovica;
        r.SumaPDV    = _pdv;
        r.SumaRacuna = _ukupno;

        r.Komentar1 = _komentar1;
        r.Komentar2 = _komentar2;
        r.Komentar3 = _komentar3;

        r.Naziv      = _partnerNaziv;
        r.PIB        = _partnerPib;
        r.Adresa     = _partnerAdresa;
        r.Mesto      = _partnerMesto;
        r.IdPartnera = _idPartnera;

        r.Vozilo    = _vozilo?.registarskaOznaka;
        r.RegOznaka = _vozilo?.registarskaOznaka;
        r.IdVozila  = _vozilo?.VoziloId.ToString();

        r.Vozac    = _vozac is not null ? $"{_vozac.Ime} {_vozac.Prezime}" : null;
        r.IdVozaca = _vozac?.Broj.ToString();

        r.IdBanke = _idBanke;
    }

    private void PripremiStavkeZaUpis(List<Stavka> stavke, Racun r)
    {
        // Broj se NE dira — nova stavka (iz dijaloga) već ima Broj=0, postojeća
        // nosi svoj PK koji SacuvajPostojeci koristi za UPDATE umesto INSERT-a.
        foreach (var s in stavke)
        {
            s.Id_Racuna   = r.Broj.ToString();
            s.selektor    = r.Broj.ToString();
            s.Id_Partnera = r.IdPartnera?.ToString();
            s.Tip_Prodaje = r.TipProdaje;
            s.Status      = r.Status;
            s.Datum       = r.DatumRacuna;
            s.brisano     = 0;
        }
    }

    private async Task SacuvajNovi()
    {
        try
        {
            var pod = await Db.Podesavanja.FirstOrDefaultAsync();
            bool ino = _tipRacuna == "INOSTRANI" && pod?.koristiOdvojeneInoRacune == 1;

            int    sl  = ino ? (pod?.Broj_Otpremnice ?? 1) : (pod?.Broj_Racuna ?? 1);
            string fmt = ino ? (pod?.formatBrojaInoRacuna ?? "broj-godina4") : (pod?.formatBrojaRacuna ?? "broj-godina4");
            int    min = pod?.minCifaraBroja ?? 0;
            var    datumRacuna = DateTime.TryParse(_datumRacuna, out var drTmp) ? drTmp : DateTime.Today;

            string brojRacuna = BrojDokumentaService.Formatiraj(sl, fmt, min, datumRacuna);

            bool postoji = await Db.Racuni.AnyAsync(r => r.BrojRacuna == brojRacuna && r.brisano == 0);
            if (postoji)
            {
                var izbor = await Dialog.ShowMessageBox(
                    "Duplikat broja",
                    $"Broj '{brojRacuna}' već postoji. Šta želite?",
                    yesText: "OSVEŽI BROJ", noText: "IPAK SAČUVAJ", cancelText: "OTKAŽI");
                if (izbor == null) return;
                if (izbor == true)
                    brojRacuna = BrojDokumentaService.Formatiraj(++sl, fmt, min, datumRacuna);
            }

            using var tx = await Db.Database.BeginTransactionAsync();
            try
            {
                var racun = new Racun();
                PopuniGlavu(racun);
                racun.BrojRacuna = brojRacuna;
                racun.brisano = 0;

                if (_izvorDokument is not null)
                {
                    racun.IdIzvora  = _izvorDokument.Broj;
                    racun.TipIzvora = _izvorDokument.TipDokumenta;
                }

                Db.Racuni.Add(racun);
                await Db.SaveChangesAsync();

                // Zatvaranje lanca — TEK ovde, u istoj transakciji: izvorni
                // dokument postaje REALIZOVAN. Ako bilo šta posle ovoga pukne,
                // rollback vraća i ovo (tačka 4 — izvor ne sme ostati obeležen
                // ako snimanje ne uspe).
                if (_izvorDokument is not null)
                {
                    var izvorZaAzuriranje = await Db.Dokumenti.FirstOrDefaultAsync(d => d.Broj == _izvorDokument.Broj);
                    if (izvorZaAzuriranje is not null)
                    {
                        izvorZaAzuriranje.Status = "REALIZOVAN";
                        await Db.SaveChangesAsync();
                    }
                }

                PripremiStavkeZaUpis(_stavke, racun);
                Db.ArtikliRacuna.AddRange(_stavke);

                await KarticaServis.UpsertIzRacuna(racun);
                await KarticaNovaServis.UpisiIzRacuna(racun);
                await Db.SaveChangesAsync();

                if (pod is not null)
                {
                    if (ino) pod.Broj_Otpremnice = sl + 1;
                    else     pod.Broj_Racuna     = sl + 1;
                    await Db.SaveChangesAsync();
                }

                await tx.CommitAsync();
                Snackbar.Add("Račun sačuvan.", Severity.Success);

                _postojeci = racun;
                _brojRacunaPreview = racun.BrojRacuna ?? _brojRacunaPreview;
                PrebaciNaEditMod(racun.Broj);
            }
            catch
            {
                await tx.RollbackAsync();
                throw;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
        }
    }

    private async Task SacuvajPostojeci()
    {
        try
        {
            var dbRacun = await Db.Racuni.FirstOrDefaultAsync(r => r.Broj == Id!.Value);
            if (dbRacun is null)
            {
                Snackbar.Add("Račun nije pronađen.", Severity.Error);
                return;
            }

            using var tx = await Db.Database.BeginTransactionAsync();
            try
            {
                PopuniGlavu(dbRacun);
                // Broj_Racuna se ne menja, brojač se ne dira
                await KarticaServis.UpsertIzRacuna(dbRacun);
                await KarticaNovaServis.UpisiIzRacuna(dbRacun);
                await Db.SaveChangesAsync();

                // Diff stavki (po Broj/PK): update postojećih, insert novih, delete uklonjenih.
                var postojeceStavke = await Db.ArtikliRacuna
                    .Where(s => s.Id_Racuna == dbRacun.Broj.ToString())
                    .ToListAsync();

                PripremiStavkeZaUpis(_stavke, dbRacun);

                var brojeviUMemoriji = _stavke.Where(s => s.Broj != 0).Select(s => s.Broj).ToHashSet();

                foreach (var dbStavka in postojeceStavke)
                {
                    if (!brojeviUMemoriji.Contains(dbStavka.Broj))
                    {
                        await LogServis.Zabelezi("STAVKE",
                            $"Brisana stavka '{dbStavka.Artikal}' iz računa {dbRacun.BrojRacuna}");
                        Db.ArtikliRacuna.Remove(dbStavka);
                    }
                }

                foreach (var s in _stavke)
                {
                    var dbStavka = s.Broj != 0 ? postojeceStavke.FirstOrDefault(p => p.Broj == s.Broj) : null;

                    if (dbStavka is not null)
                    {
                        Db.Entry(dbStavka).CurrentValues.SetValues(s);
                    }
                    else
                    {
                        // Broj != 0 a bez poklapanja u bazi = stara/tuđa vrednost (npr. zaostala
                        // iz prethodno učitanog računa u istoj instanci forme) — mora na 0 pre
                        // Add-a, inače EF šalje eksplicitnu vrednost u IDENTITY kolonu i SQL Server
                        // baca "Cannot insert explicit value ... IDENTITY_INSERT is set to OFF".
                        s.Broj = 0;
                        Db.ArtikliRacuna.Add(s);
                    }
                }

                await Db.SaveChangesAsync();
                await tx.CommitAsync();

                Snackbar.Add("Račun sačuvan.", Severity.Success);

                _postojeci = dbRacun;
                StateHasChanged();
            }
            catch
            {
                await tx.RollbackAsync();
                throw;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
        }
    }

    private async Task Stampaj()
    {
        if (Id is null) return;
        await JS.InvokeVoidAsync("open", $"/fakture/stampa?id={Id}", "_blank");
    }

    private void OtvoriEFakturu()
    {
        if (Id is null) return;
        Nav.NavigateTo($"/efakture/unos?izvor=racun&id={Id}&tip=FAKTURA");
    }

    // Posle prvog Save — ostani na formi, prebaci u EDIT mod za upravo sačuvani račun
    private void PrebaciNaEditMod(int broj)
    {
        Id = broj;
        Nav.NavigateTo($"/fakture/unos?id={broj}", replace: true);
    }

    private async Task Obrisi()
    {
        if (Id is null)
        {
            Nav.NavigateTo("/fakture");
            return;
        }

        var ok = await Dialog.ShowMessageBox(
            "Brisanje računa",
            $"Da li ste sigurni da želite da obrišete račun {_brojRacunaPreview}?",
            yesText: "Da, obriši", cancelText: "Ne");
        if (ok != true) return;

        try
        {
            var dbRacun = await Db.Racuni.FirstOrDefaultAsync(r => r.Broj == Id.Value);
            if (dbRacun is null) return;

            // Jedina blokada: vezane uplate na novom modelu
            var greskaNova = await KarticaNovaServis.ProveriUplateZaRacun(dbRacun.Broj);
            if (greskaNova is not null)
            {
                Snackbar.Add(greskaNova, Severity.Warning);
                return;
            }

            using var tx = await Db.Database.BeginTransactionAsync();
            try
            {
                var valuta = dbRacun.TipProdaje == "INOSTRANI" ? "EUR" : (_podesavanja?.OpcijaString13 ?? "RSD");
                await LogServis.Zabelezi("RACUNI",
                    $"Brisan račun {dbRacun.BrojRacuna}, vrednost {(dbRacun.SumaRacuna ?? 0):N2} {valuta}");

                var stavke = await Db.ArtikliRacuna
                    .Where(s => s.Id_Racuna == dbRacun.Broj.ToString())
                    .ToListAsync();
                Db.ArtikliRacuna.RemoveRange(stavke);
                Db.Racuni.Remove(dbRacun);

                // Briše RACUN stavku iz tbl_KarticaNova u istoj transakciji
                await KarticaNovaServis.ObrisiIzRacuna(dbRacun.Broj);

                await Db.SaveChangesAsync();
                await tx.CommitAsync();

                Snackbar.Add("Račun obrisan.", Severity.Success);
                Nav.NavigateTo("/fakture");
            }
            catch
            {
                await tx.RollbackAsync();
                throw;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška: {ex.InnerException?.Message ?? ex.Message}", Severity.Error);
        }
    }
